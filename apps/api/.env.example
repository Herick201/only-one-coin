# Fastify
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Queue
REDIS_URL=redis://127.0.0.1:6379

# Postgres
DATABASE_URL=postgres://ooc:ooc@localhost:5432/ooc_dev

# Better Auth
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
APP_PUBLIC_URLS=http://localhost:3000

# Storage (Tigris in production; locally the `s3` service in compose.yml —
# LocalStack, which accepts any credentials). The comprovante image never
# reaches this process's own HTTP function; this credential only mints
# presigned upload targets and lets the normalize worker GET/PUT/DELETE.
AWS_ENDPOINT_URL_S3=http://127.0.0.1:4566
AWS_REGION=us-east-1
BUCKET_NAME=ooc-dev-receipts
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack needs the bucket in the path; Tigris resolves it from the hostname.
STORAGE_FORCE_PATH_STYLE=true
# 15 MB — a phone photo, not a scan.
RECEIPT_MAX_UPLOAD_BYTES=15000000

# OCR level 1 (packages/ocr). RECEIPT_OCR_PROVIDER picks the adapter:
# `gemini` (Google AI Studio key) or `openrouter` (an sk-or-... key). Without
# the chosen provider's key, receipts are normalized and screened but never
# read — the extract worker does not start. `pnpm --filter @ooc/api ocr:eval`
# needs only these variables.
RECEIPT_OCR_PROVIDER=gemini
GEMINI_API_KEY=
# Optional — defaults to gemini-3.1-flash-lite.
GEMINI_RECEIPT_MODEL=
OPENROUTER_API_KEY=
# Optional — defaults to google/gemini-3.1-flash-lite.
OPENROUTER_RECEIPT_MODEL=

# E-mail (Brevo, behind NotificationProvider)
# Only NODE_ENV=production sends to any recipient; everything else only
# reaches EMAIL_ALLOWLIST. Without a key, e-mails are rendered and logged,
# never sent.
BREVO_API_KEY=
# A sender verified in Brevo. Required when BREVO_API_KEY is set.
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Only One Coin
# Comma-separated addresses and/or @domain entries. Empty = nobody.
# Ignored when NODE_ENV=production.
EMAIL_ALLOWLIST=
