# Fastify
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Queue
REDIS_URL=redis://127.0.0.1:6379

# Postgres
DATABASE_URL=postgres://ooc:ooc@localhost:5432/ooc_dev

# Better Auth
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
APP_PUBLIC_URL=http://localhost:3000

# E-mail (Brevo, behind NotificationProvider)
# Only NODE_ENV=production sends to any recipient; everything else only
# reaches EMAIL_ALLOWLIST. Without a key, e-mails are rendered and logged,
# never sent.
BREVO_API_KEY=
# A sender verified in Brevo. Required when BREVO_API_KEY is set.
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Only One Coin
# Comma-separated addresses and/or @domain entries. Empty = nobody.
# Ignored when NODE_ENV=production.
EMAIL_ALLOWLIST=
