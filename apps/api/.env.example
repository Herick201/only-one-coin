# Fastify
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Queue
REDIS_URL=redis://127.0.0.1:6379

# Postgres
DATABASE_URL=postgres://ooc:ooc@localhost:5432/ooc_dev

# Better Auth
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
APP_PUBLIC_URL=http://localhost:3000

# Segredo compartilhado com apps/app para as rotas internas (hoje o estado das
# feature flags, CLAUDE.md §5). Mín. 24 caracteres. Opcional fora de produção —
# em produção a API não sobe sem ele. Mesmo valor no INTERNAL_API_TOKEN do app.
# INTERNAL_API_TOKEN=
