{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // @ooc/domain, @ooc/queue e @ooc/db exportam .ts cru sob a condição
    // "development" (README.md — dist/ compilado é só pra produção). Sem
    // isso, `tsc --noEmit` cai na condição "default" (dist/) e falha em
    // checkout limpo, antes do primeiro build — só "funcionava" localmente
    // por causa de dist/ deixado por um build manual anterior.
    "customConditions": ["development"],
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
