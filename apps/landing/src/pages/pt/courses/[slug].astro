---
import Base from "../../../layouts/Base.astro";
import CourseDetail from "../../../components/CourseDetail.astro";
import { content, coursePrices, courseSlugs } from "../../../i18n/ui";
import type { CourseSlug } from "../../../i18n/ui";
import { formatPEN } from "../../../i18n/utils";

export function getStaticPaths() {
  return courseSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: CourseSlug };
const name = content.pt.courses.list[slug];
const price = formatPEN(coursePrices[slug], "pt");
const m = content.pt.meta.course;

const title = `${m.titlePre}${name}${m.titleMid}${price}${m.titlePost}`;
const description = `${m.descPre}${name}${m.descMid}${price}${m.descPost}`;
---

<Base title={title} description={description}>
  <CourseDetail slug={slug} />
</Base>
