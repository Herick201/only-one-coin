---
import Base from "../../../layouts/Base.astro";
import CourseDetail from "../../../components/CourseDetail.astro";
import { content, courseSlugs } from "../../../i18n/ui";
import type { CourseSlug } from "../../../i18n/ui";

export function getStaticPaths() {
  return courseSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: CourseSlug };
const name = content.pt.courses.list[slug];
const m = content.pt.meta.course;

// O preço anunciado é o da sessão, igual em todo curso — o total do
// paquete saiu da landing (pedido do dono, 04/09/2026).
const title = `${m.titlePre}${name}${m.titleMid}${m.titlePost}`;
const description = `${m.descPre}${name}${m.descPost}`;
---

<Base title={title} description={description}>
  <CourseDetail slug={slug} />
</Base>
