---
import Base from "../../../layouts/Base.astro";
import CourseDetail from "../../../components/CourseDetail.astro";
import { content, courseSlugs, sessionPrices } from "../../../i18n/ui";
import { formatPEN } from "../../../i18n/utils";
import type { CourseSlug } from "../../../i18n/ui";

export function getStaticPaths() {
  return courseSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: CourseSlug };
const name = content.en.courses.list[slug];
const m = content.en.meta.course;

// O preço anunciado é o da sessão DESTE curso (tabela do dono, 04/09/2026) —
// o total do paquete não entra em título nem em descrição. Curso sem valor
// anunciado perde o preço do título em vez de herdar o de outro.
const perSession = sessionPrices[slug];
const price = perSession === null ? null : formatPEN(perSession, "en");
const title = price
  ? `${m.titlePre}${name}${m.titleMid}${m.titlePost.replace("{price}", price)}`
  : `${m.titlePre}${name}${m.titleMid}`;
const description =
  `${m.descPre}${name}${m.descPost}` +
  (price ? m.descPrice.replace("{price}", price) : "");
---

<Base title={title} description={description}>
  <CourseDetail slug={slug} />
</Base>
