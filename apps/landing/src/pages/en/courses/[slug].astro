---
import Base from "../../../layouts/Base.astro";
import CourseDetail from "../../../components/CourseDetail.astro";
import { content, coursePrices, courseSlugs } from "../../../i18n/ui";
import type { CourseSlug } from "../../../i18n/ui";
import { formatPEN } from "../../../i18n/utils";

export function getStaticPaths() {
  return courseSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: CourseSlug };
const name = content.en.courses.list[slug];
const rawPrice = coursePrices[slug];
const price = rawPrice === null ? null : formatPEN(rawPrice, "en");
const m = content.en.meta.course;

// Curso sem preço: o título vira só o nome, em vez de anunciar um valor vazio.
const title = price
  ? `${m.titlePre}${name}${m.titleMid}${price}${m.titlePost}`
  : `${m.titlePre}${name}${m.titlePost}`;
const description = price
  ? `${m.descPre}${name}${m.descMid}${price}${m.descPost}`
  : `${m.descPre}${name}${m.descPost}`;
---

<Base title={title} description={description}>
  <CourseDetail slug={slug} />
</Base>
