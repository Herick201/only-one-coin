---
import { Image } from "astro:assets";
import purposePhoto from "../assets/photos/coin-sol.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.purpose;
---

<section class="purpose">
  <div class="purpose-grid">
    <div class="purpose-photo">
      <Image
        src={purposePhoto}
        alt={p.imgAlt}
        widths={[480, 768, 1024]}
        sizes="(max-width: 900px) 100vw, 33vw"
        format="webp"
        quality={74}
      />
    </div>

    <div class="purpose-copy">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2>{p.title}</h2>
      <p class="text">{p.text}</p>
      <a class="purpose-cta" href={withLang(lang, "/about")}>
        {p.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>

    <ul class="facts">
      <li class="fact">
        <span class="fact-value">{p.priceValue}</span>
        <span class="fact-label">{p.priceLabel}</span>
      </li>
      <li class="fact">
        <span class="fact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path></svg>
        </span>
        <span class="fact-label">{p.fact2}</span>
      </li>
      <li class="fact">
        <span class="fact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M12 21s-7.5-4.7-9.7-9.2C.8 8.6 2.7 5 6.2 5c2 0 3.4 1.1 4.3 2.4h3c.9-1.3 2.3-2.4 4.3-2.4 3.5 0 5.4 3.6 3.9 6.8C19.5 16.3 12 21 12 21Z"/></svg>
        </span>
        <span class="fact-label">{p.fact3}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Formato web do mockup: a foto sangra até a borda esquerda da janela,
     o conteúdo vive no creme, e os fatos formam colunas com divisórias. */
  .purpose {
    background: var(--cream);
  }
  .purpose-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
  }
  .purpose-photo {
    position: relative;
    align-self: stretch;
    min-height: 300px;
  }
  /* :global porque o <img> sai do componente <Image> — o escopo do Astro
     não alcança elemento renderizado por componente filho. */
  .purpose-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Corte ancorado no alto: o cover centrado decapitava os rostos. */
    object-position: 50% 22%;
  }
  /* Degradê esquerda→direita: a foto se funde no creme da faixa. */
  .purpose-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 55%, var(--cream));
    pointer-events: none;
  }
  .purpose-copy {
    padding: 56px 44px;
  }
  .eyebrow {
    margin: 0 0 10px;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .purpose-copy h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.2;
  }
  .text {
    margin-top: 14px;
    color: var(--text-muted);
    max-width: 46ch;
  }
  .purpose-cta {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--blue);
  }
  .purpose-cta svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }
  .purpose-cta:hover svg {
    transform: translateX(4px);
  }
  .facts {
    margin: 0;
    padding: 24px 0;
    padding-right: max(24px, calc((100% - var(--maxw)) / 8));
    list-style: none;
    display: flex;
    align-items: center;
  }
  .fact {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding-inline: 16px;
  }
  .fact + .fact {
    border-left: 1.5px solid rgba(19, 34, 75, 0.12);
  }
  .fact-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.1rem;
    line-height: 1;
    color: var(--ink);
  }
  .fact-icon {
    color: var(--blue-deep);
    display: grid;
    place-items: center;
  }
  .fact-icon :global(svg) {
    width: 30px;
    height: 30px;
  }
  .fact-label {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
    line-height: 1.3;
  }
  @media (max-width: 900px) {
    .purpose-grid {
      grid-template-columns: 1fr;
    }
    .purpose-photo {
      min-height: 240px;
    }
    .purpose-copy {
      padding: 36px 24px 8px;
    }
    .facts {
      padding: 24px;
      flex-wrap: wrap;
      gap: 18px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .purpose-cta:hover svg {
      transform: none;
    }
  }
</style>
