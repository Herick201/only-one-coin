---
import { Image } from "astro:assets";
import purposePhoto from "../assets/photos/coin-sol.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.purpose;
---

<section class="purpose">
  <div class="purpose-grid">
    <div class="purpose-photo">
      <Image
        src={purposePhoto}
        alt={p.imgAlt}
        widths={[480, 768, 1024]}
        sizes="33vw"
        format="webp"
        quality={74}
      />
    </div>

    <div class="purpose-copy">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2>{p.title}</h2>
      <p class="text">{p.text}</p>
      <a class="purpose-cta" href={withLang(lang, "/about")}>
        {p.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>

    <ul class="facts">
      <li class="fact fact-price">
        <span class="fact-value">{p.priceValue}</span>
        <span class="fact-label">{p.priceLabel}</span>
      </li>
      <li class="fact">
        <span class="fact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path></svg>
        </span>
        <span class="fact-label">{p.fact2}</span>
      </li>
      <li class="fact">
        <span class="fact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M12 21s-7.5-4.7-9.7-9.2C.8 8.6 2.7 5 6.2 5c2 0 3.4 1.1 4.3 2.4h3c.9-1.3 2.3-2.4 4.3-2.4 3.5 0 5.4 3.6 3.9 6.8C19.5 16.3 12 21 12 21Z"/></svg>
        </span>
        <span class="fact-label">{p.fact3}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Formato web do mockup: a foto sangra até a borda esquerda da janela,
     o conteúdo vive no creme, e os fatos formam colunas com divisórias. */
  .purpose {
    background: var(--cream);
  }
  .purpose-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
  }
  .purpose-photo {
    position: relative;
    align-self: stretch;
    min-height: calc(300 * var(--dp));
  }
  /* :global porque o <img> sai do componente <Image> — o escopo do Astro
     não alcança elemento renderizado por componente filho. */
  .purpose-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Corte ancorado no alto: o cover centrado decapitava os rostos. */
    object-position: 50% 22%;
  }
  /* Degradê esquerda→direita: a foto se funde no creme da faixa. */
  .purpose-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 55%, var(--cream));
    pointer-events: none;
  }
  .purpose-copy {
    padding: calc(56 * var(--dp)) calc(44 * var(--dp));
  }
  .eyebrow {
    margin: 0 0 calc(10 * var(--dp));
    font-weight: 700;
    font-size: calc(12.8 * var(--dp));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .purpose-copy h2 {
    font-size: calc(33.6 * var(--dp));
    line-height: 1.2;
  }
  .text {
    margin-top: calc(14 * var(--dp));
    color: var(--text-muted);
    max-width: 46ch;
  }
  .purpose-cta {
    margin-top: calc(18 * var(--dp));
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--dp));
    font-weight: 700;
    color: var(--blue);
  }
  .purpose-cta svg {
    width: calc(16 * var(--dp));
    height: calc(16 * var(--dp));
    transition: transform 0.2s ease;
  }
  .purpose-cta:hover svg {
    transform: translateX(calc(4 * var(--dp)));
  }
  /* Os três selos são o resumo da promessa — e estavam apagados: texto
     pequeno em azul sobre creme, separados só por um filete. Viram cartões
     empilhados, e o S/1 lidera com o mesmo pill dourado do hero: é o gancho
     do negócio, não mais um item da lista. */
  .facts {
    margin: 0;
    padding: calc(28 * var(--dp)) 0;
    padding-right: max(calc(24 * var(--dp)), calc((100% - var(--maxw)) / 8));
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: calc(12 * var(--dp));
  }
  .fact {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--dp));
    padding: calc(14 * var(--dp)) calc(18 * var(--dp));
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: calc(16 * var(--dp));
    box-shadow: var(--shadow-sm);
  }
  .fact-price {
    align-items: baseline;
    gap: calc(10 * var(--dp));
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow-deep));
    border-color: transparent;
    box-shadow: var(--shadow-yellow);
    padding-block: calc(12 * var(--dp));
  }
  .fact-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(46 * var(--dp));
    line-height: 1;
    color: var(--ink);
  }
  .fact-icon {
    flex: none;
    width: calc(44 * var(--dp));
    height: calc(44 * var(--dp));
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
    display: grid;
    place-items: center;
  }
  .fact-icon :global(svg) {
    width: calc(24 * var(--dp));
    height: calc(24 * var(--dp));
  }
  .fact-label {
    font-weight: 700;
    font-size: calc(16 * var(--dp));
    color: var(--ink);
    line-height: 1.25;
  }
  .fact-price .fact-label {
    font-size: calc(17.6 * var(--dp));
  }
  @media (prefers-reduced-motion: reduce) {
    .purpose-cta:hover svg {
      transform: none;
    }
  }
</style>
