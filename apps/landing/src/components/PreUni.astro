---
import { Image } from "astro:assets";
import studyPhoto from "../assets/photos/preuni-pair.jpg";
import { whatsappUrl } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { preuniContent } from "../i18n/preuni-content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.preuni;
const temario = preuniContent[lang];

// As categorias do temario viram guias (estilo aba de navegador): radio +
// irmãos em CSS puro, igual ao hub de níveis das páginas de curso. As regras
// dependem do índice de cada grupo, então nascem aqui.
const temarioTabsCss = temario.groups
  .map(
    (_, i) => `
#temario-${i}:checked ~ .temario-panels > #temario-panel-${i} { display: block; }
#temario-${i}:checked ~ .temario-tabs > [for="temario-${i}"] {
  background: var(--sky);
  border-color: var(--border);
  color: var(--ink);
  margin-bottom: calc(-1.5 * var(--dp));
  padding-bottom: calc(13.5 * var(--dp));
}
#temario-${i}:focus-visible ~ .temario-tabs > [for="temario-${i}"] {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}`,
  )
  .join("\n");
---

<section class="section preuni">
  <span class="blob preuni-blob" aria-hidden="true"></span>

  <div class="container">
    {/* Hero em duas colunas, na mesma linguagem da home: texto à esquerda,
        foto real em card inclinado com os pontinhos e o sparkle à direita. */}
    <div class="preuni-hero">
      <header class="preuni-head">
        <span class="badge">{p.badge}</span>
        <p class="eyebrow">{p.eyebrow}</p>
        <h1>{p.titlePre}<span class="accent">{p.titleAccent}</span>{p.titlePost}</h1>
        <p class="lead">{p.lead}</p>
      </header>
      <div class="preuni-media">
        <span class="media-dots" aria-hidden="true"></span>
        <span class="media-star" aria-hidden="true">✦</span>
        <div class="preuni-photo">
          <Image
            src={studyPhoto}
            alt={p.imgAlt}
            widths={[480, 768]}
            sizes="(max-width: 900px) 92vw, 520px"
            format="webp"
            quality={78}
            loading="eager"
          />
        </div>
      </div>
    </div>

    {/* O painel central, igual ao das páginas de curso: os fatos como checks,
        o CTA e todo o texto longo (objetivo, áreas, método, resultados) atrás
        de um único "Ver detalles". O preço não aparece porque ainda não
        existe (decisão 02/09/2026) — mesmo critério do coursePrices null. */}
    <section class="panel">
      {/* Marca d'água do logo: decorativa, atrás do conteúdo. */}
      <img class="panel-watermark" src="/brand/logo.png" alt="" aria-hidden="true" loading="lazy" />
      <ul class="ticks panel-ticks">
        {p.facts.map((f) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"></path></svg>
            {f.label}: {f.value}
          </li>
        ))}
      </ul>
      <a class="btn btn-yellow panel-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        {p.ctaWhatsApp}
      </a>
      <details class="panel-toggle">
        <summary>{t.courseDetail.detailsToggle}</summary>
        <div class="panel-detail">
          <section class="part">
            <h3>{p.goalTitle}</h3>
            <p class="text-muted">{p.intro}</p>
            <p class="text-muted">{p.goal}</p>
          </section>
          <section class="part">
            <h3>{p.areasTitle}</h3>
            <ul class="part-list">
              {p.areas.map((a) => (
                <li><strong>{a.title}</strong> — {a.text}</li>
              ))}
            </ul>
          </section>
          <section class="part">
            <h3>{p.methodTitle}</h3>
            <ul class="part-list">
              {p.method.map((m) => <li>{m}</li>)}
            </ul>
          </section>
          <section class="part">
            <h3>{p.resultsTitle}</h3>
            <ul class="part-list">
              {p.results.map((r) => <li>{r}</li>)}
            </ul>
          </section>
        </div>
      </details>
    </section>

    <section class="block">
      <h2 class="block-title">{p.temarioTitle}</h2>
      {/* As categorias como guias de navegador: clicar troca só a lista de
          matérias embaixo — radio + CSS, sem JavaScript. */}
      {temario.groups.map((group, i) => (
        <input
          class="temario-radio"
          type="radio"
          name="temario-tab"
          id={`temario-${i}`}
          checked={i === 0}
          aria-label={group.title}
        />
      ))}
      <div class="temario-tabs">
        {temario.groups.map((group, i) => (
          <label class="temario-tab" for={`temario-${i}`}>{group.title}</label>
        ))}
      </div>
      <div class="temario-panels">
        {temario.groups.map((group, i) => (
          <div class="temario-panel" id={`temario-panel-${i}`}>
            <div class="temario-subjects">
              {/* `name` compartilhado = acordeão exclusivo nativo: abrir uma
                  matéria fecha a que estava aberta. Sem JavaScript. */}
              {group.subjects.map((subject) => (
                <details class="subject" name={`temario-subject-${i}`}>
                  <summary>
                    <span class="subject-title">{subject.title}</span>
                    <span class="subject-count">{p.temarioCount.replace("{n}", String(subject.topics.length))}</span>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <ol class="subject-topics">
                    {subject.topics.map((topic) => (
                      <li>{topic}</li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
      <style set:html={temarioTabsCss} is:inline />
    </section>

    {/* Sem preço nem fecha de início: eles ainda não existem. Enquanto não
        existirem, a única promessa que a página faz é avisar quando abrir. */}
    {/* O fechamento no mesmo modelo das páginas de curso: gradiente azul,
        blobs decorativos, texto à esquerda e o botão à direita. */}
    <section class="preuni-cta">
      <span class="blob preuni-cta-blob-a" aria-hidden="true"></span>
      <span class="blob preuni-cta-blob-b" aria-hidden="true"></span>
      <div class="preuni-cta-inner">
        <div>
          <h2>{p.ctaTitle}</h2>
          <p>{p.ctaText}</p>
        </div>
        <div class="preuni-cta-actions">
          <a class="btn btn-yellow" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            {p.ctaWhatsApp}
          </a>
        </div>
      </div>
    </section>
  </div>
</section>

<style>
  .preuni {
    position: relative;
    overflow: hidden;
    background: var(--sky-soft);
    padding-block: calc(44 * var(--dp)) calc(92 * var(--dp));
  }
  .preuni-blob {
    width: calc(460 * var(--dp));
    height: calc(460 * var(--dp));
    top: calc(-180 * var(--dp));
    right: calc(-140 * var(--dp));
    background: var(--cream);
  }
  .container {
    position: relative;
  }
  .preuni-hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: calc(56 * var(--dp));
    align-items: center;
  }
  .preuni-head {
    margin-top: calc(4 * var(--dp));
    max-width: 62ch;
  }
  .preuni-media {
    position: relative;
  }
  .preuni-photo {
    position: relative;
    z-index: 2;
    max-width: calc(380 * var(--dp));
    margin-left: auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: calc(6 * var(--dp)) solid var(--paper);
    box-shadow: var(--shadow-md);
    transform: rotate(1.5deg);
  }
  /* Foto retrato encurtada: corta para 4/5 em vez de ocupar a altura toda. */
  .preuni-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .media-dots {
    position: absolute;
    z-index: 1;
    top: calc(-22 * var(--dp));
    right: calc(-18 * var(--dp));
    width: calc(108 * var(--dp));
    height: calc(108 * var(--dp));
    background-image: radial-gradient(var(--blue) calc(2.4 * var(--dp)), transparent calc(2.4 * var(--dp)));
    background-size: calc(16 * var(--dp)) calc(16 * var(--dp));
    opacity: 0.35;
  }
  .media-star {
    position: absolute;
    z-index: 3;
    top: 42%;
    right: calc(-20 * var(--dp));
    color: var(--yellow-deep);
    font-size: calc(32 * var(--dp));
    animation: twinkle 3s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.9; }
    50% { transform: scale(1.25) rotate(15deg); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .media-star {
      animation: none;
    }
  }
  .badge {
    display: inline-block;
    padding: calc(8 * var(--dp)) calc(18 * var(--dp));
    border-radius: calc(999 * var(--dp));
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow));
    color: var(--ink);
    font-weight: 800;
    font-size: calc(12.8 * var(--dp));
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: var(--shadow-yellow);
  }
  .eyebrow {
    margin: calc(18 * var(--dp)) 0 calc(6 * var(--dp));
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.02em;
  }
  .preuni-head h1 {
    font-size: calc(51.2 * var(--dp));
  }
  .preuni-head h1 .accent {
    color: var(--blue);
  }
  .lead {
    margin-top: calc(16 * var(--dp));
    font-size: calc(17.6 * var(--dp));
  }
  /* O painel central, mesma cara do painel de nível das páginas de curso:
     card centrado, checks alinhados como bloco, CTA e o toggle do detalhe. */
  .panel {
    position: relative;
    overflow: hidden;
    margin: calc(34 * var(--dp)) auto 0;
    max-width: calc(860 * var(--dp));
    text-align: center;
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: calc(30 * var(--dp)) calc(32 * var(--dp));
  }
  .panel-watermark {
    position: absolute;
    right: calc(-20 * var(--dp));
    bottom: calc(14 * var(--dp));
    width: calc(340 * var(--dp));
    opacity: 0.07;
    transform: rotate(-8deg);
    pointer-events: none;
  }
  .panel-ticks {
    display: inline-grid;
    text-align: left;
    font-size: calc(15.36 * var(--dp));
  }
  .panel-cta {
    display: inline-flex;
    margin-top: calc(20 * var(--dp));
  }
  .panel-toggle {
    margin-top: calc(22 * var(--dp));
  }
  .panel-toggle > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: calc(12 * var(--dp));
    padding: calc(12 * var(--dp)) calc(26 * var(--dp));
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: calc(999 * var(--dp));
    font-weight: 700;
    font-size: calc(15.2 * var(--dp));
    color: var(--blue-deep);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
  }
  .panel-toggle > summary:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow-blue);
    transform: translateY(calc(-2 * var(--dp)));
  }
  .panel-toggle > summary::-webkit-details-marker {
    display: none;
  }
  .panel-toggle > summary::after {
    content: "";
    flex: none;
    width: calc(9 * var(--dp));
    height: calc(9 * var(--dp));
    margin-top: calc(-4 * var(--dp));
    border-right: calc(2.5 * var(--dp)) solid var(--blue);
    border-bottom: calc(2.5 * var(--dp)) solid var(--blue);
    transform: rotate(45deg);
    transition: transform 0.16s ease;
  }
  .panel-toggle[open] > summary::after {
    transform: rotate(225deg);
    margin-top: calc(4 * var(--dp));
  }
  .panel-detail {
    margin-top: calc(26 * var(--dp));
    text-align: left;
  }
  .part + .part {
    margin-top: calc(24 * var(--dp));
    padding-top: calc(24 * var(--dp));
    border-top: calc(1 * var(--dp)) solid var(--border);
  }
  .part h3 {
    font-size: calc(16.32 * var(--dp));
    color: var(--blue-deep);
    margin-bottom: calc(10 * var(--dp));
  }
  .part p {
    margin: 0 0 calc(10 * var(--dp));
    max-width: 72ch;
  }
  .part-list {
    margin: 0;
    padding-left: calc(18 * var(--dp));
    display: grid;
    gap: calc(6 * var(--dp));
    color: var(--text-muted);
    font-size: calc(15.04 * var(--dp));
  }
  .block {
    margin-top: calc(54 * var(--dp));
  }
  .temario-radio {
    position: absolute;
    width: calc(1 * var(--dp));
    height: calc(1 * var(--dp));
    margin: calc(-1 * var(--dp));
    clip-path: inset(50%);
    overflow: hidden;
  }
  /* Guias estilo navegador: abas coladas no painel, a ativa funde com ele. */
  .temario-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: calc(6 * var(--dp));
    margin-top: calc(18 * var(--dp));
  }
  .temario-tab {
    padding: calc(12 * var(--dp)) calc(20 * var(--dp)) calc(13.5 * var(--dp));
    border: calc(1.5 * var(--dp)) solid transparent;
    border-bottom: none;
    border-radius: calc(14 * var(--dp)) calc(14 * var(--dp)) 0 0;
    font-weight: 700;
    font-size: calc(14.72 * var(--dp));
    color: var(--text-muted);
    cursor: pointer;
    position: relative;
    z-index: 1;
    transition: color 0.16s ease, background 0.16s ease;
  }
  .temario-tab:hover {
    color: var(--blue-deep);
  }
  .temario-panel {
    display: none;
    background: var(--sky);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: 0 var(--radius) var(--radius) var(--radius);
    padding: calc(18 * var(--dp));
  }
  .temario-subjects {
    display: grid;
    gap: calc(10 * var(--dp));
  }
  .subject {
    background: var(--paper);
    border: calc(1 * var(--dp)) solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.16s ease;
  }
  .subject:hover,
  .subject[open] {
    border-color: var(--blue);
  }
  .subject summary {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--dp));
    padding: calc(16 * var(--dp)) calc(20 * var(--dp));
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  .subject summary::-webkit-details-marker {
    display: none;
  }
  .subject-title {
    flex: 1;
  }
  .subject-count {
    font-size: calc(12.16 * var(--dp));
    font-weight: 700;
    color: var(--blue-deep);
    background: var(--sky);
    padding: calc(4 * var(--dp)) calc(12 * var(--dp));
    border-radius: calc(999 * var(--dp));
    white-space: nowrap;
  }
  .chevron {
    width: calc(18 * var(--dp));
    height: calc(18 * var(--dp));
    flex-shrink: 0;
    color: var(--blue);
    transition: transform 0.2s ease;
  }
  .subject[open] .chevron {
    transform: rotate(180deg);
  }
  .subject-topics {
    margin: 0;
    padding: 0 calc(20 * var(--dp)) calc(18 * var(--dp)) calc(40 * var(--dp));
    display: grid;
    gap: calc(8 * var(--dp));
    color: var(--text-muted);
    font-size: calc(15.2 * var(--dp));
  }
  .subject-topics {
    grid-template-columns: 1fr 1fr;
    column-gap: calc(32 * var(--dp));
  }
  .block-title {
    font-size: calc(28.8 * var(--dp));
    margin-bottom: calc(18 * var(--dp));
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: calc(12 * var(--dp));
  }
  .ticks li {
    display: flex;
    align-items: flex-start;
    gap: calc(10 * var(--dp));
    color: var(--text-muted);
  }
  .ticks svg {
    width: calc(18 * var(--dp));
    height: calc(18 * var(--dp));
    flex-shrink: 0;
    margin-top: calc(3 * var(--dp));
    color: var(--blue);
  }
  .preuni-cta {
    position: relative;
    overflow: hidden;
    margin-top: calc(64 * var(--dp));
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    color: #fff;
    border-radius: var(--radius-lg);
    padding: calc(52 * var(--dp)) calc(48 * var(--dp));
    box-shadow: var(--shadow-blue);
  }
  .preuni-cta-blob-a {
    width: calc(240 * var(--dp));
    height: calc(240 * var(--dp));
    top: calc(-110 * var(--dp));
    right: 8%;
    background: var(--yellow);
    opacity: 0.35;
  }
  .preuni-cta-blob-b {
    width: calc(180 * var(--dp));
    height: calc(180 * var(--dp));
    bottom: calc(-100 * var(--dp));
    left: calc(-40 * var(--dp));
    background: #fff;
    opacity: 0.14;
  }
  .preuni-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: calc(26 * var(--dp));
  }
  .preuni-cta h2 {
    color: #fff;
    font-size: calc(41.6 * var(--dp));
  }
  .preuni-cta p {
    margin: calc(8 * var(--dp)) 0 0;
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.86);
  }
</style>
