---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";
import { courseIdBySlug, englishKidsCourseId, enrollmentHref } from "../data/checkout";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.programs;

// Ordenado igual a `programs.items` em todos os idiomas, como `audienceAnchors`:
// o card de crianças e o de jovens/adultos são cursos diferentes no catálogo,
// então cada um leva ao checkout já no seu.
const programCourses = [
  { courseId: englishKidsCourseId, content: "programs_kids" },
  { courseId: courseIdBySlug.english, content: "programs_teens_adults" },
];
const enrollPath = withLang(lang, "/enrollment");
---

<section class="section programs" id="courses">
  <div class="container">
    <h2 class="section-title">{p.titlePre}<span class="accent">{p.titleAccent}</span>{p.titlePost}</h2>

    <div class="grid">
      {
        p.items.map((item, i) => (
          <article class="program">
            <span class="tag">{item.tag}</span>
            <h3>{item.title}</h3>
            <p class="text-muted">{item.text}</p>
            <div class="program-actions">
              {/* A matrícula é a ação; ver o curso continua existindo para
                  quem ainda está decidindo (é lá que mora o preço). */}
              <a
                href={enrollmentHref(enrollPath, programCourses[i])}
                class="btn btn-yellow view-course"
              >
                <span>{t.hero.ctaEnroll}</span>
                <svg class="vc-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
              <a href={withLang(lang, item.href)} class="link-quiet">
                {p.viewCourse}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .programs {
    background: var(--sky-soft);
  }
  .grid {
    margin-top: 46px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px;
  }
  .program {
    position: relative;
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .program:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }
  /* Corner accent bubble, alternating colour */
  .program::before {
    content: "";
    position: absolute;
    top: -60px;
    right: -60px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: var(--sky);
  }
  .program:nth-child(2)::before {
    background: var(--cream);
  }
  .program > * {
    position: relative;
    z-index: 1;
  }
  .tag {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue-deep);
    background: var(--sky);
    padding: 6px 13px;
    border-radius: 999px;
  }
  .program:nth-child(2) .tag {
    color: var(--yellow-deep);
    background: var(--cream);
  }
  .program h3 {
    font-size: 1.55rem;
  }
  .program .btn {
    margin-top: 8px;
  }
  /* "Ver curso" — arrow slides + a subtle nudge on hover */
  .program-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
  }
  .view-course .vc-arrow {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }
  .view-course:hover .vc-arrow {
    transform: translateX(5px);
  }
  .view-course:active {
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .view-course:hover .vc-arrow {
      transform: none;
    }
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
