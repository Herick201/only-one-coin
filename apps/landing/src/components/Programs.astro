---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.programs;
---

<section class="section programs" id="cursos">
  <div class="container">
    <p class="eyebrow">{p.eyebrow}</p>
    <h2 class="section-title">{p.titlePre}<span class="accent">{p.titleAccent}</span>{p.titlePost}</h2>

    <div class="grid">
      {
        p.items.map((item) => (
          <article class="program">
            <span class="tag">{item.tag}</span>
            <h3>{item.title}</h3>
            <p class="text-muted">{item.text}</p>
            <a href={withLang(lang, item.href)} class="btn btn-gold">
              {p.viewCourse}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .programs {
    background: var(--sky-soft);
  }
  .grid {
    margin-top: 46px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px;
  }
  .program {
    position: relative;
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .program:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }
  /* Corner accent bubble, alternating colour */
  .program::before {
    content: "";
    position: absolute;
    top: -60px;
    right: -60px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: var(--sky);
  }
  .program:nth-child(2)::before {
    background: var(--cream);
  }
  .program > * {
    position: relative;
    z-index: 1;
  }
  .tag {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue-deep);
    background: var(--sky);
    padding: 6px 13px;
    border-radius: 999px;
  }
  .program:nth-child(2) .tag {
    color: var(--yellow-deep);
    background: var(--cream);
  }
  .program h3 {
    font-size: 1.55rem;
  }
  .program .btn {
    margin-top: 8px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
