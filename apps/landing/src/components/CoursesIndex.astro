---
import { languageSlugs, coursePrices } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang, formatPEN } from "../i18n/utils";
import LanguageFlag from "./LanguageFlag.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.courses;

const courses = languageSlugs.map((slug) => ({
  slug,
  name: t.courses.list[slug],
  href: withLang(lang, `/courses/${slug}`),
  // Curso sem preço definido ainda não mostra badge de valor.
  price: coursePrices[slug] === null ? null : formatPEN(coursePrices[slug] as number, lang),
}));
---

<section class="section courses-index">
  <div class="container">
    <h1 class="section-title">{c.indexTitlePre}<span class="accent">{c.indexTitleAccent}</span>{c.indexTitlePost}</h1>
    <p class="ci-lead text-muted">{c.indexText}</p>

    <div class="ci-grid">
      {
        courses.map((course) => (
          <a class="ci-card" href={course.href}>
            {course.price && <span class="ci-badge">{course.price} · {c.payOnce}</span>}
            <h2 class="ci-name">
              <LanguageFlag slug={course.slug} />
              <span>{course.name}</span>
            </h2>
            <span class="ci-link">
              {c.viewCourse}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .courses-index {
    background:
      radial-gradient(50% 55% at 92% 4%, rgba(255, 201, 60, 0.14), transparent 60%),
      var(--sky-soft);
  }
  .ci-lead {
    margin-top: 16px;
    max-width: 60ch;
    font-size: 1.08rem;
  }
  .ci-grid {
    margin-top: 42px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 22px;
  }
  .ci-card {
    position: relative;
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 30px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .ci-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }
  .ci-badge {
    align-self: flex-start;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--yellow-deep);
    background: var(--cream);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .ci-card h2 {
    font-size: 1.5rem;
  }
  .ci-name {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ci-name :global(.lang-flag) {
    width: 34px;
    height: 34px;
    border-width: 1.5px;
  }
  .ci-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 700;
    color: var(--blue);
  }
  .ci-link svg {
    width: 17px;
    height: 17px;
    transition: transform 0.18s ease;
  }
  .ci-card:hover .ci-link svg {
    transform: translateX(5px);
  }
  /* Mobile: a grade de idiomas mantém as quatro colunas da vista web. Na
     largura de um cartão de celular a bandeira sobe para cima do nome — em
     linha, o par não caberia. */
  @media (max-width: 900px) {
    .ci-lead {
      margin-top: 8px;
      font-size: 0.9rem;
      max-width: none;
    }
    .ci-grid {
      margin-top: 24px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
    .ci-card {
      padding: 16px 12px;
      gap: 9px;
      border-radius: 14px;
      text-align: center;
    }
    .ci-badge {
      align-self: center;
      font-size: 0.58rem;
      padding: 4px 8px;
    }
    .ci-card h2 {
      font-size: 1rem;
    }
    .ci-name {
      flex-direction: column;
      gap: 7px;
    }
    .ci-name :global(.lang-flag) {
      width: 26px;
      height: 26px;
    }
    .ci-link {
      justify-content: center;
      font-size: 0.74rem;
    }
    .ci-link svg {
      width: 12px;
      height: 12px;
    }
  }

  @media (max-width: 620px) {
    .ci-lead {
      margin-top: 4px;
      font-size: 0.62rem;
    }
    .ci-grid {
      margin-top: 13px;
      gap: 7px;
    }
    .ci-card {
      padding: 9px 5px;
      gap: 5px;
      border-radius: 9px;
      border-width: 1px;
    }
    .ci-badge {
      font-size: 0.4rem;
      padding: 2px 5px;
      line-height: 1.3;
    }
    .ci-card h2 {
      font-size: 0.62rem;
    }
    .ci-name {
      gap: 4px;
    }
    .ci-name :global(.lang-flag) {
      width: 17px;
      height: 17px;
      border-width: 1px;
    }
    .ci-link {
      gap: 3px;
      font-size: 0.46rem;
    }
    .ci-link svg {
      width: 8px;
      height: 8px;
    }
  }
</style>
