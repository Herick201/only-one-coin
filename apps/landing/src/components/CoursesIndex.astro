---
import { courseSlugs } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.courses;

const courses = courseSlugs.map((slug) => ({
  slug,
  name: t.courses.list[slug],
  href: withLang(lang, `/cursos/${slug}`),
}));
---

<section class="section courses-index">
  <div class="container">
    <p class="eyebrow">{c.indexEyebrow}</p>
    <h1 class="section-title">{c.indexTitlePre}<span class="accent">{c.indexTitleAccent}</span>{c.indexTitlePost}</h1>
    <p class="ci-lead text-muted">{c.indexText}</p>

    <div class="ci-grid">
      {
        courses.map((course) => (
          <a class="ci-card" href={course.href}>
            <span class="ci-badge">S/1.00</span>
            <h2>{course.name}</h2>
            <span class="ci-link">
              {c.viewCourse}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .courses-index {
    background:
      radial-gradient(50% 55% at 92% 4%, rgba(255, 201, 60, 0.14), transparent 60%),
      var(--sky-soft);
  }
  .ci-lead {
    margin-top: 16px;
    max-width: 60ch;
    font-size: 1.08rem;
  }
  .ci-grid {
    margin-top: 42px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 22px;
  }
  .ci-card {
    position: relative;
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 30px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .ci-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }
  .ci-badge {
    align-self: flex-start;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--yellow-deep);
    background: var(--cream);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .ci-card h2 {
    font-size: 1.5rem;
  }
  .ci-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 700;
    color: var(--blue);
  }
  .ci-link svg {
    width: 17px;
    height: 17px;
    transition: transform 0.18s ease;
  }
  .ci-card:hover .ci-link svg {
    transform: translateX(5px);
  }
  @media (max-width: 480px) {
    .ci-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
