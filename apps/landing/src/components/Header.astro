---
import LanguageFlag from "./LanguageFlag.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { languageSlugs } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Top-level links only. The logo already goes home, and contact is reachable
// from the footer and from the CTA at the bottom of every page, so neither
// needs a slot up here.
const nav = [{ label: t.nav.about, href: withLang(lang, "/about") }];

const courses = languageSlugs.map((slug) => ({
  slug,
  label: t.courses.list[slug],
  href: withLang(lang, `/courses/${slug}`),
}));
const coursesHref = withLang(lang, "/courses");

// "Recursos" dropdown — community / blog / FAQ / contact, one page each.
// Rendered by both the desktop dropdown and the mobile drawer, so this array
// is the only place an entry has to be added.
const resources = [
  { label: t.nav.community, href: withLang(lang, "/community") },
  { label: t.nav.blog, href: withLang(lang, "/blog") },
  { label: t.nav.faq, href: withLang(lang, "/faq") },
  { label: t.nav.contact, href: withLang(lang, "/contact") },
];
const resourcesHref = resources[0].href;

// "Cursos" — o que não é idioma. Hoje só o preuniversitario, ainda sem
// matrícula aberta: entra com selo em vez de sumir do menu, porque o "em
// breve" é parte do que a página tem a dizer.
const programs = [
  {
    label: t.nav.preuniversitario,
    href: withLang(lang, "/preuniversitario"),
    soon: true,
  },
];
---

<header class="site-header">
  <!-- Mobile drawer state (CSS checkbox toggle — CSP-safe, no inline JS).
       Kept at header level so the `~` sibling selectors reach the drawer. -->
  <input type="checkbox" id="menu-toggle" class="menu-toggle" hidden />

  <div class="container header-inner">
    <a href={withLang(lang, "/")} class="brand" aria-label="Only One Coin">
      <img src="/brand/logo.png" alt="Only One Coin" width="200" height="33" />
    </a>

    <!-- Desktop navigation -->
    <nav class="nav" aria-label="Principal">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}

      <details class="nav-dd">
        <summary>
          {t.nav.courses}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="dd-panel">
          {courses.map((c) => (
            <a href={c.href} class="dd-lang">
              <LanguageFlag slug={c.slug} />
              <span>{c.label}</span>
            </a>
          ))}
          <a href={coursesHref} class="dd-all">{t.nav.coursesAll}</a>
        </div>
      </details>

      <details class="nav-dd">
        <summary>
          {t.nav.programs}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="dd-panel">
          {programs.map((p) => (
            <a href={p.href} class="dd-with-badge">
              <span>{p.label}</span>
              {p.soon && <span class="soon">{t.nav.soon}</span>}
            </a>
          ))}
        </div>
      </details>

      <a href={withLang(lang, "/#benefits")}>{t.nav.benefits}</a>

      <details class="nav-dd">
        <summary>
          {t.nav.resources}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="dd-panel">
          {resources.map((r) => <a href={r.href}>{r.label}</a>)}
        </div>
      </details>

    </nav>

    <div class="header-actions">
      <span class="lang-slot"><LanguageSwitcher /></span>
      <a href={withLang(lang, "/enrollment")} class="btn btn-yellow enroll-btn">
        {t.hero.ctaEnroll}
      </a>
      <a href={withLang(lang, "/login")} class="btn btn-primary login-btn">
        <span class="login-txt">
          <span class="login-hint">{t.nav.portalHint}</span>
          <span>{t.nav.portal}</span>
        </span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <label for="menu-toggle" class="burger" aria-label={t.nav.openMenu}>
        <span></span><span></span><span></span>
      </label>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-drawer">
    <nav class="mobile-nav" aria-label="Principal (móvil)">
      <div class="m-lang"><LanguageSwitcher /></div>

      {nav.map((n) => <a href={n.href}>{n.label}</a>)}

      <details class="m-dd">
        <summary>
          {t.nav.courses}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="m-dd-panel">
          {courses.map((c) => (
            <a href={c.href} class="dd-lang">
              <LanguageFlag slug={c.slug} />
              <span>{c.label}</span>
            </a>
          ))}
          <a href={coursesHref} class="m-dd-all">{t.nav.coursesAll}</a>
        </div>
      </details>

      <details class="m-dd">
        <summary>
          {t.nav.programs}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="m-dd-panel">
          {programs.map((p) => (
            <a href={p.href} class="dd-with-badge">
              <span>{p.label}</span>
              {p.soon && <span class="soon">{t.nav.soon}</span>}
            </a>
          ))}
        </div>
      </details>

      <details class="m-dd">
        <summary>
          {t.nav.resources}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="m-dd-panel">
          {resources.map((r) => <a href={r.href}>{r.label}</a>)}
        </div>
      </details>

      <a href={withLang(lang, "/#benefits")}>{t.nav.benefits}</a>

      <a href={withLang(lang, "/enrollment")} class="btn btn-yellow m-enroll">{t.hero.ctaEnroll}</a>
      <a href={withLang(lang, "/login")} class="btn btn-primary m-portal">{t.nav.portal}</a>
    </nav>
  </div>
</header>

<script>
  // Open the desktop dropdowns (courses, resources, language) on hover for a
  // smoother feel, while keeping click + keyboard working. Bundled by Astro
  // (served from /_astro) so it satisfies `script-src 'self'`.
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
  const menus = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(".site-header .nav-dd, .site-header .lang-switch"),
  );

  const closeOthers = (keep: HTMLDetailsElement) => {
    menus.forEach((m) => {
      if (m !== keep) m.open = false;
    });
  };

  menus.forEach((menu) => {
    let closeTimer: number | undefined;

    menu.addEventListener("mouseenter", () => {
      if (!canHover.matches) return;
      window.clearTimeout(closeTimer);
      closeOthers(menu);
      menu.open = true;
    });

    menu.addEventListener("mouseleave", () => {
      if (!canHover.matches) return;
      // Small grace period so a diagonal cursor path to the panel doesn't close it.
      closeTimer = window.setTimeout(() => (menu.open = false), 120);
    });

    // On click (or keyboard) let the native toggle win, but still close siblings.
    menu.querySelector("summary")?.addEventListener("click", () => closeOthers(menu));
  });

  // Click outside closes any open menu.
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    menus.forEach((m) => {
      if (m.open && !m.contains(target)) m.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(calc(18 * var(--dp))) saturate(140%);
    -webkit-backdrop-filter: blur(calc(18 * var(--dp))) saturate(140%);
    border-bottom: calc(1 * var(--dp)) solid rgba(19, 34, 75, 0.08);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(12 * var(--dp));
    height: calc(80 * var(--dp));
    /* O header é a única faixa que usa a largura toda: a marca encosta numa
       ponta e as ações na outra, com a nav respirando no meio. O resto do site
       segue no container de calc(1180 * var(--dp)) — é o texto que precisa de medida de
       leitura, não a barra. */
    max-width: none;
    padding-inline: calc(20 * var(--dp));
  }
  /* A marca NUNCA encolhe. Com `img { max-width: 100% }` (global) e altura
     fixa, o flex esmagava a largura do logo e mantinha a altura — o lockup
     saía achatado, e era isso o que se via de 1180 a 1770 de janela. A barra
     inteira foi apertada (gaps, padding, corpo da nav) para caber na largura
     de desenho com folga em vez de comer o logo. */
  .brand {
    flex: none;
  }
  .brand img {
    height: calc(34 * var(--dp));
    width: auto;
    max-width: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--dp));
    font-size: calc(14 * var(--dp));
    font-weight: 600;
    color: #0e1730;
  }
  .nav > a,
  .nav-dd > summary {
    position: relative;
    padding-block: calc(4 * var(--dp));
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .nav > a::after,
  .nav-dd > summary::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-2 * var(--dp));
    height: calc(3 * var(--dp));
    border-radius: calc(999 * var(--dp));
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }
  .nav > a:hover,
  .nav-dd > summary:hover {
    color: var(--blue);
  }
  .nav > a:hover::after,
  .nav-dd > summary:hover::after {
    transform: scaleX(1);
  }

  /* Desktop courses dropdown */
  .nav-dd {
    position: relative;
  }
  .nav-dd > summary {
    display: inline-flex;
    align-items: center;
    gap: calc(5 * var(--dp));
    cursor: pointer;
    list-style: none;
  }
  .nav-dd > summary::-webkit-details-marker {
    display: none;
  }
  .dd-chevron {
    width: calc(15 * var(--dp));
    height: calc(15 * var(--dp));
    transition: transform 0.18s ease;
  }
  .nav-dd[open] > summary .dd-chevron {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: calc(100% + calc(12 * var(--dp)));
    min-width: calc(230 * var(--dp));
    display: flex;
    flex-direction: column;
    padding: calc(8 * var(--dp));
    background: var(--paper);
    border: calc(1 * var(--dp)) solid var(--border);
    border-radius: calc(16 * var(--dp));
    box-shadow: var(--shadow-md);
    z-index: 60;
  }
  /* Invisible bridge over the gap between the summary and the panel, so moving
     the cursor down to the menu never leaves the hover region (no flicker,
     no reliance on the close-timer). */
  .dd-panel::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-14 * var(--dp));
    height: calc(14 * var(--dp));
  }
  .dd-panel a {
    padding: calc(10 * var(--dp)) calc(14 * var(--dp));
    border-radius: calc(10 * var(--dp));
    font-weight: 600;
    color: var(--text-muted);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dd-panel a:hover {
    background: var(--sky);
    color: var(--ink);
  }
  .dd-all {
    margin-top: calc(4 * var(--dp));
    border-top: calc(1 * var(--dp)) solid var(--border);
    border-radius: 0 0 calc(10 * var(--dp)) calc(10 * var(--dp)) !important;
    color: var(--blue) !important;
    font-weight: 700 !important;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--dp));
  }
  /* A matrícula viaja em todas as páginas, no lugar mais quente do header.
     Escondida abaixo de calc(1080 * var(--dp)): aí o menu já colapsa e ela reaparece dentro
     dele, em vez de espremer o logo. */
  .dd-lang {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--dp));
  }
  .dd-with-badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(12 * var(--dp));
  }
  .soon {
    padding: calc(3 * var(--dp)) calc(10 * var(--dp));
    border-radius: calc(999 * var(--dp));
    background: var(--cream);
    color: var(--yellow-deep);
    font-size: calc(11.2 * var(--dp));
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .enroll-btn {
    padding: calc(12 * var(--dp)) calc(16 * var(--dp));
    font-size: calc(15.04 * var(--dp));
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .m-enroll {
    width: 100%;
    margin-top: calc(6 * var(--dp));
  }
  /* O portal é para quem já é aluno — serviço, não venda. Fica leve e menor
     para que o amarelo da matrícula seja a única coisa gritando no header. */
  .login-btn {
    white-space: nowrap;
    padding: calc(9 * var(--dp)) calc(12 * var(--dp));
    gap: calc(6 * var(--dp));
    font-size: calc(13.76 * var(--dp));
    background: transparent;
    color: var(--blue-deep);
    border-color: var(--border);
    box-shadow: none;
  }
  .login-btn:hover {
    background: var(--sky);
    color: var(--blue-deep);
    box-shadow: none;
    transform: none;
  }
  .login-txt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }
  .login-hint {
    font-size: calc(10.88 * var(--dp));
    font-weight: 500;
    color: var(--text-muted);
  }
  .login-btn .arrow {
    width: calc(15 * var(--dp));
    height: calc(15 * var(--dp));
    transition: transform 0.2s ease;
  }
  .login-btn:hover .arrow {
    transform: translateX(calc(4 * var(--dp)));
  }

  /* Hamburger */
  .menu-toggle,
  .burger {
    display: none;
  }
  .burger {
    width: calc(44 * var(--dp));
    height: calc(44 * var(--dp));
    border-radius: calc(12 * var(--dp));
    border: calc(1.5 * var(--dp)) solid var(--border);
    background: var(--paper);
    cursor: pointer;
    place-items: center;
    gap: calc(5 * var(--dp));
    flex-direction: column;
  }
  .burger span {
    width: calc(20 * var(--dp));
    height: calc(2.4 * var(--dp));
    border-radius: calc(2 * var(--dp));
    background: var(--ink);
    transition: transform 0.22s ease, opacity 0.18s ease;
  }

  /* Mobile drawer */
  .mobile-drawer {
    display: none;
    background: var(--paper);
    border-top: calc(1 * var(--dp)) solid var(--border);
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--dp));
    padding: calc(14 * var(--dp)) calc(24 * var(--dp)) calc(22 * var(--dp));
  }
  .mobile-nav > a {
    padding: calc(13 * var(--dp)) calc(6 * var(--dp));
    font-weight: 600;
    font-size: calc(16.8 * var(--dp));
    color: var(--ink);
    border-bottom: calc(1 * var(--dp)) solid var(--border);
  }
  .m-portal {
    margin-top: calc(14 * var(--dp));
    justify-content: center;
    border-bottom: 0 !important;
  }
  .m-dd {
    border-bottom: calc(1 * var(--dp)) solid var(--border);
  }
  .m-dd > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(13 * var(--dp)) calc(6 * var(--dp));
    font-weight: 600;
    font-size: calc(16.8 * var(--dp));
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .m-dd > summary::-webkit-details-marker {
    display: none;
  }
  .m-dd[open] > summary .dd-chevron {
    transform: rotate(180deg);
  }
  .m-dd-panel {
    display: flex;
    flex-direction: column;
    padding: calc(2 * var(--dp)) 0 calc(10 * var(--dp)) calc(14 * var(--dp));
  }
  .m-dd-panel a {
    padding: calc(9 * var(--dp)) calc(6 * var(--dp));
    color: var(--text-muted);
    font-weight: 500;
  }
  .m-dd-all {
    color: var(--blue) !important;
    font-weight: 700 !important;
  }

  /* O seletor de idioma só existe fora do menu na barra larga. */
  .m-lang {
    display: none;
  }

  /* ——— Celular: a segunda largura de desenho (390px, global.css). ———
     A barra não comporta quatro controles em 390px: marca (145dp) + idioma
     (95dp) + matrícula (143dp) + hambúrguer (38dp) dá 421dp numa faixa de
     358dp úteis. Sai o idioma, que é ação rara e reaparece no topo do menu
     (e continua no rodapé); fica a matrícula, que é o que a página quer que
     aconteça. */
  @media (max-width: 900px) {
    .nav {
      display: none;
    }
    .login-btn {
      display: none;
    }
    .lang-slot {
      display: none;
    }
    .m-lang {
      display: block;
      padding-bottom: calc(12 * var(--dp));
      margin-bottom: calc(4 * var(--dp));
      border-bottom: calc(1 * var(--dp)) solid var(--border);
    }
    .header-inner {
      height: calc(58 * var(--dp));
      padding-inline: calc(16 * var(--dp));
      gap: calc(10 * var(--dp));
    }
    .brand img {
      height: calc(24 * var(--dp));
    }
    .header-actions {
      gap: calc(8 * var(--dp));
    }
    .enroll-btn {
      padding: calc(11 * var(--dp)) calc(14 * var(--dp));
      font-size: calc(12.5 * var(--dp));
      min-height: calc(40 * var(--dp));
    }
    .burger {
      width: calc(38 * var(--dp));
      height: calc(38 * var(--dp));
    }
    .mobile-nav {
      padding: calc(12 * var(--dp)) calc(20 * var(--dp)) calc(20 * var(--dp));
    }
    .mobile-nav > a {
      font-size: calc(15.5 * var(--dp));
      padding-block: calc(12 * var(--dp));
    }
    .burger {
      display: inline-flex;
    }
    /* Reliable open/close via the checkbox: a plain display toggle can't be
       dropped by the cascade (unlike an animated max-height). */
    .menu-toggle:checked ~ .mobile-drawer {
      display: block;
      max-height: 80vh;
      overflow-y: auto;
    }
    .menu-toggle:checked ~ .header-inner .burger span:nth-child(1) {
      transform: translateY(calc(7.4 * var(--dp))) rotate(45deg);
    }
    .menu-toggle:checked ~ .header-inner .burger span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle:checked ~ .header-inner .burger span:nth-child(3) {
      transform: translateY(calc(-7.4 * var(--dp))) rotate(-45deg);
    }
  }
</style>
