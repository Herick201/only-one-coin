---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { courseSlugs } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const nav = [
  { label: t.nav.home, href: withLang(lang, "/") },
  { label: t.nav.about, href: withLang(lang, "/nosotros") },
  { label: t.nav.contact, href: withLang(lang, "/contacto") },
];

const courses = courseSlugs.map((slug) => ({
  label: t.courses.list[slug],
  href: withLang(lang, `/cursos/${slug}`),
}));
const coursesHref = withLang(lang, "/cursos");

// "Recursos" dropdown — community / blog / FAQ, one page each.
const resources = [
  { label: t.nav.community, href: withLang(lang, "/comunidad") },
  { label: t.nav.blog, href: withLang(lang, "/blog") },
  { label: t.nav.faq, href: withLang(lang, "/preguntas-frecuentes") },
];
const resourcesHref = resources[0].href;
---

<header class="site-header">
  <!-- Mobile drawer state (CSS checkbox toggle — CSP-safe, no inline JS).
       Kept at header level so the `~` sibling selectors reach the drawer. -->
  <input type="checkbox" id="menu-toggle" class="menu-toggle" hidden />

  <div class="container header-inner">
    <a href={withLang(lang, "/")} class="brand" aria-label="Only One Coin">
      <img src="/brand/logo.png" alt="Only One Coin" width="120" height="69" />
    </a>

    <!-- Desktop navigation -->
    <nav class="nav" aria-label="Principal">
      <a href={nav[0].href}>{nav[0].label}</a>
      <a href={nav[1].href}>{nav[1].label}</a>

      <details class="nav-dd">
        <summary>
          {t.nav.courses}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="dd-panel">
          {courses.map((c) => <a href={c.href}>{c.label}</a>)}
          <a href={coursesHref} class="dd-all">{t.nav.coursesAll}</a>
        </div>
      </details>

      <details class="nav-dd">
        <summary>
          {t.nav.resources}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="dd-panel">
          {resources.map((r) => <a href={r.href}>{r.label}</a>)}
        </div>
      </details>

      <a href={nav[2].href}>{nav[2].label}</a>
    </nav>

    <div class="header-actions">
      <LanguageSwitcher />
      <a href={withLang(lang, "/mi-cuenta")} class="btn btn-primary login-btn">
        <span>{t.nav.portal}</span>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <label for="menu-toggle" class="burger" aria-label={t.nav.openMenu}>
        <span></span><span></span><span></span>
      </label>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-drawer">
    <nav class="mobile-nav" aria-label="Principal (móvil)">
      <a href={nav[0].href}>{nav[0].label}</a>
      <a href={nav[1].href}>{nav[1].label}</a>

      <details class="m-dd">
        <summary>
          {t.nav.courses}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="m-dd-panel">
          {courses.map((c) => <a href={c.href}>{c.label}</a>)}
          <a href={coursesHref} class="m-dd-all">{t.nav.coursesAll}</a>
        </div>
      </details>

      <details class="m-dd">
        <summary>
          {t.nav.resources}
          <svg class="dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="m-dd-panel">
          {resources.map((r) => <a href={r.href}>{r.label}</a>)}
        </div>
      </details>

      <a href={nav[2].href}>{nav[2].label}</a>
      <a href={withLang(lang, "/mi-cuenta")} class="btn btn-primary m-portal">{t.nav.portal}</a>
    </nav>
  </div>
</header>

<script>
  // Open the desktop dropdowns (courses, resources, language) on hover for a
  // smoother feel, while keeping click + keyboard working. Bundled by Astro
  // (served from /_astro) so it satisfies `script-src 'self'`.
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
  const menus = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(".site-header .nav-dd, .site-header .lang-switch"),
  );

  const closeOthers = (keep: HTMLDetailsElement) => {
    menus.forEach((m) => {
      if (m !== keep) m.open = false;
    });
  };

  menus.forEach((menu) => {
    let closeTimer: number | undefined;

    menu.addEventListener("mouseenter", () => {
      if (!canHover.matches) return;
      window.clearTimeout(closeTimer);
      closeOthers(menu);
      menu.open = true;
    });

    menu.addEventListener("mouseleave", () => {
      if (!canHover.matches) return;
      // Small grace period so a diagonal cursor path to the panel doesn't close it.
      closeTimer = window.setTimeout(() => (menu.open = false), 120);
    });

    // On click (or keyboard) let the native toggle win, but still close siblings.
    menu.querySelector("summary")?.addEventListener("click", () => closeOthers(menu));
  });

  // Click outside closes any open menu.
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    menus.forEach((m) => {
      if (m.open && !m.contains(target)) m.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid rgba(19, 34, 75, 0.08);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 3vw, 24px);
    height: 80px;
  }
  .brand img {
    height: clamp(40px, 6vw, 52px);
    width: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 32px);
    font-weight: 600;
    color: #0e1730;
  }
  .nav > a,
  .nav-dd > summary {
    position: relative;
    padding-block: 4px;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .nav > a::after,
  .nav-dd > summary::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 3px;
    border-radius: 999px;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }
  .nav > a:hover,
  .nav-dd > summary:hover {
    color: var(--blue);
  }
  .nav > a:hover::after,
  .nav-dd > summary:hover::after {
    transform: scaleX(1);
  }

  /* Desktop courses dropdown */
  .nav-dd {
    position: relative;
  }
  .nav-dd > summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }
  .nav-dd > summary::-webkit-details-marker {
    display: none;
  }
  .dd-chevron {
    width: 15px;
    height: 15px;
    transition: transform 0.18s ease;
  }
  .nav-dd[open] > summary .dd-chevron {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: calc(100% + 14px);
    min-width: 230px;
    display: flex;
    flex-direction: column;
    padding: 8px;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    z-index: 60;
  }
  .dd-panel a {
    padding: 10px 14px;
    border-radius: 10px;
    font-weight: 600;
    color: var(--text-muted);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dd-panel a:hover {
    background: var(--sky);
    color: var(--ink);
  }
  .dd-all {
    margin-top: 4px;
    border-top: 1px solid var(--border);
    border-radius: 0 0 10px 10px !important;
    color: var(--blue) !important;
    font-weight: 700 !important;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.6vw, 14px);
  }
  .login-btn {
    white-space: nowrap;
    padding: 11px 20px;
    gap: 7px;
  }
  .login-btn .arrow {
    width: 17px;
    height: 17px;
    transition: transform 0.2s ease;
  }
  .login-btn:hover .arrow {
    transform: translateX(4px);
  }

  /* Hamburger */
  .menu-toggle,
  .burger {
    display: none;
  }
  .burger {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1.5px solid var(--border);
    background: var(--paper);
    cursor: pointer;
    place-items: center;
    gap: 5px;
    flex-direction: column;
  }
  .burger span {
    width: 20px;
    height: 2.4px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.22s ease, opacity 0.18s ease;
  }

  /* Mobile drawer */
  .mobile-drawer {
    display: none;
    background: var(--paper);
    border-top: 1px solid var(--border);
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 24px 22px;
  }
  .mobile-nav > a {
    padding: 13px 6px;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
  }
  .m-portal {
    margin-top: 14px;
    justify-content: center;
    border-bottom: 0 !important;
  }
  .m-dd {
    border-bottom: 1px solid var(--border);
  }
  .m-dd > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 6px;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .m-dd > summary::-webkit-details-marker {
    display: none;
  }
  .m-dd[open] > summary .dd-chevron {
    transform: rotate(180deg);
  }
  .m-dd-panel {
    display: flex;
    flex-direction: column;
    padding: 2px 0 10px 14px;
  }
  .m-dd-panel a {
    padding: 9px 6px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .m-dd-all {
    color: var(--blue) !important;
    font-weight: 700 !important;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
    .login-btn {
      display: none;
    }
    .burger {
      display: inline-flex;
    }
    /* Reliable open/close via the checkbox: a plain display toggle can't be
       dropped by the cascade (unlike an animated max-height). */
    .menu-toggle:checked ~ .mobile-drawer {
      display: block;
      max-height: 80vh;
      overflow-y: auto;
    }
    .menu-toggle:checked ~ .header-inner .burger span:nth-child(1) {
      transform: translateY(7.4px) rotate(45deg);
    }
    .menu-toggle:checked ~ .header-inner .burger span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle:checked ~ .header-inner .burger span:nth-child(3) {
      transform: translateY(-7.4px) rotate(-45deg);
    }
  }
</style>
