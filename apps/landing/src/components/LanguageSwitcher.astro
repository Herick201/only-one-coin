---
import { languages, type Lang } from "../i18n/ui";
import { getLangFromUrl, switchLangPath } from "../i18n/utils";

const current = getLangFromUrl(Astro.url);
const entries = Object.entries(languages) as [Lang, string][];
---

<details class="lang-switch">
  <summary aria-label={`${languages[current]} — cambiar idioma`}>
    <svg
      class="globe"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      <path d="M2 12h20"></path>
    </svg>
    <span class="current">{current.toUpperCase()}</span>
    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>

  <ul class="lang-menu">
    {
      entries.map(([code, label]) => (
        <li>
          <a
            href={switchLangPath(Astro.url, code)}
            class:list={["lang-link", { active: code === current }]}
            lang={code}
            aria-current={code === current ? "true" : undefined}
          >
            <span class="code">{code.toUpperCase()}</span>
            <span class="label">{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switch {
    position: relative;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--dp));
    cursor: pointer;
    list-style: none;
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: calc(999 * var(--dp));
    padding: calc(8 * var(--dp)) calc(13 * var(--dp));
    color: var(--ink);
    background: var(--paper);
    font-weight: 700;
    font-size: calc(13.12 * var(--dp));
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--blue);
    border-color: var(--blue);
  }
  .globe {
    width: calc(18 * var(--dp));
    height: calc(18 * var(--dp));
    color: var(--blue);
  }
  .chevron {
    width: calc(14 * var(--dp));
    height: calc(14 * var(--dp));
    transition: transform 0.18s ease;
  }
  .lang-switch[open] .chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + calc(8 * var(--dp)));
    min-width: calc(168 * var(--dp));
    margin: 0;
    padding: calc(6 * var(--dp));
    list-style: none;
    background: var(--paper);
    border: calc(1 * var(--dp)) solid var(--border);
    border-radius: calc(14 * var(--dp));
    box-shadow: var(--shadow-md);
    z-index: 60;
  }
  .lang-link {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--dp));
    padding: calc(9 * var(--dp)) calc(12 * var(--dp));
    border-radius: calc(10 * var(--dp));
    color: var(--text-muted);
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lang-link:hover {
    background: var(--sky);
    color: var(--ink);
  }
  .lang-link.active {
    color: var(--blue);
    background: var(--sky);
  }
  .lang-link .code {
    font-size: calc(11.52 * var(--dp));
    font-weight: 800;
    letter-spacing: 0.04em;
    width: calc(26 * var(--dp));
    color: var(--blue);
  }
  .lang-link .label {
    font-size: calc(14.4 * var(--dp));
  }
</style>
