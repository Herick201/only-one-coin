---
import { languages, type Lang } from "../i18n/ui";
import { getLangFromUrl, switchLangPath } from "../i18n/utils";

const current = getLangFromUrl(Astro.url);
const entries = Object.entries(languages) as [Lang, string][];
---

<details class="lang-switch">
  <summary aria-label={`${languages[current]} — cambiar idioma`}>
    <svg
      class="globe"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      <path d="M2 12h20"></path>
    </svg>
    <span class="current">{current.toUpperCase()}</span>
    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>

  <ul class="lang-menu">
    {
      entries.map(([code, label]) => (
        <li>
          <a
            href={switchLangPath(Astro.url, code)}
            class:list={["lang-link", { active: code === current }]}
            lang={code}
            aria-current={code === current ? "true" : undefined}
          >
            <span class="code">{code.toUpperCase()}</span>
            <span class="label">{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switch {
    position: relative;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    padding: 8px 13px;
    color: var(--ink);
    background: var(--paper);
    font-weight: 700;
    font-size: 0.82rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--blue);
    border-color: var(--blue);
  }
  .globe {
    width: 18px;
    height: 18px;
    color: var(--blue);
  }
  .chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.18s ease;
  }
  .lang-switch[open] .chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 168px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-md);
    z-index: 60;
  }
  .lang-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 10px;
    color: var(--text-muted);
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lang-link:hover {
    background: var(--sky);
    color: var(--ink);
  }
  .lang-link.active {
    color: var(--blue);
    background: var(--sky);
  }
  .lang-link .code {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    width: 26px;
    color: var(--blue);
  }
  .lang-link .label {
    font-size: 0.9rem;
  }

  /* Celular: o seletor acompanha a redução do header. */
  @media (max-width: 620px) {
    summary {
      gap: 4px;
      padding: 5px 8px;
      font-size: 0.6rem;
      border-width: 1.2px;
    }
    .globe {
      width: 12px;
      height: 12px;
    }
    .chevron {
      width: 10px;
      height: 10px;
    }
    .lang-menu {
      min-width: 132px;
      border-radius: 10px;
    }
    .lang-link {
      padding: 7px 9px;
      gap: 7px;
    }
    .lang-link .code {
      width: 20px;
      font-size: 0.6rem;
    }
    .lang-link .label {
      font-size: 0.72rem;
    }
  }
</style>
