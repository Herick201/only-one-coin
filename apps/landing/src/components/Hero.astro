---
import { Image } from "astro:assets";
import heroPhoto from "../assets/photos/hero.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.hero;

// Static, decorative SVGs for the feature strip (coin / globe / screen) —
// ordered like `hero.features` in every locale.
const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4.5"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>',
];
---

<section class="hero">
  <div class="hero-card">
    <span class="blob blob-a" aria-hidden="true"></span>
    <span class="blob blob-b" aria-hidden="true"></span>

    <div class="hero-grid">
    <div class="hero-copy">
      <span class="hero-badge">{h.badge}</span>
      <h1>
        <span class="line">{h.w1}</span>
        <span class="line accent">{h.w2}</span>
      </h1>
      <p class="hero-price-line">
        {h.subPre}
        <span class="price-pill">{h.price}</span>
        {h.priceUnit}.
      </p>
      <p class="hero-sub" set:html={h.sub2Html} />
      <div class="hero-actions">
        <a href={withLang(lang, "/enrollment")} class="btn btn-yellow btn-enroll">
          <span>{h.ctaEnroll}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href={withLang(lang, "/courses")} class="btn btn-ghost">{h.ctaCourses}</a>
      </div>
      <ul class="hero-features">
        {
          h.features.map((f, i) => (
            <li>
              <span class="feat-icon" set:html={featureIcons[i]} />
              <span class="feat-txt">
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-media">
      <Image
        src={heroPhoto}
        alt={h.imgAlt}
        widths={[480, 768, 1120, 1600]}
        sizes="50vw"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <span class="photo-blur" aria-hidden="true"></span>
      <span class="photo-caption" aria-hidden="true">
        {h.photoCaption}
        <svg class="caption-swoosh" viewBox="0 0 120 34" fill="none" aria-hidden="true">
          <path d="M4 8c28 26 74 26 112-4" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
        </svg>
      </span>
      <span class="corner-blob" aria-hidden="true"></span>
    </div>
    </div>
  </div>
</section>

<style>
  /* A matrícula é o que a página quer que aconteça: o botão é maior que
     qualquer outro clique. */
  .btn-enroll {
    font-size: calc(17.28 * var(--dp));
    letter-spacing: 0.02em;
    padding: calc(16 * var(--dp)) calc(32 * var(--dp));
    display: inline-flex;
    align-items: center;
    gap: calc(10 * var(--dp));
    white-space: nowrap;
  }
  .btn-enroll svg {
    width: calc(18 * var(--dp));
    height: calc(18 * var(--dp));
    transition: transform 0.2s ease;
  }
  .btn-enroll:hover svg {
    transform: translateX(calc(5 * var(--dp)));
  }
  .btn-ghost {
    background: var(--paper);
    color: var(--blue);
    border: calc(1.5 * var(--dp)) solid var(--blue);
    box-shadow: none;
  }
  .btn-ghost:hover {
    background: var(--sky);
  }
  /* Faixa retangular de borda a borda, curta — pedido de 03/09: tela
     completa, sem cantos arredondados nem margem de card. */
  .hero {
    background: var(--paper);
    padding: 0;
  }
  .hero-card {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(55% 60% at 8% 90%, rgba(47, 107, 255, 0.1), transparent 60%),
      var(--sky-soft);
  }
  /* Círculos suaves na lateral esquerda, a meia altura — como no mockup.
     No topo eles viravam uma "moldura" amarela sobre o card. */
  .blob-a {
    width: calc(260 * var(--dp));
    height: calc(260 * var(--dp));
    top: 18%;
    left: calc(-150 * var(--dp));
    background: var(--yellow);
    opacity: 0.22;
  }
  .blob-b {
    width: calc(220 * var(--dp));
    height: calc(220 * var(--dp));
    bottom: calc(-60 * var(--dp));
    left: calc(-110 * var(--dp));
    background: var(--blue);
    opacity: 0.1;
  }
  /* Formato web do mockup: texto na coluna da esquerda alinhado ao container,
     foto sangrando até a borda direita da janela, sem moldura. */
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    align-items: stretch;
  }
  .hero-copy {
    padding-block: calc(40 * var(--dp)) calc(44 * var(--dp));
    padding-left: max(calc(24 * var(--dp)), calc((100% - var(--maxw)) / 2 + calc(24 * var(--dp))));
    /* 32, não 44: com 44 a faixa de destaques passava um pixel da coluna na
       largura de desenho e quebrava em duas linhas — em todas as larguras,
       já que agora o desenho é o mesmo em todas. */
    padding-right: calc(32 * var(--dp));
    align-self: center;
  }

  .hero-badge {
    display: inline-block;
    color: var(--ink);
    font-weight: 700;
    font-size: calc(12.48 * var(--dp));
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: calc(14 * var(--dp));
  }
  h1 {
    font-size: calc(54.28 * var(--dp));
    line-height: 1.08;
  }
  .line {
    display: block;
  }
  .accent {
    color: var(--blue);
  }
  .hero-price-line {
    margin-top: calc(20 * var(--dp));
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(22.4 * var(--dp));
    color: var(--ink);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: calc(9 * var(--dp));
  }
  .price-pill {
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow-deep));
    color: var(--ink);
    font-weight: 700;
    padding: calc(1 * var(--dp)) calc(12 * var(--dp));
    border-radius: calc(10 * var(--dp));
    box-shadow: var(--shadow-yellow);
  }
  .hero-sub {
    margin-top: calc(12 * var(--dp));
    font-size: calc(16.64 * var(--dp));
    color: var(--text-muted);
    max-width: 40ch;
  }
  .hero-sub :global(.accent) {
    color: var(--blue);
    font-weight: 700;
  }
  .hero-actions {
    margin-top: calc(28 * var(--dp));
    display: flex;
    align-items: center;
    gap: calc(16 * var(--dp));
    flex-wrap: wrap;
  }
  .hero-features {
    margin: calc(34 * var(--dp)) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: calc(14 * var(--dp)) 0;
  }
  .hero-features li {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--dp));
  }
  /* Divisórias entre as features, como no mockup web. */
  .hero-features li + li {
    border-left: calc(1.5 * var(--dp)) solid var(--border);
    margin-left: calc(14 * var(--dp));
    padding-left: calc(14 * var(--dp));
  }
  .feat-icon {
    width: calc(44 * var(--dp));
    height: calc(44 * var(--dp));
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-features li:first-child .feat-icon {
    background: var(--blue-deep);
  }
  .feat-icon :global(svg) {
    width: calc(22 * var(--dp));
    height: calc(22 * var(--dp));
  }
  .feat-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .feat-txt strong {
    color: var(--ink);
  }
  .feat-txt span {
    font-size: calc(13.76 * var(--dp));
    color: var(--text-muted);
  }

  .hero-media {
    position: relative;
    min-height: calc(380 * var(--dp));
  }
  /* Funde a borda da foto com o fundo do hero — sem corte seco. */
  .hero-media::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: calc(140 * var(--dp));
    background: linear-gradient(90deg, var(--sky-soft), transparent);
    z-index: 1;
    pointer-events: none;
  }
  /* :global porque o <img> sai do componente <Image> — o escopo do Astro
     não alcança elemento renderizado por componente filho.
     object-position baixo: o corte vertical do cover subia até o teto escuro
     do escritório e a foto inteira parecia apagada — o mockup enquadra nas
     pessoas. brightness leve dá o tom lavado do mockup. */
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Corte do mockup: sem pés — o enquadramento sobe e fecha nos rostos. */
    object-position: 50% 34%;
    /* O tom lavado do mockup: bem mais claro e com menos contraste. */
    filter: brightness(1.14) contrast(0.94) saturate(1.02);
  }
  /* O "esfumaçado" do mockup, aproximado sem recorte: desfoca a periferia
     da foto (fundo) e preserva o centro nítido, onde está o grupo. A versão
     exata precisa do PNG das pessoas recortadas por cima do fundo borrado. */
  .photo-blur {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    backdrop-filter: blur(calc(6 * var(--dp)));
    /* Centro deslocado à direita: o desfoque fica no topo e na esquerda,
       e o lado direito da foto permanece limpo. */
    -webkit-mask-image: radial-gradient(115% 105% at 62% 55%, transparent 55%, #000 88%);
    mask-image: radial-gradient(115% 105% at 62% 55%, transparent 55%, #000 88%);
  }
  /* Véu branco do mockup: só desce do topo, apagando o teto. O véu da
     direita saiu a pedido — deixava o lado direito da foto esfumaçado. */
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(195deg, rgba(255, 255, 255, 0.65), transparent 42%);
    z-index: 1;
    pointer-events: none;
  }
  .photo-caption,
  .corner-blob {
    z-index: 2;
  }
  /* O lettering vai DENTRO da bolinha amarela do canto (pedido do dono,
     04/09/2026): sobre a foto ele não se lia em cor nenhuma — dourado sumia
     no véu branco e navy ficava disputando com os rostos. Na bola o fundo é
     chapado, então navy sobre amarelo resolve o contraste sem truque. A bola
     cresceu e subiu para caber as três linhas com folga; o traço curvo virou
     branco, porque dourado sobre dourado não existe. */
  .photo-caption {
    position: absolute;
    right: calc(18 * var(--dp));
    bottom: calc(22 * var(--dp));
    z-index: 3;
    /* 10ch quebra em "Juntos por / un mejor / futuro", as três linhas do
       desenho do dono — e cabe na parte visível da bola. */
    max-width: 10ch;
    font-family: var(--font-script);
    font-weight: 700;
    font-size: calc(32 * var(--dp));
    line-height: 0.95;
    color: var(--ink);
    text-align: center;
    transform: rotate(-5deg);
  }
  /* O traço curvo sob o lettering, como no mockup. */
  .caption-swoosh {
    display: block;
    width: calc(74 * var(--dp));
    margin-inline: auto;
    margin-top: calc(6 * var(--dp));
    color: var(--paper);
  }
  /* Enterrada no canto de propósito: aparece um quarto de círculo de
     220×200, o bastante para segurar o lettering sem comer a foto. O texto
     é dimensionado para caber INTEIRO dentro do arco — a linha mais larga
     ("Juntos por") é a que primeiro escapa se a fonte crescer. */
  .corner-blob {
    position: absolute;
    right: calc(-60 * var(--dp));
    bottom: calc(-80 * var(--dp));
    width: calc(280 * var(--dp));
    height: calc(280 * var(--dp));
    border-radius: 50%;
    background: var(--yellow);
    opacity: 0.9;
  }

</style>
