---
import { Image } from "astro:assets";
import heroPhoto from "../assets/photos/hero.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.hero;

// Static, decorative SVGs for the feature strip (coin / globe / screen) —
// ordered like `hero.features` in every locale.
const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4.5"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>',
];
---

<section class="hero">
  <span class="blob blob-a" aria-hidden="true"></span>
  <span class="blob blob-b" aria-hidden="true"></span>

  <div class="hero-grid">
    <div class="hero-copy">
      <span class="hero-badge">{h.badge}</span>
      <h1>
        <span class="line">{h.w1}</span>
        <span class="line accent">{h.w2}</span>
      </h1>
      <p class="hero-price-line">
        {h.subPre}
        <span class="price-pill">{h.price}</span>
        {h.priceUnit}.
      </p>
      <p class="hero-sub" set:html={h.sub2Html} />
      <div class="hero-actions">
        <a href={withLang(lang, "/enrollment")} class="btn btn-yellow btn-enroll">
          <span>{h.ctaEnroll}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href={withLang(lang, "/courses")} class="btn btn-ghost">{h.ctaCourses}</a>
      </div>
      <ul class="hero-features">
        {
          h.features.map((f, i) => (
            <li>
              <span class="feat-icon" set:html={featureIcons[i]} />
              <span class="feat-txt">
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-media">
      <Image
        src={heroPhoto}
        alt={h.imgAlt}
        widths={[480, 768, 1120, 1600]}
        sizes="(max-width: 900px) 100vw, 50vw"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <span class="photo-caption" aria-hidden="true">{h.photoCaption}</span>
      <span class="corner-blob" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  /* A matrícula é o que a página quer que aconteça: o botão é maior que
     qualquer outro clique. */
  .btn-enroll {
    font-size: 1.08rem;
    letter-spacing: 0.02em;
    padding: 16px 32px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .btn-enroll svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }
  .btn-enroll:hover svg {
    transform: translateX(5px);
  }
  .btn-ghost {
    background: var(--paper);
    color: var(--blue);
    border: 1.5px solid var(--blue);
    box-shadow: none;
  }
  .btn-ghost:hover {
    background: var(--sky);
  }
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(55% 60% at 8% 90%, rgba(47, 107, 255, 0.1), transparent 60%),
      var(--sky-soft);
  }
  .blob-a {
    width: 300px;
    height: 300px;
    top: -120px;
    left: -110px;
    background: var(--yellow);
    opacity: 0.3;
  }
  .blob-b {
    width: 260px;
    height: 260px;
    bottom: -110px;
    left: -80px;
    background: var(--blue);
    opacity: 0.14;
  }
  /* Formato web do mockup: texto na coluna da esquerda alinhado ao container,
     foto sangrando até a borda direita da janela, sem moldura. */
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    align-items: stretch;
  }
  .hero-copy {
    padding-block: 64px 72px;
    padding-left: max(24px, calc((100% - var(--maxw)) / 2 + 24px));
    padding-right: 48px;
    align-self: center;
  }

  .hero-badge {
    display: inline-block;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(2.5rem, 4.6vw, 3.9rem);
    line-height: 1.08;
  }
  .line {
    display: block;
  }
  .accent {
    color: var(--blue);
  }
  .hero-price-line {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--ink);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
  }
  .price-pill {
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow-deep));
    color: var(--ink);
    font-weight: 700;
    padding: 1px 12px;
    border-radius: 10px;
    box-shadow: var(--shadow-yellow);
  }
  .hero-sub {
    margin-top: 12px;
    font-size: 1.04rem;
    color: var(--text-muted);
    max-width: 40ch;
  }
  .hero-sub :global(.accent) {
    color: var(--blue);
    font-weight: 700;
  }
  .hero-actions {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-features {
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 0;
  }
  .hero-features li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* Divisórias entre as features, como no mockup web. */
  .hero-features li + li {
    border-left: 1.5px solid var(--border);
    margin-left: 26px;
    padding-left: 26px;
  }
  .feat-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-features li:first-child .feat-icon {
    background: var(--blue-deep);
  }
  .feat-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .feat-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .feat-txt strong {
    color: var(--ink);
  }
  .feat-txt span {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .hero-media {
    position: relative;
    min-height: 460px;
  }
  /* :global porque o <img> sai do componente <Image> — o escopo do Astro
     não alcança elemento renderizado por componente filho. */
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* O lettering do mockup: manuscrito amarelo sobre a foto. */
  .photo-caption {
    position: absolute;
    top: 56px;
    right: 36px;
    max-width: 8ch;
    font-family: var(--font-script);
    font-weight: 700;
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    line-height: 1;
    color: var(--yellow-bright);
    text-align: right;
    transform: rotate(-8deg);
    text-shadow: 0 2px 10px rgba(19, 34, 75, 0.55);
  }
  .corner-blob {
    position: absolute;
    right: -70px;
    bottom: -90px;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    background: var(--yellow);
    opacity: 0.9;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      padding: 48px 24px 40px;
    }
    .hero-sub {
      max-width: none;
    }
    .hero-media {
      min-height: 300px;
    }
    .photo-caption {
      top: 24px;
      right: 22px;
      font-size: 1.5rem;
    }
    .hero-features li + li {
      border-left: 0;
      margin-left: 0;
      padding-left: 0;
      margin-right: 26px;
    }
    .hero-features {
      gap: 14px 26px;
    }
  }
</style>
