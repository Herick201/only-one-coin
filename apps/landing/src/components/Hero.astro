---
import { Image } from "astro:assets";
import heroPhoto from "../assets/photos/hero.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.hero;

// Static, decorative SVGs for the feature strip (coin / globe / screen) —
// ordered like `hero.features` in every locale.
const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4.5"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>',
];
---

<section class="hero">
  <span class="blob blob-a" aria-hidden="true"></span>
  <span class="blob blob-b" aria-hidden="true"></span>

  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="line">{h.w1}</span>
        <span class="line accent">{h.w2}</span>
        <span class="line-price">
          <span class="w3">{h.w3}</span>
          <span class="price">
            {h.price}<span class="price-unit">{h.priceUnit}</span>
          </span>
        </span>
      </h1>
      <p class="hero-sub" set:html={h.subHtml} />
      <div class="hero-actions">
        <a href={withLang(lang, "/enrollment")} class="btn btn-yellow btn-enroll">{h.ctaEnroll}</a>
        <a href={withLang(lang, "/courses")} class="link-quiet">{h.ctaCourses}</a>
      </div>
      <ul class="hero-features">
        {
          h.features.map((f, i) => (
            <li>
              <span class="feat-icon" set:html={featureIcons[i]} />
              <span class="feat-txt">
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-media">
      <span class="dots" aria-hidden="true"></span>
      <span class="star star-1" aria-hidden="true">✦</span>
      <div class="hero-photo">
        <Image
          src={heroPhoto}
          alt={h.imgAlt}
          widths={[480, 768, 1120, 1600]}
          sizes="(max-width: 900px) 92vw, 560px"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* A matrícula é o que a página quer que aconteça: o botão é maior que
     qualquer outro clique, e pulsa uma vez ao carregar para puxar o olho. */
  .btn-enroll {
    font-size: 1.12rem;
    letter-spacing: 0.02em;
    padding: 18px 38px;
  }
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 64px 104px;
    background:
      radial-gradient(60% 70% at 88% 12%, rgba(255, 201, 60, 0.18), transparent 60%),
      radial-gradient(55% 60% at 8% 90%, rgba(47, 107, 255, 0.1), transparent 60%),
      var(--sky-soft);
  }
  .blob-a {
    width: 320px;
    height: 320px;
    top: -80px;
    right: -60px;
    background: var(--yellow);
    opacity: 0.28;
  }
  .blob-b {
    width: 260px;
    height: 260px;
    bottom: -90px;
    left: -70px;
    background: var(--blue);
    opacity: 0.16;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
  }
  .line {
    display: block;
  }
  .accent {
    color: var(--blue);
  }
  .line-price {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }
  .w3 {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    color: var(--ink);
  }
  .price {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow-deep));
    color: var(--ink);
    padding: 4px 20px 8px;
    border-radius: 16px;
    transform: rotate(-2deg);
    box-shadow: var(--shadow-yellow);
    font-size: clamp(2.4rem, 5.4vw, 3.6rem);
  }
  .price-unit {
    font-family: var(--font);
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .hero-sub {
    margin-top: 30px;
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 30ch;
  }
  .hero-sub :global(strong) {
    color: var(--ink);
  }
  .hero-sub :global(.accent) {
    color: var(--blue);
    font-weight: 700;
  }
  .hero-actions {
    margin-top: 34px;
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }
  .hero-features {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
  }
  .hero-features li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .feat-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-features li:first-child .feat-icon {
    background: var(--cream);
    color: var(--yellow-deep);
  }
  .feat-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .feat-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .feat-txt strong {
    color: var(--ink);
  }
  .feat-txt span {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .hero-media {
    position: relative;
  }
  .hero-photo {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 6px solid var(--paper);
    box-shadow: var(--shadow-md);
    transform: rotate(1.5deg);
  }
  .hero-photo img {
    width: 100%;
    height: auto;
  }
  /* Playful decorations */
  .dots {
    position: absolute;
    z-index: 1;
    top: -22px;
    right: -18px;
    width: 108px;
    height: 108px;
    background-image: radial-gradient(var(--blue) 2.4px, transparent 2.4px);
    background-size: 16px 16px;
    opacity: 0.35;
  }
  .star {
    position: absolute;
    z-index: 3;
    color: var(--yellow-deep);
    font-size: 2rem;
  }
  .star-1 {
    top: 40%;
    right: -20px;
    animation: twinkle 3s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.9; }
    50% { transform: scale(1.25) rotate(15deg); opacity: 1; }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-sub {
      max-width: none;
    }
    .hero-photo {
      transform: none;
    }
    .star-1 {
      right: 4px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .star-1 {
      animation: none;
    }
  }
</style>
