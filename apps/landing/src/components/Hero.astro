---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.hero;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="line accent">{h.w1}</span>
        <span class="line">{h.w2}</span>
        <span class="line accent">{h.w3}</span>
        <span class="price">{h.price} <span class="bang">!</span></span>
      </h1>
      <p class="hero-sub" set:html={h.subHtml} />
      <div class="hero-actions">
        <a href={withLang(lang, "/matricula")} class="btn btn-gold">{h.ctaEnroll}</a>
        <a href={withLang(lang, "/cursos")} class="btn btn-outline">{h.ctaCourses}</a>
      </div>
    </div>

    <div class="hero-media">
      <div class="hero-photo">
        <img src="/images/hero.jpg" alt={h.imgAlt} width="1280" height="689" />
      </div>
      <div class="hero-badge" set:html={h.badgeHtml} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 64px 96px;
    background:
      radial-gradient(60% 80% at 85% 20%, rgba(230, 168, 30, 0.14), transparent 60%),
      var(--bg);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: -0.02em;
  }
  .line {
    display: block;
  }
  .accent {
    color: var(--gold);
  }
  .price {
    display: block;
    color: var(--gold-bright);
    font-size: clamp(2.4rem, 6vw, 4rem);
  }
  .bang {
    color: var(--text);
  }
  .hero-sub {
    margin-top: 26px;
    font-size: 1.25rem;
    color: var(--text-muted);
  }
  .hero-sub :global(strong) {
    color: var(--text);
  }
  .hero-sub :global(.accent) {
    color: var(--gold);
  }
  .hero-actions {
    margin-top: 32px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-media {
    position: relative;
  }
  .hero-photo {
    border-radius: 24px;
    overflow: hidden;
    border: 4px solid var(--gold);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .hero-photo img {
    width: 100%;
    height: auto;
  }
  .hero-badge {
    position: absolute;
    left: -10px;
    bottom: -28px;
    max-width: 340px;
    background: var(--blue);
    color: #fff;
    padding: 18px 22px;
    border-radius: 16px;
    font-size: 1rem;
    box-shadow: 0 18px 40px -18px rgba(42, 63, 214, 0.8);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-badge {
      position: static;
      max-width: none;
      margin-top: 20px;
    }
  }
</style>
