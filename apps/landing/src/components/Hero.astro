---
import { Image } from "astro:assets";
import heroPhoto from "../assets/photos/hero.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.hero;

// Static, decorative SVGs for the feature strip (coin / globe / screen) —
// ordered like `hero.features` in every locale.
const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4.5"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>',
];
---

<section class="hero">
  <span class="blob blob-a" aria-hidden="true"></span>
  <span class="blob blob-b" aria-hidden="true"></span>

  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="hero-badge">{h.badge}</span>
      <h1>
        <span class="line">{h.w1}</span>
        <span class="line accent">{h.w2}</span>
      </h1>
      <p class="hero-price-line">
        {h.subPre}
        <span class="price-pill">{h.price}</span>
        {h.priceUnit}.
      </p>
      <p class="hero-sub" set:html={h.sub2Html} />
      <div class="hero-actions">
        <a href={withLang(lang, "/enrollment")} class="btn btn-yellow btn-enroll">
          <span>{h.ctaEnroll}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href={withLang(lang, "/courses")} class="btn btn-ghost">{h.ctaCourses}</a>
      </div>
      <ul class="hero-features">
        {
          h.features.map((f, i) => (
            <li>
              <span class="feat-icon" set:html={featureIcons[i]} />
              <span class="feat-txt">
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-media">
      <span class="dots" aria-hidden="true"></span>
      <div class="hero-photo">
        <Image
          src={heroPhoto}
          alt={h.imgAlt}
          widths={[480, 768, 1120, 1600]}
          sizes="(max-width: 900px) 92vw, 560px"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
        />
        <span class="photo-caption" aria-hidden="true">{h.photoCaption}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* A matrícula é o que a página quer que aconteça: o botão é maior que
     qualquer outro clique. */
  .btn-enroll {
    font-size: 1.08rem;
    letter-spacing: 0.02em;
    padding: 16px 32px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .btn-enroll svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }
  .btn-enroll:hover svg {
    transform: translateX(5px);
  }
  .btn-ghost {
    background: var(--paper);
    color: var(--blue);
    border: 1.5px solid var(--blue);
    box-shadow: none;
  }
  .btn-ghost:hover {
    background: var(--sky);
  }
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 56px 96px;
    background:
      radial-gradient(60% 70% at 88% 12%, rgba(255, 201, 60, 0.18), transparent 60%),
      radial-gradient(55% 60% at 8% 90%, rgba(47, 107, 255, 0.1), transparent 60%),
      var(--sky-soft);
  }
  .blob-a {
    width: 320px;
    height: 320px;
    top: -80px;
    right: -60px;
    background: var(--yellow);
    opacity: 0.28;
  }
  .blob-b {
    width: 260px;
    height: 260px;
    bottom: -90px;
    left: -70px;
    background: var(--yellow);
    opacity: 0.22;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }

  .hero-badge {
    display: inline-block;
    background: var(--cream);
    color: var(--yellow-deep);
    border: 1.5px solid rgba(245, 166, 35, 0.35);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: 18px;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    line-height: 1.06;
  }
  .line {
    display: block;
  }
  .accent {
    color: var(--blue);
  }
  .hero-price-line {
    margin-top: 22px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    color: var(--ink);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .price-pill {
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow-deep));
    color: var(--ink);
    font-weight: 700;
    padding: 2px 14px;
    border-radius: 12px;
    transform: rotate(-2deg);
    box-shadow: var(--shadow-yellow);
  }
  .hero-sub {
    margin-top: 14px;
    font-size: 1.08rem;
    color: var(--text-muted);
    max-width: 40ch;
  }
  .hero-sub :global(.accent) {
    color: var(--blue);
    font-weight: 700;
  }
  .hero-actions {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-features {
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
  }
  .hero-features li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .feat-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-features li:first-child .feat-icon {
    background: var(--cream);
    color: var(--yellow-deep);
  }
  .feat-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .feat-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .feat-txt strong {
    color: var(--ink);
  }
  .feat-txt span {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .hero-media {
    position: relative;
  }
  .hero-photo {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 6px solid var(--paper);
    box-shadow: var(--shadow-md);
  }
  .hero-photo img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* O lettering do mockup: manuscrito amarelo sobre a foto. */
  .photo-caption {
    position: absolute;
    top: 18px;
    right: 20px;
    max-width: 8ch;
    font-family: var(--font-script);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1;
    color: var(--yellow-bright);
    text-align: right;
    transform: rotate(-6deg);
    text-shadow: 0 2px 10px rgba(19, 34, 75, 0.55);
  }
  .dots {
    position: absolute;
    z-index: 1;
    top: -22px;
    right: -18px;
    width: 108px;
    height: 108px;
    background-image: radial-gradient(var(--blue) 2.4px, transparent 2.4px);
    background-size: 16px 16px;
    opacity: 0.35;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-sub {
      max-width: none;
    }
  }
</style>
