---
import { Image } from "astro:assets";
import heroPhoto from "../assets/photos/hero.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.hero;

// Static, decorative SVGs for the feature strip (coin / globe / screen) —
// ordered like `hero.features` in every locale.
const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4.5"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>',
];
---

<section class="hero">
  <div class="hero-card">
    <span class="blob blob-a" aria-hidden="true"></span>
    <span class="blob blob-b" aria-hidden="true"></span>

    <div class="hero-grid">
    <div class="hero-copy">
      <span class="hero-badge">{h.badge}</span>
      <h1>
        <span class="line">{h.w1}</span>
        <span class="line accent">{h.w2}</span>
      </h1>
      <p class="hero-price-line">
        {h.subPre}
        <span class="price-pill">{h.price}</span>
        {h.priceUnit}.
      </p>
      <p class="hero-sub" set:html={h.sub2Html} />
      <div class="hero-actions">
        <a href={withLang(lang, "/enrollment")} class="btn btn-yellow btn-enroll">
          <span>{h.ctaEnroll}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href={withLang(lang, "/courses")} class="btn btn-ghost">{h.ctaCourses}</a>
      </div>
      <ul class="hero-features">
        {
          h.features.map((f, i) => (
            <li>
              <span class="feat-icon" set:html={featureIcons[i]} />
              <span class="feat-txt">
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-media">
      <Image
        src={heroPhoto}
        alt={h.imgAlt}
        widths={[480, 768, 1120, 1600]}
        sizes="(max-width: 900px) 100vw, 50vw"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <span class="photo-caption" aria-hidden="true">
        {h.photoCaption}
        <svg class="caption-swoosh" viewBox="0 0 120 34" fill="none" aria-hidden="true">
          <path d="M4 8c28 26 74 26 112-4" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
        </svg>
      </span>
      <span class="corner-blob" aria-hidden="true"></span>
    </div>
    </div>
  </div>
</section>

<style>
  /* A matrícula é o que a página quer que aconteça: o botão é maior que
     qualquer outro clique. */
  .btn-enroll {
    font-size: 1.08rem;
    letter-spacing: 0.02em;
    padding: 16px 32px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .btn-enroll svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }
  .btn-enroll:hover svg {
    transform: translateX(5px);
  }
  .btn-ghost {
    background: var(--paper);
    color: var(--blue);
    border: 1.5px solid var(--blue);
    box-shadow: none;
  }
  .btn-ghost:hover {
    background: var(--sky);
  }
  /* Formato do mockup: o hero é um card arredondado flutuando na página
     branca, com pequena margem — não uma faixa colada nas bordas. */
  .hero {
    background: var(--paper);
    padding: 16px 22px 30px;
  }
  .hero-card {
    position: relative;
    overflow: hidden;
    border-radius: 26px;
    max-width: 1500px;
    margin-inline: auto;
    background:
      radial-gradient(55% 60% at 8% 90%, rgba(47, 107, 255, 0.1), transparent 60%),
      var(--sky-soft);
    box-shadow: var(--shadow-sm);
  }
  .blob-a {
    width: 300px;
    height: 300px;
    top: -120px;
    left: -110px;
    background: var(--yellow);
    opacity: 0.3;
  }
  .blob-b {
    width: 260px;
    height: 260px;
    bottom: -110px;
    left: -80px;
    background: var(--blue);
    opacity: 0.14;
  }
  /* Formato web do mockup: texto na coluna da esquerda alinhado ao container,
     foto sangrando até a borda direita da janela, sem moldura. */
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    align-items: stretch;
  }
  .hero-copy {
    padding: 56px 44px 60px 56px;
    align-self: center;
  }

  .hero-badge {
    display: inline-block;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(2.5rem, 4.6vw, 3.9rem);
    line-height: 1.08;
  }
  .line {
    display: block;
  }
  .accent {
    color: var(--blue);
  }
  .hero-price-line {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--ink);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
  }
  .price-pill {
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow-deep));
    color: var(--ink);
    font-weight: 700;
    padding: 1px 12px;
    border-radius: 10px;
    box-shadow: var(--shadow-yellow);
  }
  .hero-sub {
    margin-top: 12px;
    font-size: 1.04rem;
    color: var(--text-muted);
    max-width: 40ch;
  }
  .hero-sub :global(.accent) {
    color: var(--blue);
    font-weight: 700;
  }
  .hero-actions {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-features {
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 0;
  }
  .hero-features li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* Divisórias entre as features, como no mockup web. */
  .hero-features li + li {
    border-left: 1.5px solid var(--border);
    margin-left: 26px;
    padding-left: 26px;
  }
  .feat-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-features li:first-child .feat-icon {
    background: var(--blue-deep);
  }
  .feat-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .feat-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .feat-txt strong {
    color: var(--ink);
  }
  .feat-txt span {
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .hero-media {
    position: relative;
    min-height: 460px;
  }
  /* Funde a borda da foto com o fundo do hero — sem corte seco. */
  .hero-media::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 140px;
    background: linear-gradient(90deg, var(--sky-soft), transparent);
    z-index: 1;
    pointer-events: none;
  }
  /* :global porque o <img> sai do componente <Image> — o escopo do Astro
     não alcança elemento renderizado por componente filho.
     object-position baixo: o corte vertical do cover subia até o teto escuro
     do escritório e a foto inteira parecia apagada — o mockup enquadra nas
     pessoas. brightness leve dá o tom lavado do mockup. */
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 68%;
    /* O tom lavado do mockup: bem mais claro e com menos contraste. */
    filter: brightness(1.14) contrast(0.94) saturate(1.02);
  }
  /* Véus brancos do mockup: descem do topo (apagam o teto) e entram pela
     direita, atrás do lettering. */
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(195deg, rgba(255, 255, 255, 0.65), transparent 42%),
      linear-gradient(270deg, rgba(255, 255, 255, 0.7), transparent 42%);
    z-index: 1;
    pointer-events: none;
  }
  .photo-caption,
  .corner-blob {
    z-index: 2;
  }
  /* O lettering do mockup: manuscrito amarelo sobre a foto. */
  .photo-caption {
    position: absolute;
    top: 44px;
    right: 32px;
    max-width: 8ch;
    font-family: var(--font-script);
    font-weight: 700;
    font-size: clamp(2.1rem, 3.5vw, 3rem);
    line-height: 0.95;
    /* Dourado fechado: sobre o véu branco, o amarelo claro sumia. */
    color: var(--yellow-deep);
    text-align: right;
    transform: rotate(-7deg);
    text-shadow: 0 2px 8px rgba(19, 34, 75, 0.18);
  }
  /* O traço curvo amarelo sob o lettering, como no mockup. */
  .caption-swoosh {
    display: block;
    width: 96px;
    margin-left: auto;
    margin-top: 10px;
    color: var(--yellow-deep);
  }
  .corner-blob {
    position: absolute;
    right: -70px;
    bottom: -90px;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    background: var(--yellow);
    opacity: 0.9;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      padding: 48px 24px 40px;
    }
    .hero-sub {
      max-width: none;
    }
    .hero-media {
      min-height: 300px;
    }
    /* Em coluna única a emenda é horizontal: o degradê desce do topo. */
    .hero-media::before {
      left: 0;
      right: 0;
      bottom: auto;
      width: auto;
      height: 90px;
      background: linear-gradient(180deg, var(--sky-soft), transparent);
    }
    .photo-caption {
      top: 24px;
      right: 22px;
      font-size: 1.5rem;
    }
    .hero-features li + li {
      border-left: 0;
      margin-left: 0;
      padding-left: 0;
      margin-right: 26px;
    }
    .hero-features {
      gap: 14px 26px;
    }
  }
</style>
