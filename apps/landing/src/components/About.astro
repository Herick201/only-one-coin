---
import { Image } from "astro:assets";
import { org } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";
import teamPhoto from "../assets/photos/about-team.jpg";
import coinPhoto from "../assets/photos/about-coin.jpg";
import onlinePhoto from "../assets/photos/about-online.jpg";
import valuesPhoto from "../assets/photos/about-teaching.jpg";
import supportPhoto from "../assets/photos/about-support.jpg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const a = t.pages.about;

// The "how long we have been doing this" claim is counted, never typed: one
// constant (org.foundedYear) instead of a number that quietly rots every year.
const years = new Date().getFullYear() - org.foundedYear;
const lead = a.lead.replace("{years}", String(years));

// The partner brand is written once in `org.partner` and interpolated into the
// locale copy, so a rename or a domain change never leaves one language behind.
const partnerName = org.partner.name;
const partnerTitleAccent = a.partnerTitleAccent.replace("{partner}", partnerName);
const partnerText = a.partnerText.replaceAll("{partner}", partnerName);
const partnerCta = a.partnerCta.replace("{partner}", partnerName);
// The wordmark is set the way NR Labs sets it — ink letters, blue dot — so the
// title shows the brand instead of the Asociación's yellow-underlined accent.
// Split on the dot rather than hardcoding "NR" / "Labs": the styling follows
// `org.partner.name`, and a partner without a dot in its name still renders.
const [wordmarkHead, ...wordmarkRest] = partnerTitleAccent.split(".");
const wordmarkTail = wordmarkRest.join(".");

// Icons (Lucide) for mission / vision and for the four values, in the same
// order as `a.values`. Not translatable content, so they live here.
const missionIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>';
const visionIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>';
const valueIcons = [
  // users (inclusión)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  // badge-check (calidad)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 15 5l4-.6.6 4L23 12l-3.4 3.6-.6 4-4-.6L12 22l-3-3-4 .6-.6-4L1 12l3.4-3.6L5 4.4l4 .6Z"/><path d="m9 12 2 2 4-4"/></svg>',
  // heart-handshake (compromiso)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/><path d="m12 5.4 2.6 2.6a1.8 1.8 0 0 1-2.6 2.6L10.8 9.4"/></svg>',
  // rocket (innovación)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2 0-2.8a2 2 0 0 0-3 0Z"/><path d="M12 15 9 12a11 11 0 0 1 2-6.6C13.4 2.2 17 2 21 2c0 4-.2 7.6-3.4 10A11 11 0 0 1 12 15Z"/><path d="M9 12H5s.5-2.6 2-3.5c1.7-1 4 0 4 0"/><path d="M12 15v4s2.6-.5 3.5-2c1-1.7 0-4 0-4"/></svg>',
];
---

<!-- Intro: who we are + the team -->
<section class="section about-intro">
  <span class="blob intro-blob" aria-hidden="true"></span>
  <div class="container intro-grid">
    <div class="intro-copy">
      <span class="eyebrow">{a.eyebrow}</span>
      <h1 class="section-title">
        {a.titlePre}<span class="accent">{a.titleAccent}</span>{a.titlePost}
      </h1>
      <p class="lead">{lead}</p>
      <p class="text-muted">{a.lead2}</p>
      <div class="intro-actions">
        <a href={withLang(lang, "/enrollment")} class="btn btn-yellow">{t.hero.ctaEnroll}</a>
        <a href={withLang(lang, "/contact")} class="link-quiet">{t.nav.contact}</a>
      </div>
    </div>

    <div class="photo-stack">
      <div class="photo-frame">
        <Image
          src={teamPhoto}
          alt={a.teamAlt}
          widths={[420, 640, 900]}
          sizes="(max-width: 900px) 92vw, 480px"
          format="webp"
          quality={78}
          loading="eager"
        />
      </div>
      <div class="photo-inset">
        <Image
          src={coinPhoto}
          alt={a.coinAlt}
          widths={[280, 460]}
          sizes="240px"
          format="webp"
          quality={78}
        />
      </div>
    </div>
  </div>
</section>

<!-- Why us: the teaching side -->
<section class="section about-why">
  <!-- The row is text on one side and a photo on the other, so the far corner
       reads as blank page. Brand furniture fills it instead of a third tinted
       band — the section stays white and the page keeps its light/tinted rhythm. -->
  <img
    class="why-watermark"
    src="/brand/logo-mark.png"
    alt=""
    aria-hidden="true"
    width="192"
    height="66"
    loading="lazy"
  />
  <span class="blob why-blob" aria-hidden="true"></span>
  <div class="container why-grid">
    <span class="dots why-dots" aria-hidden="true"></span>
    <div class="photo-frame why-photo">
      <Image
        src={onlinePhoto}
        alt={a.whyAlt}
        widths={[420, 640, 900]}
        sizes="(max-width: 900px) 92vw, 460px"
        format="webp"
        quality={78}
        loading="lazy"
      />
    </div>
    <div class="why-copy">
      <h2 class="section-title small">{a.whyTitle}</h2>
      <p class="text-muted">{a.whyText}</p>
      <p class="text-muted">{a.whyText2}</p>

      <div class="photo-frame why-photo-side">
        <Image
          src={supportPhoto}
          alt={a.whyAlt2}
          widths={[340, 520, 720]}
          sizes="(max-width: 800px) 92vw, 360px"
          format="webp"
          quality={78}
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<!-- Mission / vision -->
<section class="section about-mv">
  <div class="container mv-grid">
    <article class="mv-card">
      <div class="mv-icon" set:html={missionIcon} />
      <h2>{a.missionTitle}</h2>
      <p>{a.missionText}</p>
    </article>
    <article class="mv-card">
      <div class="mv-icon" set:html={visionIcon} />
      <h2>{a.visionTitle}</h2>
      <p>{a.visionText}</p>
    </article>
  </div>
</section>

<!-- Values -->
<section class="section about-values">
  <div class="container">
    <div class="values-head">
      <h2 class="section-title">
        {a.valuesTitlePre}<span class="accent">{a.valuesTitleAccent}</span>{a.valuesTitlePost}
      </h2>
      <p class="text-muted">{a.valuesLead}</p>
    </div>

    <div class="values-banner photo-frame">
      <Image
        src={valuesPhoto}
        alt={a.valuesAlt}
        widths={[640, 960, 1280]}
        sizes="(max-width: 1180px) 92vw, 1080px"
        format="webp"
        quality={78}
        loading="lazy"
      />
    </div>

    <div class="value-cards">
      {
        a.values.map((value, i) => (
          <article class="value-card">
            <div class="value-icon" set:html={valueIcons[i]} />
            <h3>{value.title}</h3>
            <p class="text-muted">{value.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Strategic technology partner: who built the platform and keeps it running.
     Closes the page on purpose — it is context about the Asociación, not a
     claim about the courses. -->
<section class="section about-partner">
  <div class="container partner-grid">
    <a class="partner-logo" href={org.partner.url} target="_blank" rel="noopener">
      <img
        src="/brand/nr-labs-lockup-ink.png"
        alt={partnerName}
        width="455"
        height="160"
        loading="lazy"
      />
    </a>

    <div class="partner-copy">
      <span class="eyebrow">{a.partnerEyebrow}</span>
      <h2 class="section-title small">
        {a.partnerTitlePre}<span class="wordmark"
          >{wordmarkHead}{wordmarkTail && <span class="wordmark-dot">.</span>}{wordmarkTail}</span
        >
      </h2>
      <p class="text-muted">{partnerText}</p>
      <a class="btn btn-outline partner-cta" href={org.partner.url} target="_blank" rel="noopener">
        {partnerCta}
      </a>
    </div>
  </div>
</section>

<style>
  /* ---------- intro ---------- */
  .about-intro {
    position: relative;
    overflow: hidden;
    padding-block: calc(64 * var(--dp)) calc(88 * var(--dp));
    background:
      radial-gradient(50% 55% at 92% 4%, rgba(255, 201, 60, 0.16), transparent 60%),
      var(--sky-soft);
  }
  .intro-blob {
    width: calc(320 * var(--dp));
    height: calc(320 * var(--dp));
    top: calc(-140 * var(--dp));
    left: calc(-110 * var(--dp));
    background: var(--blue);
    opacity: 0.12;
  }
  /* auto-fit, not a breakpoint: the column splits when there is room for two
     readable columns, and stacks when there isn't. */
  .intro-grid,
  .why-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(330 * var(--dp)), 1fr));
    gap: calc(54 * var(--dp));
    align-items: center;
  }
  .eyebrow {
    display: inline-block;
    margin-bottom: calc(14 * var(--dp));
    padding: calc(6 * var(--dp)) calc(14 * var(--dp));
    border-radius: calc(999 * var(--dp));
    background: var(--cream);
    color: var(--yellow-deep);
    font-size: calc(12.48 * var(--dp));
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lead {
    margin-top: calc(18 * var(--dp));
    font-size: calc(17.92 * var(--dp));
    color: var(--ink);
  }
  .intro-copy p + p {
    margin-top: calc(12 * var(--dp));
  }
  .intro-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: calc(22 * var(--dp));
    margin-top: calc(28 * var(--dp));
  }

  /* ---------- shared photo frame ---------- */
  .photo-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--paper);
  }
  .photo-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-stack {
    position: relative;
  }
  .photo-stack .photo-frame {
    aspect-ratio: 4 / 5;
  }
  /* The coin is the whole brand story, so it gets its own card overlapping the
     team shot instead of another row. Dropped when there is no room to overlap
     without covering faces. */
  .photo-inset {
    position: absolute;
    left: calc(-26 * var(--dp));
    bottom: calc(-26 * var(--dp));
    width: calc(240 * var(--dp));
    border-radius: var(--radius);
    overflow: hidden;
    border: calc(5 * var(--dp)) solid var(--paper);
    box-shadow: var(--shadow-md);
  }
  .photo-inset :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
  }

  /* ---------- why us ---------- */
  .about-why {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    padding-block: calc(88 * var(--dp));
  }
  /* Big, quiet, and bleeding off the edge: at this opacity it reads as texture,
     not as a second logo competing with the header. */
  .why-watermark {
    position: absolute;
    /* Pushed well off the corner on purpose: a mark that fits entirely on the
       page reads as a second logo, a cropped one reads as texture. */
    right: calc(-150 * var(--dp));
    bottom: calc(-120 * var(--dp));
    width: min(calc(760 * var(--dp)), calc(731.6 * var(--dp)));
    height: auto;
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }
  .why-blob {
    width: calc(300 * var(--dp));
    height: calc(300 * var(--dp));
    top: calc(-90 * var(--dp));
    left: calc(-120 * var(--dp));
    background: var(--yellow);
    opacity: 0.22;
  }
  .why-grid {
    position: relative;
  }
  /* Same dot grid as the hero, so the page speaks the homepage's language. */
  .why-dots {
    position: absolute;
    z-index: 1;
    left: calc(-26 * var(--dp));
    bottom: calc(-26 * var(--dp));
    width: calc(108 * var(--dp));
    height: calc(108 * var(--dp));
    background-image: radial-gradient(var(--blue) calc(2.4 * var(--dp)), transparent calc(2.4 * var(--dp)));
    background-size: calc(16 * var(--dp)) calc(16 * var(--dp));
    opacity: 0.3;
  }
  .why-photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    max-height: calc(560 * var(--dp));
  }
  /* Above the decoration, always: the dot grid sits in the grid's bottom-left,
     which is beside the photo in two columns but behind the copy in one. */
  .why-copy {
    position: relative;
    z-index: 2;
  }
  /* The row needs 2x330px + calc(54 * var(--dp)) gap + calc(48 * var(--dp)) padding before it can hold two
     columns; below that it stacks and the dots have nothing to decorate. */
  .section-title.small {
    font-size: calc(35.2 * var(--dp));
    margin-bottom: calc(18 * var(--dp));
  }
  .why-copy p + p {
    margin-top: calc(12 * var(--dp));
  }
  /* Small and off to the side: it fills the gap under the copy without
     competing with the tall photo across the row. */
  .why-photo-side {
    margin-top: calc(28 * var(--dp));
    width: min(calc(360 * var(--dp)), 100%);
    aspect-ratio: 3 / 2;
  }

  /* ---------- mission / vision ---------- */
  .about-mv {
    background: var(--sky);
    padding-block: calc(78 * var(--dp));
  }
  .mv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(320 * var(--dp)), 1fr));
    gap: calc(26 * var(--dp));
  }
  .mv-card {
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: var(--radius);
    padding: calc(36 * var(--dp)) calc(32 * var(--dp));
    box-shadow: var(--shadow-sm);
  }
  .mv-icon {
    width: calc(62 * var(--dp));
    height: calc(62 * var(--dp));
    display: grid;
    place-items: center;
    border-radius: calc(18 * var(--dp));
    background: var(--sky);
    color: var(--blue);
    margin-bottom: calc(18 * var(--dp));
  }
  .mv-card:nth-child(even) .mv-icon {
    background: var(--cream);
    color: var(--yellow-deep);
  }
  .mv-icon :global(svg) {
    width: calc(30 * var(--dp));
    height: calc(30 * var(--dp));
  }
  .mv-card h2 {
    font-size: calc(22.4 * var(--dp));
    margin-bottom: calc(10 * var(--dp));
  }
  .mv-card p {
    color: var(--text-muted);
  }

  /* ---------- values ---------- */
  .about-values {
    background: var(--paper);
    padding-block: calc(88 * var(--dp));
  }
  .values-head {
    max-width: calc(760 * var(--dp));
    margin-inline: auto;
    text-align: center;
  }
  .values-head p {
    margin-top: calc(16 * var(--dp));
  }
  .values-banner {
    margin-top: calc(46 * var(--dp));
    aspect-ratio: 21 / 8;
    max-height: calc(380 * var(--dp));
  }
  .value-cards {
    margin-top: calc(40 * var(--dp));
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(250 * var(--dp)), 1fr));
    gap: calc(24 * var(--dp));
  }
  .value-card {
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: var(--radius);
    padding: calc(30 * var(--dp)) calc(26 * var(--dp));
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .value-card:hover {
    transform: translateY(calc(-8 * var(--dp)));
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }
  .value-icon {
    width: calc(56 * var(--dp));
    height: calc(56 * var(--dp));
    display: grid;
    place-items: center;
    border-radius: calc(16 * var(--dp));
    background: var(--sky);
    color: var(--blue);
    margin-bottom: calc(16 * var(--dp));
  }
  .value-card:nth-child(even) .value-icon {
    background: var(--cream);
    color: var(--yellow-deep);
  }
  .value-icon :global(svg) {
    width: calc(27 * var(--dp));
    height: calc(27 * var(--dp));
  }
  .value-card h3 {
    font-size: calc(18.4 * var(--dp));
    margin-bottom: calc(8 * var(--dp));
  }

  /* ---------- strategic partner ---------- */
  .about-partner {
    padding-block: calc(24 * var(--dp)) calc(88 * var(--dp));
  }
  /* auto-fit, not a breakpoint: the logo sits beside the copy while there is
     room for two readable columns, and stacks above it when there isn't. */
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(260 * var(--dp)), 1fr));
    gap: calc(40 * var(--dp));
    align-items: center;
    padding: calc(38 * var(--dp));
    border: calc(1 * var(--dp)) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--sky-soft);
  }
  .partner-logo {
    display: grid;
    place-items: center;
    padding: calc(30 * var(--dp));
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .partner-logo:hover {
    transform: translateY(calc(-4 * var(--dp)));
    box-shadow: var(--shadow-md);
  }
  .partner-logo img {
    /* Ink-on-transparent lockup, sized by width so the 455x160 art keeps its
       ratio inside the card. */
    width: 100%;
    max-width: calc(320 * var(--dp));
    height: auto;
    display: block;
  }
  /* NR Labs' own brand colours, sampled from the lockup art. Literal hex on
     purpose: these belong to the partner, not to the Only One Coin palette, so
     they must not follow a token when our own brand shifts. */
  .wordmark {
    color: #0b0d0c;
    white-space: nowrap;
    position: relative;
  }
  /* Same hand-drawn underline `.section-title .accent` draws in global.css,
     redrawn here instead of reusing `.accent`: that rule also forces the word
     blue, which would overwrite the partner's own letter colour. */
  .wordmark::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.14em;
    height: 0.16em;
    border-radius: calc(999 * var(--dp));
    background: var(--yellow);
  }
  .wordmark-dot {
    color: #0041b3;
  }
  .partner-copy p {
    margin-top: calc(12 * var(--dp));
  }
  .partner-cta {
    margin-top: calc(24 * var(--dp));
  }

</style>
