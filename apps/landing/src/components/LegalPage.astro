---
import { legalContent, type LegalKind } from "../i18n/legal";
import { fillOrgTokens, getLangFromUrl } from "../i18n/utils";

interface Props {
  kind: LegalKind;
}

const { kind } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const doc = legalContent[lang][kind];

// The legal copy carries placeholders instead of retyping the company's
// identity in all three locales (see i18n/legal.ts). Resolved once, here.
const fill = fillOrgTokens;
---

<section class="section legal">
  <span class="blob legal-blob" aria-hidden="true"></span>
  <div class="container">
    <article class="legal-doc">
      <h1>{doc.title}</h1>

      {
        doc.intro.map((block) =>
          block.kind === "p" ? (
            <p>{fill(block.text)}</p>
          ) : (
            <ul>{block.items.map((item) => <li>{fill(item)}</li>)}</ul>
          ),
        )
      }

      {
        doc.sections.map((section) => (
          <section class="legal-section">
            <h2>{section.heading}</h2>
            {section.blocks.map((block) =>
              block.kind === "p" ? (
                <p>{fill(block.text)}</p>
              ) : (
                <ul>{block.items.map((item) => <li>{fill(item)}</li>)}</ul>
              ),
            )}
          </section>
        ))
      }
    </article>
  </div>
</section>

<style>
  .legal {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(50% 55% at 92% 4%, rgba(255, 201, 60, 0.14), transparent 60%),
      var(--sky-soft);
  }
  .legal-blob {
    width: calc(300 * var(--dp));
    height: calc(300 * var(--dp));
    top: calc(-130 * var(--dp));
    left: calc(-90 * var(--dp));
    background: var(--blue);
    opacity: 0.12;
  }
  .legal-doc {
    position: relative;
    z-index: 1;
    /* A measure, not a breakpoint: legal text is read line by line, so the
       column is capped in characters and centred whatever the viewport is. */
    max-width: 74ch;
    margin-inline: auto;
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: calc(56 * var(--dp));
  }
  .legal-doc h1 {
    font-size: calc(38.4 * var(--dp));
    color: var(--ink);
    margin-bottom: calc(8 * var(--dp));
  }
  .legal-section {
    margin-top: calc(34 * var(--dp));
  }
  .legal-doc h2 {
    font-family: var(--font);
    font-size: calc(16.8 * var(--dp));
    font-weight: 700;
    color: var(--ink);
    margin-bottom: calc(10 * var(--dp));
  }
  .legal-doc p {
    margin: 0 0 calc(12 * var(--dp));
    color: var(--text-muted);
    line-height: 1.75;
  }
  .legal-doc p:last-child {
    margin-bottom: 0;
  }
  .legal-doc ul {
    margin: 0 0 calc(12 * var(--dp));
    padding-left: calc(18.4 * var(--dp));
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--dp));
    color: var(--text-muted);
    line-height: 1.7;
  }
  .legal-doc ul:last-child {
    margin-bottom: 0;
  }
  .legal-doc li::marker {
    color: var(--blue);
  }
</style>
