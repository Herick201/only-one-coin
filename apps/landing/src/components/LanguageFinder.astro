---
import { languageSlugs, geoSuggestion } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";
import { courseIdBySlug, enrollmentHref } from "../data/checkout";
import LanguageFlag from "./LanguageFlag.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fd = t.finder;

// Server-rendered default (works without JS); the client refines by geo.
const defaultSlug = "english" as const;

const enrollPath = withLang(lang, "/enrollment");
const courses = languageSlugs.map((slug) => ({
  slug,
  name: t.courses.list[slug],
  href: withLang(lang, `/courses/${slug}`),
  // A sugestão por geo troca de idioma no cliente, então o link de matrícula
  // de cada idioma viaja junto na config — o CTA nunca fica apontando para o
  // curso anterior.
  enrollHref: enrollmentHref(enrollPath, {
    courseId: courseIdBySlug[slug],
    content: "finder_suggestion",
  }),
}));

// Config the client script reads (non-executable JSON — CSP-safe).
const clientConfig = {
  geo: geoSuggestion,
  courses: Object.fromEntries(
    courses.map((c) => [c.slug, { name: c.name, href: c.href, enrollHref: c.enrollHref }]),
  ),
  defaultSlug,
};
---

<section class="section finder" id="finder">
  <div class="container">
    <h2 class="section-title">{fd.titlePre}<span class="accent">{fd.titleAccent}</span>{fd.titlePost}</h2>
    <p class="finder-lead text-muted">{fd.text}</p>

    <div class="universe">
      <span class="orbit-ring" aria-hidden="true"></span>
      <span class="spark spark-a" aria-hidden="true">✦</span>
      <span class="spark spark-b" aria-hidden="true">✦</span>

      <div class="finder-reco">
        <p class="from" data-finder-from hidden>
          <span>{fd.fromLabel}</span> <strong data-finder-country></strong>
        </p>
        <p class="reco-pre">{fd.recommendPre}</p>
        <p class="reco-lang" data-finder-name>{courses.find((c) => c.slug === defaultSlug)?.name}</p>
        <a
          class="btn btn-yellow reco-cta"
          data-finder-cta
          href={courses.find((c) => c.slug === defaultSlug)?.enrollHref}
        >
          <span>{t.hero.ctaEnroll}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a
          class="link-quiet link-quiet-on-blue reco-secondary"
          data-finder-course
          href={withLang(lang, `/courses/${defaultSlug}`)}
        >
          {fd.viewCourse}
        </a>
      </div>

      <nav class="orbit" aria-label={fd.orChoose}>
        {
          courses.map((c, i) => (
            <a
              class="chip sat"
              style={`--a: ${Math.round((i * 360) / courses.length) - 90}deg`}
              data-slug={c.slug}
              href={c.href}
            >
              <span class="sat-center">
                <span class="sat-inner">
                  <LanguageFlag slug={c.slug} />
                  <span class="sat-name">{c.name}</span>
                </span>
              </span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="finder-footer">
      <p class="choose-label">{fd.orChoose}</p>
      <a class="all-link" href={withLang(lang, "/courses")}>{fd.allCourses} →</a>
    </div>
  </div>

  <script type="application/json" data-finder-config set:html={JSON.stringify(clientConfig)}></script>
  <script>
    // Refine the recommendation from the visitor's country (Vercel edge geo,
    // same-origin fetch → satisfies `connect-src 'self'`). No PII is stored;
    // we only read a coarse country code to pick a suggested course.
    type Cfg = {
      geo: Record<string, string>;
      courses: Record<string, { name: string; href: string; enrollHref: string }>;
      defaultSlug: string;
    };
    const cfgEl = document.querySelector<HTMLElement>("[data-finder-config]");
    const root = document.querySelector<HTMLElement>("#finder");
    if (cfgEl && root) {
      const cfg: Cfg = JSON.parse(cfgEl.textContent || "{}");
      fetch("/api/geo", { headers: { accept: "application/json" } })
        .then((r) => (r.ok ? r.json() : null))
        .then((data: { country?: string; countryName?: string } | null) => {
          const code = data?.country?.toUpperCase();
          const slug = (code && cfg.geo[code]) || cfg.defaultSlug;
          const course = cfg.courses[slug];
          if (!course) return;

          const nameEl = root.querySelector<HTMLElement>("[data-finder-name]");
          const ctaEl = root.querySelector<HTMLAnchorElement>("[data-finder-cta]");
          const courseEl = root.querySelector<HTMLAnchorElement>("[data-finder-course]");
          if (nameEl) nameEl.textContent = course.name;
          if (ctaEl) ctaEl.href = course.enrollHref;
          if (courseEl) courseEl.href = course.href;

          const fromEl = root.querySelector<HTMLElement>("[data-finder-from]");
          const countryEl = root.querySelector<HTMLElement>("[data-finder-country]");
          if (data?.countryName && fromEl && countryEl) {
            countryEl.textContent = data.countryName;
            fromEl.hidden = false;
          }
          root.querySelectorAll<HTMLElement>(".chip").forEach((chip) => {
            chip.classList.toggle("active", chip.dataset.slug === slug);
          });
        })
        .catch(() => {
          /* offline / local dev: keep the server-rendered default */
        });
    }
  </script>
</section>

<style>
  .finder {
    background: var(--paper);
  }
  .reco-secondary {
    display: inline-block;
    margin-top: 14px;
    font-size: 0.94rem;
  }
  .finder-lead {
    margin-top: 14px;
    max-width: 56ch;
    font-size: 1.08rem;
  }
  /* ——— Universo: o card recomendado é o sol, os idiomas orbitam. ———
     A órbita inteira gira devagar; cada satélite contra-gira na mesma
     velocidade para o rótulo ficar sempre de pé. Hover/focus pausa tudo
     (ninguém clica em alvo que foge). */
  .universe {
    /* Tamanho num só lugar: o raio da órbita deriva dele. */
    --u: min(680px, 92vw);
    --r: calc(var(--u) / 2 - 48px);
    position: relative;
    width: var(--u);
    aspect-ratio: 1;
    margin: 44px auto 0;
  }
  .orbit-ring {
    position: absolute;
    inset: 34px;
    border: 1.5px dashed rgba(47, 107, 255, 0.28);
    border-radius: 50%;
  }
  .spark {
    position: absolute;
    color: var(--yellow-deep);
    font-size: 1.3rem;
    opacity: 0.8;
  }
  .spark-a {
    top: 9%;
    right: 16%;
  }
  .spark-b {
    bottom: 12%;
    left: 13%;
    font-size: 0.95rem;
  }
  .finder-reco {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(52%, 350px);
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 32px 30px;
    box-shadow: var(--shadow-blue);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .orbit {
    position: absolute;
    inset: 0;
    animation: orbit-spin 60s linear infinite;
  }
  .sat {
    position: absolute;
    top: 50%;
    left: 50%;
    /* Ponto sem tamanho sobre o círculo da órbita. */
    width: 0;
    height: 0;
    transform: rotate(var(--a)) translateX(var(--r)) rotate(calc(-1 * var(--a)));
  }
  .sat-center {
    /* Centra o pill no ponto, qualquer que seja a largura do rótulo. */
    display: inline-block;
    transform: translate(-50%, -50%);
  }
  .sat-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px 8px 9px;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--paper);
    box-shadow: 0 4px 14px rgba(19, 34, 75, 0.08);
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    animation: orbit-spin 60s linear infinite reverse;
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .sat :global(.lang-flag) {
    width: 28px;
    height: 28px;
  }
  .sat:hover .sat-inner {
    border-color: var(--blue);
    color: var(--blue);
    transform: scale(1.07);
  }
  .sat.active .sat-inner {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--ink);
  }
  .orbit:hover,
  .orbit:hover .sat-inner,
  .orbit:focus-within,
  .orbit:focus-within .sat-inner {
    animation-play-state: paused;
  }
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .finder-footer {
    margin-top: 34px;
    text-align: center;
  }
  .from {
    margin: 0 0 4px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82);
  }
  .from strong {
    color: var(--yellow-bright);
  }
  .reco-pre {
    margin: 0;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .reco-lang {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1.05;
    color: var(--yellow-bright);
  }
  .reco-cta {
    margin-top: auto;
  }
  .reco-cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }
  .reco-cta:hover svg {
    transform: translateX(5px);
  }

  .choose-label {
    margin: 0 0 10px;
    font-weight: 600;
    color: var(--ink);
  }
  .all-link {
    font-weight: 700;
    color: var(--blue);
  }
  .all-link:hover {
    text-decoration: underline;
  }

  /* Sem espaço pra órbita: o universo colapsa em card + chips com bandeira,
     o layout que a tela estreita já conhecia. */
  @media (max-width: 760px) {
    .universe {
      width: auto;
      aspect-ratio: auto;
      margin-top: 32px;
    }
    .orbit-ring,
    .spark {
      display: none;
    }
    .finder-reco {
      position: static;
      transform: none;
      width: auto;
      padding: 38px 34px;
    }
    .orbit {
      position: static;
      margin-top: 22px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      animation: none;
    }
    .sat {
      position: static;
      width: auto;
      height: auto;
      transform: none;
    }
    .sat-center {
      transform: none;
    }
    .sat-inner {
      animation: none;
      box-shadow: none;
    }
    .finder-footer {
      margin-top: 24px;
      text-align: left;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reco-cta:hover svg {
      transform: none;
    }
    .orbit,
    .sat-inner {
      animation: none;
    }
  }
</style>
