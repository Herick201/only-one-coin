---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

interface Props {
  kind: "blog" | "community";
}

const { kind } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pages[kind];
---

<section class="section info-page">
  <span class="blob blob-a" aria-hidden="true"></span>
  <div class="container">
    <header class="info-head">
      <h1 class="section-title">{p.titlePre}<span class="accent">{p.titleAccent}</span>{p.titlePost}</h1>
      <p class="info-lead text-muted">{p.lead}</p>
    </header>

    <div class="soon-card">
      <span class="soon-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
      </span>
      <h2>{p.soonTitle}</h2>
      <p class="text-muted">{p.soonText}</p>
      <a class="btn btn-yellow" href={withLang(lang, "/courses")}>{t.hero.ctaCourses}</a>
    </div>
  </div>
</section>

<style>
  .info-page {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(50% 55% at 92% 4%, rgba(255, 201, 60, 0.14), transparent 60%),
      var(--sky-soft);
  }
  .blob-a {
    width: calc(300 * var(--dp));
    height: calc(300 * var(--dp));
    top: calc(-120 * var(--dp));
    left: calc(-80 * var(--dp));
    background: var(--blue);
    opacity: 0.12;
  }
  .info-head {
    position: relative;
    z-index: 1;
    max-width: calc(720 * var(--dp));
    margin-inline: auto;
    text-align: center;
  }
  .info-lead {
    margin-top: calc(16 * var(--dp));
    font-size: calc(17.92 * var(--dp));
  }
  .soon-card {
    position: relative;
    z-index: 1;
    margin: calc(48 * var(--dp)) auto 0;
    max-width: calc(560 * var(--dp));
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: calc(48 * var(--dp)) calc(40 * var(--dp));
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(12 * var(--dp));
  }
  .soon-icon {
    width: calc(64 * var(--dp));
    height: calc(64 * var(--dp));
    display: grid;
    place-items: center;
    border-radius: calc(18 * var(--dp));
    background: var(--sky);
    color: var(--blue);
    margin-bottom: calc(6 * var(--dp));
  }
  .soon-icon svg {
    width: calc(32 * var(--dp));
    height: calc(32 * var(--dp));
  }
  .soon-card h2 {
    font-size: calc(24 * var(--dp));
  }
  .soon-card .btn {
    margin-top: calc(14 * var(--dp));
  }
</style>
