---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const s = t.stats;
---

<section class="stats" aria-label={s.title}>
  <div class="container stats-inner">
    {
      s.items.map((item) => (
        <div class="stat">
          <span class="stat-value" data-countup>{item.value}</span>
          <span class="stat-label">{item.label}</span>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Count-up on first view. The final value is server-rendered from the
  // locale string; the script only re-plays the number inside it, so any
  // prefix/suffix ("+", "años", "millones") and the locale's decimal
  // separator survive untouched — and no-JS visitors see the real value.
  const NUMBER = /(\d+(?:[.,]\d+)?)/;
  const DURATION_MS = 1400;

  function animate(el: HTMLElement) {
    const original = el.textContent ?? "";
    const match = original.match(NUMBER);
    if (!match || match.index === undefined) return;

    const raw = match[1];
    const separator = raw.includes(",") ? "," : ".";
    const decimals = raw.includes(separator) ? raw.split(separator)[1].length : 0;
    const target = Number(raw.replace(",", "."));
    const prefix = original.slice(0, match.index);
    const suffix = original.slice(match.index + raw.length);
    const start = performance.now();

    function frame(now: number) {
      const progress = Math.min((now - start) / DURATION_MS, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = (target * eased).toFixed(decimals).replace(".", separator);
      el.textContent = prefix + value + suffix;
      if (progress < 1) requestAnimationFrame(frame);
      else el.textContent = original;
    }
    requestAnimationFrame(frame);
  }

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          animate(entry.target as HTMLElement);
        }
      },
      { threshold: 0.5 },
    );
    document.querySelectorAll<HTMLElement>("[data-countup]").forEach((el) => observer.observe(el));
  }
</script>

<style>
  .stats {
    background: var(--paper);
    padding-block: calc(8 * var(--dp)) calc(4 * var(--dp));
  }
  .stats-inner {
    display: grid;
    /* Quantos números couberem por linha — o browser decide, não um
       breakpoint: a lista mudou de 3 para 4 itens e vai mudar de novo. */
    grid-template-columns: repeat(auto-fit, minmax(calc(190 * var(--dp)), 1fr));
    gap: calc(20 * var(--dp));
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    border-radius: var(--radius-lg);
    padding: calc(34 * var(--dp)) calc(28 * var(--dp));
    box-shadow: var(--shadow-blue);
  }
  .stat {
    text-align: center;
    position: relative;
  }
  .stat:not(:last-child)::after {
    content: "";
    position: absolute;
    right: calc(-10 * var(--dp));
    top: 12%;
    height: 76%;
    width: calc(1 * var(--dp));
    background: rgba(255, 255, 255, 0.22);
  }
  .stat-value {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(48 * var(--dp));
    line-height: 1;
    color: var(--yellow-bright);
  }
  .stat-label {
    display: block;
    margin-top: calc(8 * var(--dp));
    font-weight: 600;
    font-size: calc(15.2 * var(--dp));
    color: rgba(255, 255, 255, 0.9);
  }
</style>
