---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pk = t.perks;

// Ícones por oficina, na mesma ordem de pk.items em todos os idiomas.
const icons = [
  // table/grid (Excel)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>',
  // rocket (emprendimiento)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2 0-2.8-.8-.7-2-.7-3 -.2Z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.9 7.5-6 11a22.4 22.4 0 0 1-4 2Z"/><path d="M9 12H4s.6-3.3 2-4.5C7.6 6.2 12 7 12 7"/><path d="M12 15v5s3.3-.6 4.5-2c1.3-1.6.5-6-.5-6"/></svg>',
  // crown (liderazgo)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 8 4.5 3L12 5l4.5 6L21 8l-1.5 10h-15L3 8Z"/><path d="M5 21h14"/></svg>',
  // mountain/sun (quechua — los Andes)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="17" cy="6" r="3"/><path d="m2 20 7-11 4 6"/><path d="m10 15 4-6 8 11H2"/></svg>',
];
---

<section class="section perks" id="benefits">
  <div class="container">
    <h2 class="section-title">{pk.titlePre}<span class="accent">{pk.titleAccent}</span>{pk.titlePost}</h2>
    <p class="perks-lead text-muted">{pk.lead}</p>

    <div class="perks-row">
      {
        pk.items.map((item, i) => (
          <article class="perk">
            <span class="perk-icon" set:html={icons[i]} />
            <div class="perk-txt">
              <h3>{item.title}</h3>
              <p class="text-muted">{item.text}</p>
            </div>
          </article>
        ))
      }
      <a class="btn btn-outline perks-all" href={withLang(lang, "/faq")}>
        <span>{pk.allCta}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .perks {
    background: var(--paper);
  }
  .perks-lead {
    margin-top: calc(12 * var(--dp));
    font-size: calc(16.96 * var(--dp));
  }
  .perks-row {
    margin-top: calc(38 * var(--dp));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(20 * var(--dp));
  }
  /* Base zero, não 230px: com uma base fixa a soma dos quatro estourava a
     linha na largura de desenho e o botão caía para a linha de baixo. */
  .perk {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: calc(14 * var(--dp));
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: var(--radius);
    padding: calc(22 * var(--dp)) calc(20 * var(--dp));
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .perk:hover {
    transform: translateY(calc(-5 * var(--dp)));
    box-shadow: var(--shadow-md);
  }
  /* Ícones na cor da própria marca de cada oficina, sem tile — mockup web. */
  .perk-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: calc(2 * var(--dp));
  }
  .perk:nth-child(1) .perk-icon {
    color: #1d6f42;
  }
  .perk:nth-child(2) .perk-icon {
    color: var(--blue);
  }
  .perk:nth-child(3) .perk-icon {
    color: #8e44ad;
  }
  .perk:nth-child(4) .perk-icon {
    color: #c1272d;
  }
  .perk-icon :global(svg) {
    width: calc(28 * var(--dp));
    height: calc(28 * var(--dp));
  }
  /* Sem `min-width: 0` o bloco de texto não encolhe abaixo da própria linha
     e transborda por cima do card vizinho quando a fileira aperta. */
  .perk-txt {
    min-width: 0;
  }
  .perk-txt h3 {
    font-size: calc(16.8 * var(--dp));
    margin-bottom: calc(2 * var(--dp));
  }
  .perk-txt p {
    margin: 0;
    font-size: calc(14.08 * var(--dp));
    line-height: 1.4;
  }
  .btn-outline {
    background: var(--paper);
    color: var(--blue);
    border: calc(1.5 * var(--dp)) solid var(--blue);
    box-shadow: none;
    display: inline-flex;
    align-items: center;
    gap: calc(9 * var(--dp));
    white-space: nowrap;
  }
  .btn-outline:hover {
    background: var(--sky);
  }
  .btn-outline svg {
    width: calc(16 * var(--dp));
    height: calc(16 * var(--dp));
  }

  /* ——— Celular: a segunda largura de desenho (390px, global.css). ———
     Abaixo de 900px não é esta seção encolhida — é outra composição para a
     mesma seção. A fileira de quatro oficinas vira lista, e o
     botão fecha a lista em largura cheia em vez de disputar a linha. */
  @media (max-width: 900px) {
    .perks-lead {
      font-size: calc(15 * var(--dp));
    }
    .perks-row {
      margin-top: calc(24 * var(--dp));
      flex-direction: column;
      align-items: stretch;
      gap: calc(12 * var(--dp));
    }
    .perk {
      flex: 0 0 auto;
      padding: calc(16 * var(--dp));
      gap: calc(12 * var(--dp));
      border-radius: calc(16 * var(--dp));
    }
    .perk-icon :global(svg) {
      width: calc(24 * var(--dp));
      height: calc(24 * var(--dp));
    }
    .perk-txt h3 {
      font-size: calc(15.5 * var(--dp));
    }
    .perk-txt p {
      font-size: calc(13.4 * var(--dp));
    }
    .perks-all {
      margin-top: calc(4 * var(--dp));
      justify-content: center;
    }
  }
</style>
