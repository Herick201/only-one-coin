---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pk = t.perks;

// Ícones por oficina, na mesma ordem de pk.items em todos os idiomas.
const icons = [
  // table/grid (Excel)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>',
  // rocket (emprendimiento)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2 0-2.8-.8-.7-2-.7-3 -.2Z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.9 7.5-6 11a22.4 22.4 0 0 1-4 2Z"/><path d="M9 12H4s.6-3.3 2-4.5C7.6 6.2 12 7 12 7"/><path d="M12 15v5s3.3-.6 4.5-2c1.3-1.6.5-6-.5-6"/></svg>',
  // crown (liderazgo)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 8 4.5 3L12 5l4.5 6L21 8l-1.5 10h-15L3 8Z"/><path d="M5 21h14"/></svg>',
  // mountain/sun (quechua — los Andes)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="17" cy="6" r="3"/><path d="m2 20 7-11 4 6"/><path d="m10 15 4-6 8 11H2"/></svg>',
];
---

<section class="section perks" id="benefits">
  <div class="container">
    <h2 class="section-title">{pk.titlePre}<span class="accent">{pk.titleAccent}</span>{pk.titlePost}</h2>
    <p class="perks-lead text-muted">{pk.lead}</p>

    <div class="perks-row">
      {
        pk.items.map((item, i) => (
          <article class="perk">
            <span class="perk-icon" set:html={icons[i]} />
            <div class="perk-txt">
              <h3>{item.title}</h3>
              <p class="text-muted">{item.text}</p>
            </div>
          </article>
        ))
      }
      <a class="btn btn-outline perks-all" href={withLang(lang, "/faq")}>
        <span>{pk.allCta}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .perks {
    background: var(--paper);
  }
  .perks-lead {
    margin-top: 12px;
    font-size: 1.06rem;
  }
  .perks-row {
    margin-top: 38px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }
  .perk {
    flex: 1 1 230px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 22px 20px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .perk:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  /* Ícones na cor da própria marca de cada oficina, sem tile — mockup web. */
  .perk-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .perk:nth-child(1) .perk-icon {
    color: #1d6f42;
  }
  .perk:nth-child(2) .perk-icon {
    color: var(--blue);
  }
  .perk:nth-child(3) .perk-icon {
    color: #8e44ad;
  }
  .perk:nth-child(4) .perk-icon {
    color: #c1272d;
  }
  .perk-icon :global(svg) {
    width: 28px;
    height: 28px;
  }
  /* Sem `min-width: 0` o bloco de texto não encolhe abaixo da própria linha
     e transborda por cima do card vizinho quando a fileira aperta. */
  .perk-txt {
    min-width: 0;
  }
  .perk-txt h3 {
    font-size: 1.05rem;
    margin-bottom: 2px;
  }
  .perk-txt p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .btn-outline {
    background: var(--paper);
    color: var(--blue);
    border: 1.5px solid var(--blue);
    box-shadow: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
  }
  .btn-outline:hover {
    background: var(--sky);
  }
  .btn-outline svg {
    width: 16px;
    height: 16px;
  }

  /* Mobile: os quatro talleres e o botão continuam na mesma fileira da vista
     web — `flex: 1 1 0` no lugar da base de 230px, que os empilharia. */
  @media (max-width: 900px) {
    .perks-lead {
      margin-top: 8px;
      font-size: 0.9rem;
    }
    .perks-row {
      margin-top: 22px;
      flex-wrap: nowrap;
      gap: 10px;
    }
    .perk {
      flex: 1 1 0;
      min-width: 0;
      gap: 8px;
      padding: 14px 10px;
      border-radius: 14px;
    }
    .perk-icon :global(svg) {
      width: 20px;
      height: 20px;
    }
    .perk-txt h3 {
      font-size: 0.8rem;
      overflow-wrap: anywhere;
    }
    .perk-txt p {
      font-size: 0.68rem;
      overflow-wrap: anywhere;
    }
    .btn-outline {
      flex: 0 1 auto;
    }
  }

  @media (max-width: 620px) {
    .perks-lead {
      margin-top: 4px;
      font-size: 0.62rem;
    }
    .perks-row {
      margin-top: 12px;
      gap: 4px;
    }
    .perk {
      gap: 4px;
      padding: 7px 5px;
      border-radius: 8px;
      border-width: 1px;
    }
    .perk-icon :global(svg) {
      width: 12px;
      height: 12px;
    }
    .perk-txt h3 {
      font-size: 0.48rem;
      margin-bottom: 1px;
    }
    .perk-txt p {
      font-size: 0.38rem;
      line-height: 1.25;
    }
    /* O rótulo do botão quebra em duas linhas: em `nowrap` ele comia metade
       da fileira e espremia os quatro talleres até o texto partir. */
    .btn-outline {
      flex: 0 1 78px;
      gap: 3px;
      padding: 6px 8px;
      font-size: 0.46rem;
      line-height: 1.25;
      white-space: normal;
      text-align: center;
      border-width: 1.2px;
    }
    .btn-outline svg {
      width: 8px;
      height: 8px;
      flex: none;
    }
  }
</style>
