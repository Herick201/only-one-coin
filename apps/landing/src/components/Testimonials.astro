---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ts = t.testimonials;
---

<section class="section testi" id="testimonios">
  <div class="container">
    <div class="testi-head">
      <h2 class="section-title">
        {ts.titlePre}<span class="accent">{ts.titleAccent}</span>{ts.titlePost}
      </h2>
      <p class="testi-lead text-muted">{ts.lead}</p>
    </div>

    <div class="testi-carousel" data-testi-carousel>
      <button class="t-arrow t-prev" data-testi-prev aria-label={ts.prev} type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>

      <div class="testi-window" data-testi-window>
        <div class="testi-track" data-testi-track>
          {
            ts.items.map((item) => (
              <figure class="testi-card">
                <div class="stars" aria-label="5/5">★★★★★</div>
                <blockquote>{item.quote}</blockquote>
                <figcaption class="who">
                  <span class="avatar" aria-hidden="true">{item.initials}</span>
                  <span class="who-txt">
                    <span class="name">{item.name}</span>
                    <span class="role">{item.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>

      <button class="t-arrow t-next" data-testi-next aria-label={ts.next} type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </div>

    <p class="note">{ts.note}</p>
  </div>
</section>

<script>
  // Infinite "roulette" carousel: cards loop seamlessly and auto-advance,
  // with blue arrows on the same line as the cards. Bundled by Astro
  // (served from /_astro) so it satisfies `script-src 'self'`.
  const carousel = document.querySelector<HTMLElement>("[data-testi-carousel]");
  const track = document.querySelector<HTMLElement>("[data-testi-track]");
  const prevBtn = document.querySelector<HTMLElement>("[data-testi-prev]");
  const nextBtn = document.querySelector<HTMLElement>("[data-testi-next]");

  if (carousel && track && prevBtn && nextBtn) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const originals = Array.from(track.children) as HTMLElement[];
    const count = originals.length;

    // Clone the full set once so advancing past the last card lands on an
    // identical frame we can silently reset to the start (seamless loop).
    originals.forEach((node) => {
      const clone = node.cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      track.appendChild(clone);
    });

    let index = 0;
    let animating = false;

    const step = () => {
      const first = track.children[0] as HTMLElement;
      const gap = parseFloat(getComputedStyle(track).columnGap || "26") || 26;
      return first.getBoundingClientRect().width + gap;
    };

    const apply = (withTransition: boolean) => {
      track.style.transition = withTransition ? "transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)" : "none";
      track.style.transform = `translateX(${-index * step()}px)`;
    };

    const next = () => {
      if (animating) return;
      animating = true;
      index += 1;
      apply(true);
    };

    const prev = () => {
      if (animating) return;
      animating = true;
      if (index === 0) {
        index = count; // identical frame, jump instantly…
        apply(false);
        void track.offsetWidth; // …force reflow so the next move animates
        index = count - 1;
        apply(true);
      } else {
        index -= 1;
        apply(true);
      }
    };

    track.addEventListener("transitionend", () => {
      animating = false;
      if (index >= count) {
        index -= count;
        apply(false);
      }
    });

    // Autoplay (the "roulette" motion) — off when the user prefers reduced motion.
    let timer: number | undefined;
    const play = () => {
      if (reduce.matches) return;
      window.clearInterval(timer);
      timer = window.setInterval(next, 3800);
    };
    const stop = () => window.clearInterval(timer);

    prevBtn.addEventListener("click", () => {
      prev();
      play();
    });
    nextBtn.addEventListener("click", () => {
      next();
      play();
    });

    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", play);
    window.addEventListener("resize", () => apply(false));

    apply(false);
    play();
  }
</script>

<style>
  .testi {
    background: var(--paper);
  }
  .testi-head > .section-title {
    max-width: 640px;
  }
  .testi-lead {
    margin-top: 10px;
    font-size: 1.06rem;
  }

  .testi-carousel {
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .testi-window {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .testi-track {
    display: flex;
    gap: 26px;
    will-change: transform;
  }

  /* Blue circular arrows, vertically centered on the line of the cards */
  .t-arrow {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    background: var(--paper);
    color: var(--blue);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }
  .t-arrow svg {
    width: 22px;
    height: 22px;
  }
  .t-arrow:hover {
    background: var(--blue);
    color: #fff;
    transform: scale(1.08);
  }
  .t-arrow:active {
    transform: scale(0.96);
  }

  .testi-card {
    flex: 0 0 calc((100% - 2 * 26px) / 3);
    margin: 0;
    background: var(--sky-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: var(--shadow-sm);
  }
  .stars {
    color: var(--yellow-deep);
    font-size: 1.1rem;
    letter-spacing: 2px;
  }
  blockquote {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
    line-height: 1.55;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: auto;
  }
  .avatar {
    width: 46px;
    height: 46px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .testi-card:nth-child(even) .avatar {
    background: var(--yellow);
    color: var(--ink);
  }
  .who-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .name {
    font-weight: 700;
    color: var(--ink);
  }
  .role {
    font-size: 0.86rem;
    color: var(--text-muted);
  }
  .note {
    margin-top: 26px;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-style: italic;
    text-align: center;
  }

  /* 2 per view on tablet, 1 per view on phones */
  @media (max-width: 900px) {
    .testi-card {
      flex-basis: calc((100% - 26px) / 2);
    }
  }
  @media (max-width: 620px) {
    .testi-card {
      flex-basis: 100%;
    }
    .testi-carousel {
      gap: 8px;
    }
    .t-arrow {
      width: 44px;
      height: 44px;
    }
  }
</style>
