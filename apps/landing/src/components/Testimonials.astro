---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ts = t.testimonials;
---

<section class="section testi" id="testimonios">
  <div class="container">
    <div class="testi-head">
      <h2 class="section-title">
        {ts.titlePre}<span class="accent">{ts.titleAccent}</span>{ts.titlePost}
      </h2>
      <p class="testi-lead text-muted">{ts.lead}</p>
    </div>

    <div class="testi-carousel" data-testi-carousel>
      <button class="t-arrow t-prev" data-testi-prev aria-label={ts.prev} type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>

      <div class="testi-window" data-testi-window>
        <div class="testi-track" data-testi-track>
          {
            ts.items.map((item) => (
              <figure class="testi-card">
                {/* Sem foto real de aluno no repo ainda: o tile de iniciais
                    ocupa o lugar da foto do mockup, no mesmo formato. */}
                <span class="avatar" aria-hidden="true">{item.initials}</span>
                <div class="testi-body">
                  <blockquote>{item.quote}</blockquote>
                  <figcaption class="who-txt">
                    <span class="name">{item.name}</span>
                    <span class="role">{item.role}</span>
                  </figcaption>
                </div>
              </figure>
            ))
          }
        </div>
      </div>

      <button class="t-arrow t-next" data-testi-next aria-label={ts.next} type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </div>

    <p class="note">{ts.note}</p>
  </div>
</section>

<script>
  // Infinite "roulette" carousel: cards loop seamlessly and auto-advance,
  // with blue arrows on the same line as the cards. Bundled by Astro
  // (served from /_astro) so it satisfies `script-src 'self'`.
  const carousel = document.querySelector<HTMLElement>("[data-testi-carousel]");
  const track = document.querySelector<HTMLElement>("[data-testi-track]");
  const prevBtn = document.querySelector<HTMLElement>("[data-testi-prev]");
  const nextBtn = document.querySelector<HTMLElement>("[data-testi-next]");

  if (carousel && track && prevBtn && nextBtn) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const originals = Array.from(track.children) as HTMLElement[];
    const count = originals.length;

    // Clone the full set once so advancing past the last card lands on an
    // identical frame we can silently reset to the start (seamless loop).
    originals.forEach((node) => {
      const clone = node.cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      track.appendChild(clone);
    });

    let index = 0;
    let animating = false;

    const step = () => {
      const first = track.children[0] as HTMLElement;
      const gap = parseFloat(getComputedStyle(track).columnGap || "26") || 26;
      return first.getBoundingClientRect().width + gap;
    };

    const apply = (withTransition: boolean) => {
      track.style.transition = withTransition ? "transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)" : "none";
      track.style.transform = `translateX(${-index * step()}px)`;
    };

    const next = () => {
      if (animating) return;
      animating = true;
      index += 1;
      apply(true);
    };

    const prev = () => {
      if (animating) return;
      animating = true;
      if (index === 0) {
        index = count; // identical frame, jump instantly…
        apply(false);
        void track.offsetWidth; // …force reflow so the next move animates
        index = count - 1;
        apply(true);
      } else {
        index -= 1;
        apply(true);
      }
    };

    track.addEventListener("transitionend", () => {
      animating = false;
      if (index >= count) {
        index -= count;
        apply(false);
      }
    });

    // Autoplay (the "roulette" motion) — off when the user prefers reduced motion.
    let timer: number | undefined;
    const play = () => {
      if (reduce.matches) return;
      window.clearInterval(timer);
      timer = window.setInterval(next, 3800);
    };
    const stop = () => window.clearInterval(timer);

    prevBtn.addEventListener("click", () => {
      prev();
      play();
    });
    nextBtn.addEventListener("click", () => {
      next();
      play();
    });

    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", play);
    window.addEventListener("resize", () => apply(false));

    apply(false);
    play();
  }
</script>

<style>
  .testi {
    background: var(--paper);
  }
  .testi-head > .section-title {
    max-width: calc(640 * var(--dp));
  }
  .testi-lead {
    margin-top: calc(10 * var(--dp));
    font-size: calc(16.96 * var(--dp));
  }

  .testi-carousel {
    margin-top: calc(40 * var(--dp));
    display: flex;
    align-items: center;
    gap: calc(14 * var(--dp));
  }
  .testi-window {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  .testi-track {
    display: flex;
    gap: calc(26 * var(--dp));
    will-change: transform;
  }

  /* Blue circular arrows, vertically centered on the line of the cards */
  .t-arrow {
    flex: none;
    width: calc(52 * var(--dp));
    height: calc(52 * var(--dp));
    border-radius: 50%;
    border: calc(1.5 * var(--dp)) solid var(--blue);
    background: var(--paper);
    color: var(--blue);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }
  .t-arrow svg {
    width: calc(22 * var(--dp));
    height: calc(22 * var(--dp));
  }
  .t-arrow:hover {
    background: var(--blue);
    color: #fff;
    transform: scale(1.08);
  }
  .t-arrow:active {
    transform: scale(0.96);
  }

  /* Formato web do mockup: card largo e horizontal — foto (tile) à esquerda,
     citação e assinatura à direita, dois por tela. */
  .testi-card {
    flex: 0 0 calc((100% - calc(26 * var(--dp))) / 2);
    margin: 0;
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: var(--radius);
    padding: calc(26 * var(--dp));
    display: flex;
    align-items: center;
    gap: calc(22 * var(--dp));
    box-shadow: var(--shadow-sm);
  }
  blockquote {
    margin: 0;
    font-size: calc(16 * var(--dp));
    color: var(--ink);
    line-height: 1.55;
  }
  .avatar {
    width: calc(132 * var(--dp));
    align-self: stretch;
    min-height: calc(120 * var(--dp));
    flex: none;
    display: grid;
    place-items: center;
    border-radius: calc(14 * var(--dp));
    background: var(--sky);
    color: var(--blue);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(27.2 * var(--dp));
  }
  .testi-card:nth-child(even) .avatar {
    background: var(--cream);
    color: var(--yellow-deep);
  }
  .testi-body {
    display: flex;
    flex-direction: column;
    gap: calc(14 * var(--dp));
    min-width: 0;
  }
  .who-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .name {
    font-weight: 700;
    color: var(--ink);
  }
  .role {
    font-size: calc(13.76 * var(--dp));
    color: var(--text-muted);
  }
  .note {
    margin-top: calc(26 * var(--dp));
    font-size: calc(13.12 * var(--dp));
    color: var(--text-muted);
    font-style: italic;
    text-align: center;
  }

  /* 1 per view on smaller screens */
  @media (max-width: 900px) {
    .testi-card {
      flex-basis: 100%;
    }
  }
</style>
