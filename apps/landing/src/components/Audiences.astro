---
import { Image } from "astro:assets";
import photoKids from "../assets/photos/student-beanbag.jpg";
import photoTeens from "../assets/photos/student-greenscreen.jpg";
import photoAdults from "../assets/photos/about-support.jpg";
import photoOnline from "../assets/photos/student-laptop.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const a = t.audiences;

// Fotos e ícones pareados por posição com `audiences.items` em todos os
// idiomas (mesma convenção do feature strip do hero).
const photos = [photoKids, photoTeens, photoAdults, photoOnline];
const icons = [
  // sparkles (kids)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/></svg>',
  // graduation-cap (teens)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/></svg>',
  // user (adults)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>',
  // laptop (online)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>',
];
---

<section class="section audiences" id="audiences">
  <div class="container">
    <h2 class="section-title">{a.titlePre}<span class="accent">{a.titleAccent}</span>{a.titlePost}</h2>
    <p class="aud-lead text-muted">{a.lead}</p>

    <div class="grid">
      {
        a.items.map((item, i) => (
          <article class="aud-card">
            <div class="aud-photo">
              <Image
                src={photos[i]}
                alt=""
                widths={[420, 640]}
                sizes="(max-width: 620px) 46vw, 24vw"
                format="webp"
                quality={72}
              />
              <span class="aud-icon" set:html={icons[i]} />
            </div>
            <div class="aud-body">
              <h3>{item.title}</h3>
              <p class="text-muted">{item.text}</p>
              <a class="aud-more" href={withLang(lang, item.href)}>
                {a.more}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .audiences {
    background: var(--paper);
  }
  .aud-lead {
    margin-top: calc(12 * var(--dp));
    font-size: calc(16.96 * var(--dp));
  }
  .grid {
    margin-top: calc(42 * var(--dp));
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(240 * var(--dp)), 1fr));
    gap: calc(24 * var(--dp));
  }
  .aud-card {
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: calc(16 * var(--dp));
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .aud-card:hover {
    transform: translateY(calc(-6 * var(--dp)));
    box-shadow: var(--shadow-md);
  }
  .aud-photo {
    position: relative;
  }
  /* :global porque o <img> sai do componente <Image>. brightness leve:
     as fotos são de escritório e ficavam pesadas ao lado do mockup. */
  .aud-photo :global(img) {
    width: 100%;
    height: calc(156 * var(--dp));
    object-fit: cover;
    /* Corte ancorado no alto: o cover centrado decapitava os rostos. */
    object-position: 50% 22%;
    display: block;
    filter: brightness(1.07) saturate(1.03);
  }
  .aud-icon {
    position: absolute;
    left: calc(20 * var(--dp));
    bottom: calc(-22 * var(--dp));
    width: calc(48 * var(--dp));
    height: calc(48 * var(--dp));
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    border: calc(3 * var(--dp)) solid var(--paper);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-sm);
  }
  .aud-icon :global(svg) {
    width: calc(22 * var(--dp));
    height: calc(22 * var(--dp));
  }
  .aud-body {
    padding: calc(34 * var(--dp)) calc(22 * var(--dp)) calc(24 * var(--dp));
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--dp));
    flex: 1;
  }
  .aud-body h3 {
    font-size: calc(19.2 * var(--dp));
  }
  .aud-body p {
    font-size: calc(15.2 * var(--dp));
    margin: 0;
  }
  .aud-more {
    margin-top: auto;
    padding-top: calc(10 * var(--dp));
    display: inline-flex;
    align-items: center;
    gap: calc(7 * var(--dp));
    font-weight: 700;
    font-size: calc(15.04 * var(--dp));
    color: var(--blue);
  }
  .aud-more svg {
    width: calc(16 * var(--dp));
    height: calc(16 * var(--dp));
    transition: transform 0.2s ease;
  }
  .aud-more:hover svg {
    transform: translateX(calc(4 * var(--dp)));
  }
  @media (prefers-reduced-motion: reduce) {
    .aud-more:hover svg {
      transform: none;
    }
  }

  /* Única troca de composição desta seção: no celular o desenho do dono põe
     as quatro portas em 2x2, não na fileira da vista web. É mudança de grade,
     não de tamanho — os tamanhos continuam saindo de --dp. */
  @media (max-width: 620px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
