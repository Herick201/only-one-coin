---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const w = t.why;

// Ícones (Lucide) por pilar, na mesma ordem de w.cards em todos os idiomas.
const icons = [
  // circle-dollar-sign (educación accesible)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>',
  // laptop (100% digital)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>',
  // user-check (docentes)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="8" r="4"/><path d="M3 21c0-4 3.1-6 7-6 1.2 0 2.3.2 3.3.6"/><path d="m16 19 2 2 4-4"/></svg>',
  // users (comunidad)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3.1-6 7-6s7 2 7 6"/><path d="M16 4a4 4 0 0 1 0 8"/><path d="M19 15.5c1.9.8 3 2.3 3 5.5"/></svg>',
  // star (oportunidades)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.7 5.9 6.3.7-4.7 4.3 1.3 6.1L12 16.9 6.4 20l1.3-6.1L3 9.6l6.3-.7L12 3Z"/></svg>',
];
---

<section class="section why" id="why">
  <div class="container why-grid">
    <div class="why-intro">
      <h2 class="section-title why-title">{w.titlePre}<span class="accent">{w.titleAccent}</span>{w.titlePost}</h2>
      <p class="text-muted">{w.lead}</p>
      <a href={withLang(lang, "/about")} class="btn btn-yellow why-cta">
        <span>{w.cta}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>

    <ul class="pillars">
      {
        w.cards.map((item, i) => (
          <li class="pillar">
            <span class="pillar-icon" set:html={icons[i]} />
            <h3>{item.title}</h3>
            <p class="text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    background: var(--sky-soft);
  }
  .why-grid {
    display: grid;
    grid-template-columns: minmax(calc(260 * var(--dp)), 0.9fr) 2fr;
    gap: calc(48 * var(--dp));
    align-items: center;
  }
  .why-title {
    text-align: left;
  }
  .why-intro p {
    margin-top: calc(14 * var(--dp));
    max-width: 34ch;
  }
  .why-cta {
    margin-top: calc(24 * var(--dp));
    display: inline-flex;
    align-items: center;
    gap: calc(9 * var(--dp));
  }
  .why-cta svg {
    width: calc(17 * var(--dp));
    height: calc(17 * var(--dp));
  }
  /* Formato web do mockup: pilares lado a lado com divisórias finas, ícones
     coloridos sem fundo, e uma divisória entre a introdução e os pilares. */
  .pillars {
    margin: 0;
    padding: 0 0 0 calc(40 * var(--dp));
    border-left: calc(1.5 * var(--dp)) solid var(--border);
    list-style: none;
    display: flex;
    align-items: stretch;
  }
  .pillar {
    flex: 1 1 0;
    text-align: center;
    padding-inline: calc(14 * var(--dp));
  }
  .pillar + .pillar {
    border-left: calc(1.5 * var(--dp)) solid var(--border);
  }
  .pillar-icon {
    display: grid;
    place-items: center;
    margin-bottom: calc(12 * var(--dp));
    color: var(--blue);
    transition: transform 0.18s ease;
  }
  .pillar:first-child .pillar-icon,
  .pillar:last-child .pillar-icon {
    color: var(--yellow-deep);
  }
  .pillar:nth-child(3) .pillar-icon {
    color: var(--blue-deep);
  }
  .pillar:hover .pillar-icon {
    transform: rotate(-6deg) scale(1.08);
  }
  .pillar-icon :global(svg) {
    width: calc(34 * var(--dp));
    height: calc(34 * var(--dp));
  }
  .pillar h3 {
    font-size: calc(15.68 * var(--dp));
    margin-bottom: calc(6 * var(--dp));
  }
  .pillar p {
    margin: 0;
    font-size: calc(13.6 * var(--dp));
    line-height: 1.45;
  }
  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: 1fr;
      gap: calc(36 * var(--dp));
    }
    .why-intro p {
      max-width: none;
    }
    .pillars {
      padding-left: 0;
      border-left: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(calc(140 * var(--dp)), 1fr));
      gap: calc(26 * var(--dp)) calc(12 * var(--dp));
    }
    .pillar + .pillar {
      border-left: 0;
    }
  }
</style>
