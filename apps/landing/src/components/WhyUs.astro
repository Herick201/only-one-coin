---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const w = t.why;

// Ícones (Lucide) por card, na mesma ordem de w.cards. Não são conteúdo
// traduzível, por isso vivem aqui e não no dicionário i18n.
const icons = [
  // circle-dollar-sign (clases por S/1.00)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>',
  // graduation-cap (talleres gratuitos)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/><path d="M22 10v6"/></svg>',
  // award (certificado digital)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></svg>',
  // laptop (plataforma del alumno)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>',
  // lightbulb (enseñanza innovadora)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5a6 6 0 0 0-12 0c0 1.3.5 2.6 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>',
];
---

<section class="section why" id="nosotros">
  <div class="container">
    <p class="eyebrow">{w.eyebrow}</p>
    <h2 class="section-title">{w.titlePre}<span class="accent">{w.titleAccent}</span>{w.titlePost}</h2>

    <div class="cards">
      {
        w.cards.map((item, i) => (
          <article class="card">
            <div class="card-icon" set:html={icons[i]} />
            <h3>{item.title}</h3>
            <p class="text-muted">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--paper);
  }
  /* Flex (not auto-fit grid) so the 5th card never orphans: the last row
     centers whatever is left over, and it collapses cleanly on small screens. */
  .cards {
    margin-top: 46px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px;
    max-width: 1120px;
    margin-inline: auto;
  }
  .card {
    flex: 1 1 290px;
    max-width: 350px;
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 34px 30px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }
  .card-icon {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: var(--sky);
    color: var(--blue);
    margin-bottom: 20px;
    transition: transform 0.18s ease;
  }
  .card:hover .card-icon {
    transform: rotate(-6deg) scale(1.05);
  }
  /* Alternate the accent so the row feels playful */
  .card:nth-child(even) .card-icon {
    background: var(--cream);
    color: var(--yellow-deep);
  }
  .card-icon :global(svg) {
    width: 30px;
    height: 30px;
  }
  .card h3 {
    font-size: 1.28rem;
    margin-bottom: 10px;
  }
  @media (max-width: 560px) {
    .card {
      flex-basis: 100%;
      max-width: 420px;
    }
  }
</style>
