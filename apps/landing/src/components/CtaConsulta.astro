---
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.cta;
---

<section class="cta">
  <div class="container">
    <div class="cta-card">
      <span class="blob cta-blob-a" aria-hidden="true"></span>
      <span class="blob cta-blob-b" aria-hidden="true"></span>
      <div class="cta-inner">
        <div>
          <h2 class="cta-title">{c.titlePre}<span class="accent">{c.titleAccent}</span>{c.titlePost}</h2>
          <p>{c.text}</p>
        </div>
        <a href={withLang(lang, "/contacto")} class="btn btn-yellow">{c.button}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: 20px 92px;
  }
  .cta-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    border-radius: var(--radius-lg);
    padding: 56px 52px;
    box-shadow: var(--shadow-blue);
  }
  .cta-blob-a {
    width: 240px;
    height: 240px;
    top: -110px;
    right: 8%;
    background: var(--yellow);
    opacity: 0.35;
  }
  .cta-blob-b {
    width: 180px;
    height: 180px;
    bottom: -100px;
    left: -40px;
    background: #fff;
    opacity: 0.14;
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .cta-title {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    color: #fff;
  }
  .cta-title .accent {
    color: var(--yellow-bright);
  }
  .cta p {
    margin-top: 12px;
    max-width: 560px;
    color: rgba(255, 255, 255, 0.85);
  }
</style>
