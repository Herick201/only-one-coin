---
import type { CourseSlug } from "../i18n/ui";
import { audienceAnchors, courseParent, coursePrices, htmlLang, levelsOf, monthlyPrices, whatsappUrl } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang, formatPEN } from "../i18n/utils";
import { courseIdBySlug, enrollmentHref } from "../data/checkout";
import { courseContent } from "../i18n/courses-content";

interface Props {
  slug: CourseSlug;
}

const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = t.courseDetail;
const name = t.courses.list[slug];
const rawPrice = coursePrices[slug];
const price = rawPrice === null ? null : formatPEN(rawPrice, lang);
// Mensual só existe para inglês (CLAUDE.md §1, decisão 02/09/2026) — nos
// demais cursos o bloco de modalidades nem aparece.
const rawMonthly = monthlyPrices[slug] ?? null;
const monthly = rawMonthly === null ? null : formatPEN(rawMonthly, lang);
// Matrícula desta página já cai no checkout com ESTE curso escolhido.
// Programa real deste curso, quando a coordenação já entregou o documento.
// Sem ele a página segue no texto genérico, com o aviso de exemplo.
const program = courseContent[lang][slug] ?? null;
// Malha detalhada (temas por unidade) só existe nos cursos cujo documento
// oficial já chegou; os demais mostram a lista simples de unidades.
const hasTopics = (program?.curriculum ?? []).some((unit) => unit.topics.length > 0);

// Idioma e seus níveis. A página de um idioma lista os níveis dela; a página
// de um nível oferece o caminho de volta ao idioma.
const parentSlug = courseParent[slug] ?? null;
const familyRoot = parentSlug ?? slug;
const siblings = [familyRoot, ...levelsOf(familyRoot)];
const levels =
  siblings.length > 1
    ? siblings.map((levelSlug) => ({
        slug: levelSlug,
        name: t.courses.list[levelSlug],
        href: withLang(lang, `/courses/${levelSlug}`),
        level: courseContent[lang][levelSlug]?.level ?? null,
        sessions: courseContent[lang][levelSlug]?.sessions ?? null,
        // O que se vê no nível: os títulos das unidades, que é o que a pessoa
        // quer comparar entre um nível e outro. O detalhe fica na malha.
        units: (courseContent[lang][levelSlug]?.curriculum ?? []).map((u) => u.title),
        enrollHref: enrollmentHref(withLang(lang, "/enrollment"), {
          courseId: courseIdBySlug[levelSlug],
          content: "course_level",
        }),
        price:
          coursePrices[levelSlug] === null
            ? null
            : formatPEN(coursePrices[levelSlug] as number, lang),
        current: levelSlug === slug,
      }))
    : [];

const enrollHref = enrollmentHref(withLang(lang, "/enrollment"), {
  courseId: courseIdBySlug[slug],
  content: "course_page",
});

// Icons per feature (Lucide) — decorative, not translatable content.
const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>',
];

// Course structured data: name, provider and the single-payment price, so the
// course pages are eligible for rich results instead of being a plain page.
const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: `${d.eyebrowPre}${name}${d.eyebrowPost}`.trim(),
  // A descrição real do programa quando existe; o texto genérico como reserva.
  description: program?.description?.join(" ") ?? `${d.leadPre}${name}${d.leadPost}`,
  inLanguage: htmlLang[lang],
  url: new URL(withLang(lang, `/courses/${slug}`), Astro.site).href,
  provider: {
    "@type": "EducationalOrganization",
    name: "Only One Coin Perú",
    legalName: "Asociación Only One Coin Perú",
    url: new URL("/", Astro.site).href,
  },
  isAccessibleForFree: false,
  // Classes are always online — no campus a student attends. `courseWorkload`
  // stays out until the real period data (hours per week) exists.
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "Online",
    inLanguage: htmlLang[lang],
  },
  offers: [
    {
      "@type": "Offer",
      category: "Paid",
      price: (rawPrice ?? 0).toFixed(2),
      priceCurrency: "PEN",
      availability: "https://schema.org/InStock",
    },
    ...(rawMonthly !== null
      ? [
          {
            "@type": "Offer",
            category: "Paid",
            price: rawMonthly.toFixed(2),
            priceCurrency: "PEN",
            availability: "https://schema.org/InStock",
          },
        ]
      : []),
  ],
};
---

<article class="course">
  <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} is:inline />
  <div class="container">
    <a
      class="back"
      href={parentSlug ? withLang(lang, `/courses/${parentSlug}`) : withLang(lang, "/courses")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      {parentSlug ? `${d.parentBack} ${t.courses.list[parentSlug]}` : d.backToCourses}
    </a>

    <header class="course-head">
      {/* Urgência que corresponde a um fato: a turma tem capacidade e a vaga
          acaba (`CLAUDE.md` §5).

          A etiqueta de desconto ao lado É uma etiqueta: bico à esquerda e furo,
          como a que vem pendurada na roupa. Vermelha porque é a cor que o mundo
          inteiro lê como desconto — a única coisa fora da paleta da marca nesta
          página, e de propósito. Só em inglés, por decisão do dono
          (o preço do plano segue sendo o vigente, `CLAUDE.md` §1). */}
      <p class="badges">
        <span class="urgency">{d.urgency}</span>
      </p>
      <h1>
        {d.titlePre}
        <span class="accent name-wrap">
          {name}
          {slug === "english" && (
            <span class="discount">
              <span class="tag-string" aria-hidden="true" />
              <span class="discount-amount">{d.discountAmount}</span>
              <span class="discount-label">{d.discountLabel}</span>
            </span>
          )}
        </span>
        {d.titlePost}
      </h1>
      {program ? (
        <div class="pitch">
          {program.sessions && (
            <p class="pitch-lead">
              <strong>{program.sessions}</strong> <span>{d.liveClasses}</span>
            </p>
          )}
          <ul class="perks">
            <li>{d.perkTeacher}</li>
            <li>{d.perkSchedule}</li>
            <li>{d.perkIncludes}</li>
          </ul>
          {(program.description ?? []).map((paragraph) => (
            <p class="lead-more text-muted">{paragraph}</p>
          ))}
        </div>
      ) : (
        <p class="lead text-muted">{d.leadPre}{name}{d.leadPost}</p>
      )}

      {/* O que a página grita é o sol por sessão; o total do paquete continua
          logo abaixo, menor — quem decide precisa dele à vista. */}
      {/* Renderização condicional, não `hidden`: o atributo perde para o
          `display: flex` da regra e o bloco reaparecia num curso sem preço. */}
      {price && (
        <p class="price-hook">
          <span class="hook-pre">{d.priceHookPre}</span>
          <span class="hook-amount">
            {t.hero.price}<span class="hook-unit">{t.hero.priceUnit}</span>
          </span>
        </p>
      )}
      {/* O total do paquete, sempre à vista do gancho de S/1: o gancho vem da
          modalidade mensual, e ninguém decide sem ver o valor cheio (ui.ts,
          nota sobre coursePrices). */}
      {price && (
        <p class="price-tag">
          <span class="price-tag-label">{d.priceLabel}</span>
          <span class="price-tag-amount">{price}</span>
        </p>
      )}
      {/* Duração, nível e modalidade: o que a pessoa procura antes de ler
          qualquer parágrafo. Só o campo que o documento do curso já fechou. */}
      {program && (program.duration || program.level || program.modality) && (
        <dl class="facts">
          {program.duration && (
            <div>
              <dt>{d.factDuration}</dt>
              <dd>{program.duration}</dd>
            </div>
          )}
          {program.level && (
            <div>
              <dt>{d.factLevel}</dt>
              <dd>{program.level}</dd>
            </div>
          )}
          {program.modality && (
            <div>
              <dt>{d.factModality}</dt>
              <dd>{program.modality}</dd>
            </div>
          )}
        </dl>
      )}
      {!program && <p class="example-note">{d.exampleNote}</p>}
    </header>

    {/* Mensual × paquete completo, lado a lado — só onde a modalidade mensal
        existe. O completo leva o destaque: é o que carrega os talleres. */}
    {monthly && price && (
      <section class="block">
        <h2 class="block-title">{d.paymentTitle}</h2>
        <p class="block-lead text-muted">{d.paymentLead}</p>
        <div class="pay-options">
          <article class="pay-card">
            <h3>{d.paymentMonthlyName}</h3>
            <p class="pay-price">
              {monthly} <span class="pay-unit">{d.paymentMonthlyUnit}</span>
            </p>
            <p class="pay-desc text-muted">{d.paymentMonthlyDesc}</p>
          </article>
          <article class="pay-card pay-card-full">
            <h3>{d.paymentFullName}</h3>
            <p class="pay-price">
              {price} <span class="pay-unit">{d.paymentFullUnit}</span>
            </p>
            <p class="pay-desc text-muted">{d.paymentFullDesc}</p>
          </article>
        </div>
      </section>
    )}

    {/* Idioma com um nível só não precisa de comparação: mostra direto o que
        se estuda. Com dois ou mais, a comparação É a seção. */}
    {/* Com o documento oficial em mãos, a malha vira cards de unidade com os
        temas; sem ele, segue a lista simples de títulos. */}
    {levels.length === 0 && program && program.curriculum.length > 0 && (
      <section class="block">
        <h2 class="block-title">{d.curriculumTitle}</h2>
        {hasTopics ? (
          <div class="units">
            {program.curriculum.map((unit) => (
              <div class="unit">
                <h3>{unit.title}</h3>
                <ul>
                  {unit.topics.map((topic) => <li>{topic}</li>)}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <ul class="level-units single-units">
            {program.curriculum.map((unit) => <li>{unit.title}</li>)}
          </ul>
        )}
      </section>
    )}

    {levels.length > 0 && (
      <section class="block">
        <h2 class="block-title">{d.levelsTitle}</h2>
        <p class="block-lead text-muted">{d.levelsLead}</p>
        <div class="levels">
          {levels.map((level) => (
            <article class={level.current ? "level level-current" : "level"}>
              <header class="level-head">
                <h3>{level.name}</h3>
                <p class="level-meta text-muted">
                  {[level.level, level.sessions].filter(Boolean).join(" · ")}
                </p>
                {level.price && <p class="level-price">{level.price}</p>}
              </header>
              {level.units.length > 0 && (
                <ul class="level-units">
                  {level.units.map((unit) => <li>{unit}</li>)}
                </ul>
              )}
              <a class="btn btn-yellow level-cta" href={level.enrollHref}>
                {t.hero.ctaEnroll}
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    {/* Num idioma com vários níveis, a comparação acima decide ONDE entrar; a
        malha abaixo detalha O QUE se estuda no nível desta página. */}
    {levels.length > 0 && program && hasTopics && (
      <section class="block">
        <h2 class="block-title">{d.curriculumTitle}</h2>
        <div class="units">
          {program.curriculum.map((unit) => (
            <div class="unit">
              <h3>{unit.title}</h3>
              <ul>
                {unit.topics.map((topic) => <li>{topic}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* O syllabus em três cards curtos — competências, método e avaliação —
        em vez de três seções empilhadas que ninguém rola até o fim. */}
    {program && (program.goals || program.method || program.evaluation) && (
      <section class="block">
        <div class="units">
          {program.goals && (
            <div class="unit">
              <h3>{d.goalsTitle}</h3>
              <ul>
                {program.goals.map((goal) => <li>{goal}</li>)}
              </ul>
            </div>
          )}
          {program.method && (
            <div class="unit">
              <h3>{d.methodTitle}</h3>
              <ul>
                {program.method.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}
          {program.evaluation && (
            <div class="unit">
              <h3>{d.evaluationTitle}</h3>
              <ul>
                {program.evaluation.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {/* O fechamento que vende: o que a pessoa vai conseguir fazer — seguido
        da ressalva honesta do programa, quando o documento traz uma. */}
    {program?.outcomes && (
      <section class="block">
        <h2 class="block-title">{d.outcomesTitle}</h2>
        <ul class="ticks two-up">
          {program.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
        {program.outcomeNote && <p class="outcome-note">{program.outcomeNote}</p>}
      </section>
    )}

    {/* A matrícula fica na parte branca, no meio da página: é onde a pessoa
        acabou de ler o que o curso inclui. O bloco azul do fim é para quem
        ainda tem dúvida, e dúvida se resolve no WhatsApp. */}
    <section class="enroll-band">
      <a class="btn btn-yellow enroll-cta" href={enrollHref}>{t.hero.ctaEnroll}</a>
      <p class="enroll-note text-muted">{d.urgency}</p>
    </section>

    <section class="course-cta">
      <div>
        <h2>{d.ctaTitle}</h2>
        <p>{d.ctaText}</p>
      </div>
      <div class="course-cta-actions">
        <a class="btn btn-ghost-blue" href={whatsappUrl} target="_blank" rel="noopener">{d.ctaWhatsApp}</a>
      </div>
    </section>
  </div>
</article>

<style>
  .course {
    padding-block: 48px 88px;
    background:
      radial-gradient(50% 60% at 90% 0%, rgba(255, 201, 60, 0.14), transparent 60%),
      var(--sky-soft);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 26px;
  }
  .back svg {
    width: 18px;
    height: 18px;
    transition: transform 0.16s ease;
  }
  .back:hover svg {
    transform: translateX(-3px);
  }
  .course-head {
    max-width: 720px;
  }
  .enroll-band {
    margin-top: 62px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .enroll-cta {
    font-size: 1.18rem;
    padding: 20px 52px;
  }
  .enroll-note {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
  }
  /* Etiqueta de preço, a de pendurar: bico à esquerda, furo do barbante e o
     pontilhado costurado por dentro — colada meio torta, como na vitrine.
     Tudo em CSS: acompanha o texto em qualquer idioma, sem virar imagem. */
  /* Âncora da etiqueta: o fim da palavra, não uma distância fixa — "Inglés",
     "English" e "Inglês" têm larguras diferentes. */
  .name-wrap {
    position: relative;
    display: inline-block;
  }
  /* O barbante, saindo da última letra até o furo da etiqueta. */
  .tag-string {
    position: absolute;
    left: -15px;
    top: 50%;
    width: 17px;
    height: 2px;
    background: #c9101f;
    transform: rotate(12deg);
    border-radius: 2px;
  }
  .discount {
    position: absolute;
    left: calc(100% + 16px);
    top: 26%;
    /* A etiqueta nunca quebra em duas linhas: ela é um objeto, não um
       parágrafo — e o título é grande demais para ela crescer em altura. */
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 24px 13px 46px;
    background: linear-gradient(145deg, #ee2a36, #c9101f);
    color: #fff;
    transform: rotate(-7deg);
    clip-path: polygon(0% 50%, 24px 0%, 100% 0%, 100% 100%, 24px 100%);
    z-index: 1;
    filter: drop-shadow(0 8px 14px rgba(201, 16, 31, 0.34));
  }
  /* Furo do barbante. Pintado da cor do fundo da seção: clip-path já recortou
     a peça, e não dá para recortar de novo por dentro. */
  .discount::before {
    content: "";
    position: absolute;
    left: 28px;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sky-soft);
    transform: translateY(-50%);
  }
  /* A costura pontilhada, afastada da borda como na etiqueta de verdade. */
  .discount::after {
    content: "";
    position: absolute;
    inset: 5px 7px 5px 42px;
    border: 2px dashed rgba(255, 255, 255, 0.7);
    border-radius: 5px;
    pointer-events: none;
  }
  .discount-amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .discount-label {
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* Sem largura para pendurar ao lado, a etiqueta desce e vira um selo comum:
     melhor abaixo do título do que empurrando a página para o lado. */
  @media (max-width: 700px) {
    .name-wrap {
      display: inline;
    }
    .discount {
      position: static;
      margin-top: 14px;
      transform: rotate(-3deg);
    }
    .tag-string {
      display: none;
    }
  }
  .price-hook {
    margin-top: 24px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hook-pre {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    font-weight: 600;
    color: var(--ink);
  }
  .hook-amount {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow));
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1;
    padding: 10px 24px;
    border-radius: 18px;
    box-shadow: var(--shadow-yellow);
  }
  .hook-unit {
    font-family: var(--font);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .urgency {
    display: inline-flex;
    align-items: center;
    padding: 8px 18px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow));
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: var(--shadow-yellow);
  }
  .course-head h1 {
    margin-top: 10px;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
  }
  .course-head h1 .accent {
    color: var(--blue);
  }
  .lead {
    margin-top: 18px;
    font-size: 1.15rem;
  }
  .price-tag {
    margin-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .price-tag-label {
    font-weight: 600;
    color: var(--text-muted);
  }
  .price-tag-amount {
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow-deep));
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    padding: 4px 18px;
    border-radius: 12px;
    box-shadow: var(--shadow-yellow);
  }
  /* As quatro coisas que decidem a matrícula: quantas clases, que son en
     vivo, cuándo, y qué viene incluido. O resto do programa está mais abaixo
     para quem quiser — aqui em cima não cabe um texto. */
  .pitch {
    margin-top: 20px;
  }
  .pitch-lead {
    margin: 0 0 16px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--font-display);
    line-height: 1.05;
  }
  .pitch-lead strong {
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    font-weight: 700;
    color: var(--blue);
  }
  .pitch-lead span {
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 600;
    color: var(--ink);
  }
  .perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    max-width: 62ch;
  }
  .perks li {
    position: relative;
    padding-left: 30px;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text);
  }
  .perks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 16px;
    height: 9px;
    border-left: 3px solid var(--yellow-deep);
    border-bottom: 3px solid var(--yellow-deep);
    transform: rotate(-45deg);
  }
  .lead-more {
    margin-top: 12px;
    max-width: 72ch;
  }
  /* Duração, nível e modalidade: os três números que a pessoa procura antes de
     ler qualquer outra coisa. */
  .facts {
    margin: 26px 0 0;
