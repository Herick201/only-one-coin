---
import type { CourseSlug } from "../i18n/ui";
import { audienceAnchors, courseParent, coursePrices, htmlLang, levelsOf, monthlyPrices, whatsappUrl } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang, formatPEN } from "../i18n/utils";
import { courseIdBySlug, enrollmentHref } from "../data/checkout";
import { courseContent } from "../i18n/courses-content";
import CourseProgramDetail from "./CourseProgramDetail.astro";

interface Props {
  slug: CourseSlug;
}

const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = t.courseDetail;
const name = t.courses.list[slug];
const rawPrice = coursePrices[slug];
const price = rawPrice === null ? null : formatPEN(rawPrice, lang);
// Mensual só existe para inglês (CLAUDE.md §1, decisão 02/09/2026) — entra
// no painel do nível e na oferta do JSON-LD; nos demais cursos nem aparece.
const rawMonthly = monthlyPrices[slug] ?? null;
// Matrícula desta página já cai no checkout com ESTE curso escolhido.
// Programa real deste curso, quando a coordenação já entregou o documento.
// Sem ele a página segue no texto genérico, com o aviso de exemplo.
const program = courseContent[lang][slug] ?? null;

// Idioma e seus níveis. A página de um idioma vira o hub da família: um
// seletor de níveis em quadradinhos, e UM painel de detalhe que troca com a
// seleção — sem navegar, sem recarregar. A página de um nível renderiza o
// mesmo hub com o próprio nível pré-selecionado, então o deep link continua
// caindo no lugar certo.
const parentSlug = courseParent[slug] ?? null;
const familyRoot = parentSlug ?? slug;
const siblings = [familyRoot, ...levelsOf(familyRoot)];
const isFamilyPage = siblings.length > 1;
const levelPanels = isFamilyPage
  ? siblings.map((levelSlug) => {
      return {
        slug: levelSlug,
        name: t.courses.list[levelSlug],
        shortName: d.levelShortNames[levelSlug] ?? t.courses.list[levelSlug],
        highlights: d.levelHighlights[levelSlug] ?? [],
        program: courseContent[lang][levelSlug] ?? null,
        // O hub não mostra valores (pedido do dono, 03/09/2026) — mensal aqui
        // é só o gatilho das pílulas de modalidade no painel.
        hasMonthly: (monthlyPrices[levelSlug] ?? null) !== null,
        enrollHref: enrollmentHref(withLang(lang, "/enrollment"), {
          courseId: courseIdBySlug[levelSlug],
          content: "course_page",
        }),
        current: levelSlug === slug,
      };
    })
  : [];

// A troca de painel é CSS puro (radio + irmãos) — esta página não carrega
// JavaScript e continua assim. As regras dependem do id de cada nível, então
// nascem aqui e entram numa <style> própria; o visual mora na <style> scoped.
const levelTabsCss = levelPanels
  .map(
    (p) => `
#level-${p.slug}:checked ~ .level-panels > #panel-${p.slug} { display: block; }
#level-${p.slug}:checked ~ .tab-row > [for="level-${p.slug}"] {
  border-color: var(--blue);
  background: var(--sky);
  box-shadow: var(--shadow-blue);
}
#level-${p.slug}:checked ~ .tab-row > [for="level-${p.slug}"] .tab-icon {
  background: var(--paper);
}
#level-${p.slug}:focus-visible ~ .tab-row > [for="level-${p.slug}"] {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}`,
  )
  .join("\n");

const enrollHref = enrollmentHref(withLang(lang, "/enrollment"), {
  courseId: courseIdBySlug[slug],
  content: "course_page",
});

// Icon per level square (Lucide) — decorative, not translatable content:
// a broto pro começo do zero, a subida pro nível seguinte, medalha e troféu
// pras certificações. Nível fora do mapa cai no livro aberto.
const levelIcons: Partial<Record<CourseSlug, string>> = {
  "english":
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-3.7.3-4.9 1.4-4.9 2z"/></svg>',
  "english-intermediate":
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
  "cambridge-b1":
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>',
  "cambridge-b2":
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>',
};
const defaultLevelIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>';

// Icons per feature (Lucide) — decorative, not translatable content.
const featureIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2.5 9 2.5 12 0v-5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>',
];

// Course structured data: name, provider and the single-payment price, so the
// course pages are eligible for rich results instead of being a plain page.
const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: `${d.eyebrowPre}${name}${d.eyebrowPost}`.trim(),
  // A descrição real do programa quando existe; o texto genérico como reserva.
  description: program?.description?.join(" ") ?? `${d.leadPre}${name}${d.leadPost}`,
  inLanguage: htmlLang[lang],
  url: new URL(withLang(lang, `/courses/${slug}`), Astro.site).href,
  provider: {
    "@type": "EducationalOrganization",
    name: "Only One Coin Perú",
    legalName: "Asociación Only One Coin Perú",
    url: new URL("/", Astro.site).href,
  },
  isAccessibleForFree: false,
  // Classes are always online — no campus a student attends. `courseWorkload`
  // stays out until the real period data (hours per week) exists.
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "Online",
    inLanguage: htmlLang[lang],
  },
  offers: [
    {
      "@type": "Offer",
      category: "Paid",
      price: (rawPrice ?? 0).toFixed(2),
      priceCurrency: "PEN",
      availability: "https://schema.org/InStock",
    },
    ...(rawMonthly !== null
      ? [
          {
            "@type": "Offer",
            category: "Paid",
            price: rawMonthly.toFixed(2),
            priceCurrency: "PEN",
            availability: "https://schema.org/InStock",
          },
        ]
      : []),
  ],
};
---

<article class="course">
  <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} is:inline />
  <div class="container">
    <a
      class="back"
      href={parentSlug ? withLang(lang, `/courses/${parentSlug}`) : withLang(lang, "/courses")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      {parentSlug ? `${d.parentBack} ${t.courses.list[parentSlug]}` : d.backToCourses}
    </a>

    <header class="course-head">
      {/* Urgência que corresponde a um fato: a turma tem capacidade e a vaga
          acaba (`CLAUDE.md` §5).

          A etiqueta de desconto ao lado É uma etiqueta: bico à esquerda e furo,
          como a que vem pendurada na roupa. Vermelha porque é a cor que o mundo
          inteiro lê como desconto — a única coisa fora da paleta da marca nesta
          página, e de propósito. Só em inglés, por decisão do dono
          (o preço do plano segue sendo o vigente, `CLAUDE.md` §1). */}
      <p class="badges">
        <span class="urgency">{d.urgency}</span>
      </p>
      <h1>
        {d.titlePre}
        <span class="accent name-wrap">
          {name}
          {slug === "english" && (
            <span class="discount">
              <span class="tag-string" aria-hidden="true" />
              <span class="discount-amount">{d.discountAmount}</span>
              <span class="discount-label">{d.discountLabel}</span>
            </span>
          )}
        </span>
        {d.titlePost}
      </h1>
      {/* Página de família fala do idioma inteiro: as sessões e os facts são
          de UM nível e moram no painel dele, logo abaixo. */}
      {program || isFamilyPage ? (
        <div class="pitch">
          {program?.sessions && !isFamilyPage && (
            <p class="pitch-lead">
              <strong>{program.sessions}</strong> <span>{d.liveClasses}</span>
            </p>
          )}
          <ul class="perks">
            <li>{d.perkTeacher}</li>
            <li>{d.perkSchedule}</li>
            <li>{d.perkIncludes}</li>
          </ul>
        </div>
      ) : (
        <p class="lead text-muted">{d.leadPre}{name}{d.leadPost}</p>
      )}

      {/* O que a página grita é o sol por sessão; o total do paquete continua
          logo abaixo, menor — quem decide precisa dele à vista. */}
      {/* Renderização condicional, não `hidden`: o atributo perde para o
          `display: flex` da regra e o bloco reaparecia num curso sem preço. */}
      {price && (
        <p class="price-hook">
          <span class="hook-pre">{d.priceHookPre}</span>
          <span class="hook-amount">
            {t.hero.price}<span class="hook-unit">{t.hero.priceUnit}</span>
          </span>
        </p>
      )}
      {/* Duração, nível e modalidade: o que a pessoa procura antes de ler
          qualquer parágrafo. Só o campo que o documento do curso já fechou —
          e só fora do hub de família, onde isso é informação de painel. */}
      {program && !isFamilyPage && (program.duration || program.level || program.modality) && (
        <dl class="facts">
          {program.duration && (
            <div>
              <dt>{d.factDuration}</dt>
              <dd>{program.duration}</dd>
            </div>
          )}
          {program.level && (
            <div>
              <dt>{d.factLevel}</dt>
              <dd>{program.level}</dd>
            </div>
          )}
          {program.modality && (
            <div>
              <dt>{d.factModality}</dt>
              <dd>{program.modality}</dd>
            </div>
          )}
        </dl>
      )}
      {!program && <p class="example-note">{d.exampleNote}</p>}
    </header>

    {/* O hub de níveis: quadradinhos em cima, UM painel embaixo. Clicar num
        nível troca só o painel — radio + CSS, sem JavaScript e sem recarregar.
        O painel carrega o essencial (3–4 checks, preço, matrícula) e o
        programa inteiro fica atrás do "Ver detalles" dele. */}
    {isFamilyPage && (
      <section class="block block-center level-tabs">
        <h2 class="block-title">{d.levelsTitle}</h2>
        {levelPanels.map((p) => (
          <input
            class="level-radio"
            type="radio"
            name="level-tab"
            id={`level-${p.slug}`}
            checked={p.current}
            aria-label={p.name}
          />
        ))}
        <div class="tab-row">
          {levelPanels.map((p) => (
            <label class="tab-square" for={`level-${p.slug}`}>
              <span class="tab-icon" set:html={levelIcons[p.slug] ?? defaultLevelIcon} />
              <span class="tab-name">{p.shortName}</span>
            </label>
          ))}
        </div>
        <div class="level-panels">
          {levelPanels.map((p) => (
            <article class="level-panel" id={`panel-${p.slug}`}>
              {/* O nome curto basta: o idioma já está no título da página, e
                  "Inglés" sozinho aqui voltaria a ser ambíguo ao lado de
                  "Intermedio/Avanzado". */}
              <h3 class="panel-title">{p.shortName}</h3>
              {p.highlights.length > 0 && (
                <ul class="ticks panel-ticks">
                  {p.highlights.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {/* As duas modalidades, sem valores — o preço já mora no
                  quadradinho do nível. O paquete leva o selo: é o que carrega
                  os talleres. Só aparece onde a escolha existe (mensual). */}
              {p.hasMonthly && (
                <div class="panel-options">
                  <span class="panel-option">{d.paymentMonthlyName}</span>
                  {/* A recomendação é a estrela em cima da pílula; a palavra
                      fica só para leitor de tela. */}
                  <span class="panel-option panel-option-full">
                    <svg class="panel-option-star" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.9 6.26 6.6.72-4.9 4.55 1.34 6.47L12 16.77 6.06 20l1.34-6.47L2.5 8.98l6.6-.72L12 2z"/></svg>
                    {d.paymentFullName}
                    <span class="visually-hidden">{d.paymentRecommended}</span>
                  </span>
                </div>
              )}
              <a class="btn btn-yellow panel-enroll" href={p.enrollHref}>{t.hero.ctaEnroll}</a>
              {p.program && (
                <details class="program-toggle panel-toggle">
                  <summary>{d.detailsToggle}</summary>
                  <CourseProgramDetail program={p.program} includeOutcomes />
                </details>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
    {isFamilyPage && <style set:html={levelTabsCss} is:inline />}

    {/* A matrícula antes do detalhe do programa: quem já viu preço e níveis
        decide aqui. No hub de família cada painel tem o próprio botão, então
        a faixa duplicaria o CTA. */}
    {!isFamilyPage && (
      <section class="enroll-band">
        <a class="btn btn-yellow enroll-cta" href={enrollHref}>{t.hero.ctaEnroll}</a>
        <p class="enroll-note text-muted">{d.urgency}</p>
      </section>
    )}

    {/* Todo o detalhe do programa atrás de um único "Ver detalles",
        centralizado. No hub de família o toggle mora dentro de cada painel
        de nível — aqui só a versão de curso sem níveis. */}
    {!isFamilyPage && program &&
      (program.curriculum.length > 0 ||
        program.goals ||
        program.method ||
        program.evaluation ||
        (program.description ?? []).length > 0) && (
      <section class="block block-center">
        <h2 class="block-title">{d.programTitle}</h2>
        <details class="program-toggle">
          <summary>{d.detailsToggle}</summary>
          <CourseProgramDetail program={program} />
        </details>
      </section>
    )}

    {/* O fechamento que vende: o que a pessoa vai conseguir fazer — seguido
        da ressalva honesta do programa, quando o documento traz uma. No hub
        de família isso vive dentro do "Ver detalles" de cada painel. */}
    {!isFamilyPage && program?.outcomes && (
      <section class="block">
        <h2 class="block-title">{d.outcomesTitle}</h2>
        <ul class="ticks two-up">
          {program.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
        {program.outcomeNote && <p class="outcome-note">{program.outcomeNote}</p>}
      </section>
    )}

    <section class="course-cta">
      <span class="blob course-cta-blob-a" aria-hidden="true"></span>
      <span class="blob course-cta-blob-b" aria-hidden="true"></span>
      <div class="course-cta-inner">
        <div>
          <h2>{d.ctaTitlePre}<span class="accent">{d.ctaTitleAccent}</span>{d.ctaTitlePost}</h2>
          <p>{d.ctaText}</p>
        </div>
        <div class="course-cta-actions">
          <a class="btn btn-yellow" href={whatsappUrl} target="_blank" rel="noopener">{d.ctaWhatsApp}</a>
        </div>
      </div>
    </section>
  </div>
</article>

<style>
  .course {
    padding-block: 48px 88px;
    background:
      radial-gradient(50% 60% at 90% 0%, rgba(255, 201, 60, 0.14), transparent 60%),
      var(--sky-soft);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 26px;
  }
  .back svg {
    width: 18px;
    height: 18px;
    transition: transform 0.16s ease;
  }
  .back:hover svg {
    transform: translateX(-3px);
  }
  .course-head {
    max-width: 720px;
  }
  .enroll-band {
    margin-top: 62px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .enroll-cta {
    font-size: 1.18rem;
    padding: 20px 52px;
  }
  .enroll-note {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
  }
  /* Etiqueta de preço, a de pendurar: bico à esquerda, furo do barbante e o
     pontilhado costurado por dentro — colada meio torta, como na vitrine.
     Tudo em CSS: acompanha o texto em qualquer idioma, sem virar imagem. */
  /* Âncora da etiqueta: o fim da palavra, não uma distância fixa — "Inglés",
     "English" e "Inglês" têm larguras diferentes. */
  .name-wrap {
    position: relative;
    display: inline-block;
  }
  /* O barbante, saindo da última letra até o furo da etiqueta. */
  .tag-string {
    position: absolute;
    left: -15px;
    top: 50%;
    width: 17px;
    height: 2px;
    background: #c9101f;
    transform: rotate(12deg);
    border-radius: 2px;
  }
  .discount {
    position: absolute;
    left: calc(100% + 16px);
    top: 26%;
    /* A etiqueta nunca quebra em duas linhas: ela é um objeto, não um
       parágrafo — e o título é grande demais para ela crescer em altura. */
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 24px 13px 46px;
    background: linear-gradient(145deg, #ee2a36, #c9101f);
    color: #fff;
    transform: rotate(-7deg);
    clip-path: polygon(0% 50%, 24px 0%, 100% 0%, 100% 100%, 24px 100%);
    z-index: 1;
    filter: drop-shadow(0 8px 14px rgba(201, 16, 31, 0.34));
  }
  /* Furo do barbante. Pintado da cor do fundo da seção: clip-path já recortou
     a peça, e não dá para recortar de novo por dentro. */
  .discount::before {
    content: "";
    position: absolute;
    left: 28px;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sky-soft);
    transform: translateY(-50%);
  }
  /* A costura pontilhada, afastada da borda como na etiqueta de verdade. */
  .discount::after {
    content: "";
    position: absolute;
    inset: 5px 7px 5px 42px;
    border: 2px dashed rgba(255, 255, 255, 0.7);
    border-radius: 5px;
    pointer-events: none;
  }
  .discount-amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .discount-label {
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* Sem largura para pendurar ao lado, a etiqueta desce e vira um selo comum:
     melhor abaixo do título do que empurrando a página para o lado. */
  @media (max-width: 700px) {
    .name-wrap {
      display: inline;
    }
    .discount {
      position: static;
      margin-top: 14px;
      transform: rotate(-3deg);
    }
    .tag-string {
      display: none;
    }
  }
  .price-hook {
    margin-top: 24px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hook-pre {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    font-weight: 600;
    color: var(--ink);
  }
  .hook-amount {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow));
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1;
    padding: 10px 24px;
    border-radius: 18px;
    box-shadow: var(--shadow-yellow);
  }
  .hook-unit {
    font-family: var(--font);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .urgency {
    display: inline-flex;
    align-items: center;
    padding: 8px 18px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--yellow-bright), var(--yellow));
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9rem;
