---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const f = t.faq;
---

<section class="section faq" id="faq">
  <div class="container">
    <h1 class="section-title faq-title">{f.titlePre}<span class="accent">{f.titleAccent}</span>{f.titlePost}</h1>
    <p class="faq-lead text-muted">{f.lead}</p>

    <div class="faq-list">
      {
        f.items.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <svg class="faq-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--sky-soft);
  }
  .faq-title {
    text-align: center;
  }
  .faq-lead {
    margin: 16px auto 0;
    max-width: 60ch;
    text-align: center;
    font-size: 1.08rem;
  }
  .faq-list {
    margin-top: 40px;
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .faq-item {
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-plus {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--blue);
    transition: transform 0.22s ease;
  }
  .faq-item[open] .faq-plus {
    transform: rotate(45deg);
  }
  .faq-answer {
    margin: 0;
    padding: 0 24px 22px;
    color: var(--text-muted);
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-plus {
      transition: none;
    }
  }
</style>
