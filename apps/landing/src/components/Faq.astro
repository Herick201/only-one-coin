---
import { htmlLang, whatsappUrl } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const f = t.faq;

// FAQPage structured data, built from the very same items rendered below — the
// markup and the schema can never disagree, which is what Google checks for.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: htmlLang[lang],
  mainEntity: f.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section class="section faq" id="faq">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <div class="container">
    <h1 class="section-title faq-title">{f.titlePre}<span class="accent">{f.titleAccent}</span>{f.titlePost}</h1>
    <p class="faq-lead text-muted">{f.lead}</p>

    <div class="faq-list">
      {
        f.items.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <svg class="faq-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))
      }
    </div>

    <!-- Replaces the floating bubble on this page (Base `waFloat={false}`):
         one obvious way out of an unanswered question, not two. Same blue card
         as CtaConsulta, so it reads as the site's CTA and not a stray widget. -->
    <aside class="faq-cta">
      <span class="blob faq-cta-blob" aria-hidden="true"></span>
      <div class="faq-cta-inner">
        <div class="faq-cta-copy">
          <h2>{f.ctaTitle}</h2>
          <p>{f.ctaText}</p>
        </div>
        <a class="btn btn-yellow faq-cta-btn" href={whatsappUrl} target="_blank" rel="noopener">
          <svg width="19" height="19" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M16.004 0h-.008C7.174 0 0 7.176 0 16c0 3.5 1.13 6.744 3.05 9.38L1.05 31.3l6.13-1.96A15.9 15.9 0 0 0 16.004 32C24.826 32 32 24.822 32 16S24.826 0 16.004 0zm9.31 22.6c-.386 1.09-1.92 1.996-3.144 2.26-.836.178-1.928.32-5.604-1.204-4.7-1.948-7.726-6.724-7.962-7.034-.226-.31-1.9-2.53-1.9-4.826 0-2.296 1.166-3.42 1.636-3.9.386-.394.84-.573 1.318-.573.154 0 .293.008.418.014.386.016.58.04.834.646.316.76 1.086 2.656 1.178 2.84.094.184.188.436.062.744-.118.316-.222.436-.406.65-.184.214-.36.378-.544.606-.168.198-.358.41-.146.776.212.36.94 1.55 2.02 2.51 1.394 1.24 2.556 1.628 2.96 1.796.3.124.66.094.88-.14.28-.3.622-.798.97-1.29.246-.354.558-.398.88-.276.328.116 2.076.98 2.436 1.16.36.18.598.264.686.41.088.152.088.868-.298 1.958z"></path>
          </svg>
          <span>{f.ctaButton}</span>
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .faq {
    background: var(--sky-soft);
  }
  .faq-cta {
    position: relative;
    overflow: hidden;
    margin: 52px auto 0;
    max-width: 900px;
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-blue);
    padding: 40px 44px;
  }
  .faq-cta-blob {
    width: 220px;
    height: 220px;
    top: -110px;
    right: -60px;
    background: var(--yellow);
    opacity: 0.28;
  }
  /* Wraps when the row runs out of room, not when the window crosses a number. */
  .faq-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }
  .faq-cta-copy {
    flex: 1 1 300px;
  }
  .faq-cta h2 {
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    margin-bottom: 6px;
  }
  .faq-cta p {
    color: rgba(255, 255, 255, 0.86);
    max-width: 44ch;
  }
  .faq-cta-btn {
    flex: 0 0 auto;
  }
  .faq-title {
    text-align: center;
  }
  .faq-lead {
    margin: 16px auto 0;
    max-width: 60ch;
    text-align: center;
    font-size: 1.08rem;
  }
  .faq-list {
    margin-top: 40px;
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .faq-item {
    background: var(--paper);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-plus {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--blue);
    transition: transform 0.22s ease;
  }
  .faq-item[open] .faq-plus {
    transform: rotate(45deg);
  }
  .faq-answer {
    margin: 0;
    padding: 0 24px 22px;
    color: var(--text-muted);
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-plus {
      transition: none;
    }
  }

  /* Mobile: mesma página web, reduzida. */
  @media (max-width: 900px) {
    .faq-lead {
      margin-top: 8px;
      font-size: 0.9rem;
    }
    .faq-list {
      margin-top: 22px;
      gap: 9px;
    }
    .faq-item summary {
      padding: 13px 15px;
      gap: 10px;
    }
    .faq-answer {
      padding: 0 15px 14px;
      font-size: 0.82rem;
    }
    .faq-cta {
      margin-top: 28px;
      padding: 22px 20px;
    }
    .faq-cta-inner {
      flex-wrap: nowrap;
      gap: 14px;
    }
    .faq-cta-copy {
      flex: 1 1 0;
      min-width: 0;
    }
    .faq-cta p {
      font-size: 0.8rem;
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .faq-lead {
      margin-top: 5px;
      font-size: 0.62rem;
    }
    .faq-list {
      margin-top: 13px;
      gap: 5px;
    }
    .faq-item {
      border-radius: 9px;
      border-width: 1px;
    }
    /* Prosa não encolhe como um bloco de cards: a página de perguntas é uma
       coluna só no desktop também, então aqui a redução para no tamanho em
       que a resposta ainda se lê corrido. */
    .faq-item summary {
      padding: 10px 12px;
      gap: 8px;
      font-size: 0.74rem;
    }
    .faq-plus {
      width: 14px;
      height: 14px;
    }
    .faq-answer {
      padding: 0 12px 11px;
      font-size: 0.68rem;
      line-height: 1.55;
    }
    .faq-cta {
      margin-top: 17px;
      padding: 13px 12px;
      border-radius: 14px;
    }
    .faq-cta-inner {
      gap: 9px;
    }
    .faq-cta h2 {
      font-size: 0.78rem;
      margin-bottom: 3px;
    }
    .faq-cta p {
      font-size: 0.5rem;
    }
  }
</style>
