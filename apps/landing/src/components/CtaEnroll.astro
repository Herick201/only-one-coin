---
import { Image } from "astro:assets";
import ctaPhoto from "../assets/photos/about-online.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.cta;
---

<section class="cta">
  <div class="cta-photo">
    <Image
      src={ctaPhoto}
      alt={c.imgAlt}
      widths={[480, 768]}
      sizes="(max-width: 700px) 100vw, 320px"
      format="webp"
      quality={72}
    />
  </div>
  <div class="cta-inner">
    <div class="cta-copy">
      <h2 class="cta-title">{c.title}</h2>
      <p>{c.sub}</p>
    </div>
    <p class="cta-price">
      {c.pricePre} <strong>{c.price}</strong> {c.priceUnit}
    </p>
    <a href={withLang(lang, "/enrollment")} class="btn btn-yellow cta-btn">
      <span>{t.hero.ctaEnroll}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </a>
  </div>
</section>

<style>
  /* Formato web do mockup: faixa azul de borda a borda, colada no footer,
     com a foto sangrando na esquerda. */
  .cta {
    position: relative;
    overflow: hidden;
    background: linear-gradient(105deg, var(--blue-deep), var(--blue) 55%, var(--blue-deep));
    margin-top: 24px;
  }
  .cta-photo {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: min(24%, 320px);
  }
  /* :global porque o <img> sai do componente <Image> — o escopo do Astro
     não alcança elemento renderizado por componente filho. */
  .cta-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cta-photo::after {
    /* Funde a borda da foto no azul da faixa. */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 55%, rgba(27, 70, 201, 0.85));
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 36px;
    flex-wrap: wrap;
    padding-block: 34px;
    padding-left: max(calc(min(24%, 320px) + 44px), calc((100% - var(--maxw)) / 2 + 24px));
    padding-right: max(24px, calc((100% - var(--maxw)) / 2 + 24px));
  }
  .cta-copy {
    flex: 1 1 300px;
  }
  .cta-title {
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    color: #fff;
  }
  .cta-copy p {
    margin-top: 6px;
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-price {
    margin: 0;
    color: #fff;
    font-weight: 600;
    text-align: center;
    white-space: nowrap;
  }
  .cta-price strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.05;
    color: var(--yellow-bright);
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .cta-btn svg {
    width: 17px;
    height: 17px;
  }
  @media (max-width: 700px) {
    .cta-photo {
      display: none;
    }
    .cta-inner {
      padding: 30px 24px;
    }
  }
</style>
