---
import { Image } from "astro:assets";
import ctaPhoto from "../assets/photos/about-online.jpg";
import { getLangFromUrl, useTranslations, withLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.cta;
---

<section class="cta">
  <div class="container">
    <div class="cta-card">
      <span class="blob cta-blob-a" aria-hidden="true"></span>
      <span class="blob cta-blob-b" aria-hidden="true"></span>
      <div class="cta-inner">
        <div class="cta-photo">
          <Image
            src={ctaPhoto}
            alt={c.imgAlt}
            widths={[240, 480]}
            sizes="120px"
            format="webp"
            quality={72}
          />
        </div>
        <div class="cta-copy">
          <h2 class="cta-title">{c.title}</h2>
          <p>{c.sub}</p>
        </div>
        <p class="cta-price">
          {c.pricePre} <strong>{c.price}</strong> {c.priceUnit}
        </p>
        <a href={withLang(lang, "/enrollment")} class="btn btn-yellow cta-btn">
          <span>{t.hero.ctaEnroll}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: 20px 92px;
  }
  .cta-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    border-radius: var(--radius-lg);
    padding: 40px 48px;
    box-shadow: var(--shadow-blue);
  }
  .cta-blob-a {
    width: 240px;
    height: 240px;
    top: -110px;
    right: 8%;
    background: var(--yellow);
    opacity: 0.35;
  }
  .cta-blob-b {
    width: 180px;
    height: 180px;
    bottom: -100px;
    left: -40px;
    background: #fff;
    opacity: 0.14;
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .cta-photo {
    flex-shrink: 0;
  }
  .cta-photo img {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 18px;
    border: 3px solid rgba(255, 255, 255, 0.35);
    display: block;
  }
  .cta-copy {
    flex: 1 1 300px;
  }
  .cta-title {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    color: #fff;
  }
  .cta-copy p {
    margin-top: 8px;
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-price {
    margin: 0;
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
  }
  .cta-price strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.2rem;
    line-height: 1.05;
    color: var(--yellow-bright);
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .cta-btn svg {
    width: 17px;
    height: 17px;
  }
</style>
