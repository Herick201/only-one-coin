# Supabase — projeto local (supabase start) ou staging.
# NEXT_PUBLIC_* vai para o bundle do cliente: só chaves públicas aqui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role NUNCA no cliente. Só rota de servidor e worker.
# Não usado ainda nesta fatia; entra com o backoffice/OCR.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
