# NEXT_PUBLIC_* vai para o bundle do cliente: só chaves públicas aqui.
#
# No Vercel, cada var abaixo é scoped por ambiente (Production/Preview) na UI
# do projeto — nunca fixa aqui. Local usa os defaults deste arquivo.

# Landing pública (Astro). Opcional; fallback para a raiz do próprio app.
# Production: https://onlyonecoin.edu.pe
# NEXT_PUBLIC_LANDING_URL=https://onlyonecoin.edu.pe

# Server-only (src/server-env.ts) — endereço interno de apps/api, nunca
# exposto ao browser. Usado pelo proxy same-origin de /api/auth/*
# (docs/ARCHITECTURE.md §5.6).
# Production/Preview: URL da máquina do apps/api no Fly.io (pendente —
# entra quando o Dockerfile/fly.toml da API forem fechados).
API_INTERNAL_URL=http://localhost:3333
